// The bytecode container's fuzzer, in FutureBlitz, where the container is checked: containers the
// package saves, of a few scripts of each kind of code, changed at random, a byte flipped, one put
// in or taken out, cut short, two spliced, or bytes of their own, for as long as it's given. Load must
// refuse every one that isn't a container exactly as it was signed, before Luau sees a byte, and
// give back the bytecode of one that is.
//
// `fb run --release fuzz/containers -- <seconds>`: 5 by default; stability.yml's run is 600.

Import std.collections
Import std.core
Import std.math
Import std.os
Import std.time
Import luau

Const Scripts: String[] = [
    "return 1",
    r"local t = {} for i = 1, 10 do t[i] = i * i end return t",
    "local function f(n) if n < 2 then return n end return f(n - 1) + f(n - 2) end return f(10)",
    "local co = coroutine.wrap(function(a) local b = coroutine.yield(a) return a + b end) " +
    "return co(1), co(2)",
    "local s = string.format('%d-%s', 4, 'x') return s:upper() .. #s",
    "local v = vector.create(1, 2, 3) return v * 2, buffer.create(8)",
    r"type Point = { x: number, y: number } local p: Point = { x = 1, y = 2 } return p.x + p.y"
]
Const Key = "the fuzzer's own key, as long as one has to be"

// The first `count` of `bytes`.
Function Prefix(bytes: UInt8[], count: Int): UInt8[]
    Local prefix: UInt8[] = []
    For index = 0 Until count
        prefix.Add(bytes[index])
    End For
    Return prefix
End Function

// `container` changed at random, once to a few times.
Function Changed(container: UInt8[], other: UInt8[], random: Random): UInt8[]
    Local changed = container.Clone()
    For change = 1 To random.Int(1, 4)
        Select random.Int(0, 5)
            Case 0
                If changed.Count > 0
                    Local at = random.Int(0, changed.Count - 1)
                    changed[at] = changed[at] ^ (random.Int(1, 255) As UInt8)
                End If
            Case 1
                changed.Insert(random.Int(0, changed.Count), random.Int(0, 255) As UInt8)
            Case 2
                If changed.Count > 0 Then changed.RemoveAt(random.Int(0, changed.Count - 1))
            Case 3
                If changed.Count > 0 Then changed = Prefix(changed,
                                                           random.Int(0, changed.Count - 1))
            Case 4
                // The start of this one and the end of another.
                Local cut = random.Int(0, Min(changed.Count, other.Count))
                Local spliced = Prefix(changed, cut)
                For index = cut Until other.Count
                    spliced.Add(other[index])
                End For
                changed = spliced
            Default
                changed = []
                For index = 0 Until random.Int(0, 128)
                    changed.Add(random.Int(0, 255) As UInt8)
                End For
        End Select
    End For
    Return changed
End Function

Local arguments = Process.Arguments()
Local seconds = arguments.Count > 0 ? (Int.Parse(arguments[0]) ?? 5) : 5
Local key = Key.Bytes
Local containers: UInt8[][] = []
For index = 0 Until Scripts.Count
    Local code = Try LuauBytecode.Compile(Scripts[index], "@script{index}.luau")
    containers.Add(code.Save(key))
End For
Local random = Random(0x5EED)
Local clock = Stopwatch.StartNew()
Local inputs = 0
While clock.Elapsed.TotalSeconds < seconds
    Local which = random.Int(0, containers.Count - 1)
    Local original = containers[which]
    Local changed = Changed(original, containers[random.Int(0, containers.Count - 1)], random)
    Local loaded = Try? LuauBytecode.Load(changed, key)
    inputs++
    If changed == original
        If loaded == Null Then Panic("a container as it was signed was refused")
    ElseIf loaded != Null
        // Another container, whole, is one the key signed: a splice can give one back.
        Local whole = False
        For container In containers
            If changed == container Then whole = True
        End For
        If !whole Then Panic("a changed container loaded: {changed.Count} bytes")
    End If
End While
Print("{inputs} inputs, no finding")
