//! Luau's bytecode, compiled ahead, as a game's build step does, and the container that makes it
//! the program's own: signed by the build's private key, and checked with its public key before
//! Luau sees a byte.

Import std.crypto
Import std.ffi
Import std.text
Import "./c/fbl_bytecode"
Import "./c/fbl_core"
Import "./errors"
Import "./library"
Import "./shim"
Import "./state"

/// What a container starts with: "FBLUAU", then 0, then its format, 2, signed by Ed25519. Its
/// number goes up when the format does, or the package's Luau flags or build options change.
Const Magic: UInt8[] = [70, 66, 76, 85, 65, 85, 0, 2]
/// The bytes of a container's signature, an Ed25519 one.
Const SignatureSize = 64
/// The bytes of an Ed25519 key, private or public.
Const KeySize = 32
/// What every signature of a container covers before its bytes, then a 0, so a signature the key
/// made for anything else is never a container's.
Const Context = "fb-luau bytecode, format 2"

/// Source compiled into Luau's bytecode ahead, which a State runs without compiling it. Luau runs
/// bytecode as it's given, checking nothing, so bytecode crosses a file system only in [Save]'s
/// container, signed by the build step with an Ed25519 private key that never ships, which [Load]
/// checks in the game with its public key before Luau sees a byte. The public key is no secret:
/// anyone can read it out of the game, and still can't sign; the private key is the whole of it,
/// and stays with the build. A container a mod can replace, in a pak say, is then as safe as
/// one that can't be. A mod is source, always: loading bytecode a mod gave would trust the mod
/// with the process; and for scripts embedded in the executable, compiling their source at start
/// is as good as a container.
///
/// A State's Debug and Coverage options don't apply to bytecode it's given, which has its own.
///
/// # Examples
///
/// ```
/// # Import std.crypto
/// # Import luau
/// // The build step's, kept out of the game: std.crypto's Ed25519.NewPrivateKey() made it once.
/// Local privateKey = Ed25519.NewPrivateKey()
/// Local shipped = (Try LuauBytecode.Compile("return 6 * 7", "@rooms/answer.luau")).Save(privateKey)
///
/// // The game's, which has only the public key.
/// Local publicKey = Ed25519.PublicKeyOf(privateKey)
/// Local loaded = Try LuauBytecode.Load(shipped, publicKey)
/// Expect(Try LuauState().Evaluate<Int>(loaded) == 42)
/// Local another = Ed25519.PublicKeyOf(Ed25519.NewPrivateKey())
/// Expect(ExpectThrows<LuauError>(LuauBytecode.Load(shipped, another)) != Null)
/// ```
Public Class LuauBytecode
    /// The chunk's name, which its errors and tracebacks show, as "@rooms/door.luau".
    Public ReadOnly Field Name: String
    /// How it was compiled.
    Public ReadOnly Field Options: LuauCompileOptions
    /// The bytecode itself.
    Package ReadOnly Field Code: UInt8[]

    Package New(name: String, options: LuauCompileOptions, code: UInt8[])
        Self.Name = name
        Self.Options = options
        Code = code
    End New

    /// Compiles `source` into bytecode, as the chunk `name`, with the default options, as a State
    /// would.
    ///
    /// # Errors
    ///
    /// A LuauError of SYNTAX for source that doesn't compile, which says its line, or of MEMORY.
    @PanicsAtCaller
    Public Static Method Compile(source: String,
                                 name: String = "=chunk"): LuauBytecode Throws LuauError
        Return Try Compile(source, name, LuauCompileOptions())
    End Method

    /// Compiles `source` into bytecode, as the chunk `name`, with `options`, as a State would.
    ///
    /// # Errors
    ///
    /// A LuauError of SYNTAX for source that doesn't compile, which says its line, or of MEMORY.
    ///
    /// # Panics
    ///
    /// When a compile option isn't from 0 to 2, or `name` holds a NUL, which Luau would cut it at.
    @PanicsAtCaller
    Public Static Method Compile(source: String, name: String,
                                 options: LuauCompileOptions): LuauBytecode Throws LuauError
        If name.Bytes.Contains(0) Then Panic("a chunk's name can't hold a NUL")
        Local bytes = source.Bytes
        Local size: Int64 = 0
        Local status: Int32 = FBL_OK
        Local code: UInt8[] = []
        Unsafe
            Local made = fbl_bytecode_compile(PointerOf(ByRef bytes), bytes.Count,
                                              options.Optimization, options.Debug,
                                              options.Coverage, AddressOf(size), AddressOf(status))
            If made != Null
                code = Buffer<UInt8>.View(made, size).ToArray()
                fbl_bytecode_free(made)
            End If
        End Unsafe
        // As Luau says a chunk's syntax error: its name without the "@" or "=" in front.
        Local shown = name.StartsWith("@") || name.StartsWith("=") ? name.Slice(1,
                                                                                name.Length) : name
        If status == FBL_SYNTAX Then Throw LuauError(LuauErrorKind.SYNTAX, shown + LastError())
        If status == FBL_MEMORY Then Throw LuauError(LuauErrorKind.MEMORY, LastError())
        If status != FBL_OK Then Panic(LastError())
        Return LuauBytecode(name, options, code)
    End Method

    /// It in a container signed with `privateKey`, an Ed25519 private key, the build step's, which
    /// never ships: its format, the Luau release that compiled it, its options, its name, and its
    /// bytecode, then the Ed25519 signature of a fixed context and all of that, which [Load] checks
    /// with the public key.
    ///
    /// # Panics
    ///
    /// For a key that isn't 32 bytes, an Ed25519 private key's size.
    @PanicsAtCaller
    Public Method Save(privateKey: UInt8[]): UInt8[]
        If privateKey.Count != KeySize
            Panic("an Ed25519 private key is 32 bytes, not {privateKey.Count}")
        End If
        Local body: UInt8[] = []
        Appended(ByRef body, Magic)
        Local release = LuauVersion().Bytes
        body.Add(release.Count As UInt8)
        Appended(ByRef body, release)
        body.Add(Options.Optimization As UInt8)
        body.Add(Options.Debug As UInt8)
        body.Add(Options.Coverage As UInt8)
        Local name = Name.Bytes
        Counted(ByRef body, name.Count As Int64)
        Appended(ByRef body, name)
        Counted(ByRef body, Code.Count As Int64)
        Appended(ByRef body, Code)
        Appended(ByRef body, Ed25519.Sign(privateKey, Signed(body)))
        Return body
    End Method

    /// The bytecode in a container [Save] signed, checked with `publicKey`, the build's Ed25519
    /// public key, which the game has: its signature first, then that it's a container of this
    /// Luau's.
    ///
    /// # Errors
    ///
    /// A LuauError of OTHER, before Luau sees a byte, for a signature that isn't the key's, as a
    /// byte changed or another key gives, for what isn't a container, and for a container of
    /// another Luau release.
    ///
    /// # Panics
    ///
    /// For a key that isn't 32 bytes, an Ed25519 public key's size.
    @PanicsAtCaller
    Public Static Method Load(bytes: UInt8[], publicKey: UInt8[]): LuauBytecode Throws LuauError
        If publicKey.Count != KeySize
            Panic("an Ed25519 public key is 32 bytes, not {publicKey.Count}")
        End If
        If bytes.Count < Magic.Count + SignatureSize Then Throw NotOne("it's too short")
        Local body = Part(bytes, 0, bytes.Count - SignatureSize)
        Local signature = Part(bytes, bytes.Count - SignatureSize, SignatureSize)
        If !Ed25519.Verify(publicKey, Signed(body), signature)
            Throw LuauError(LuauErrorKind.OTHER,
                            "the bytecode's signature isn't its key's: it was changed, signed " +
                            "with another key, or isn't a container")
        End If
        // Signed by the build, so it's the program's own; what follows checks it's of this Luau.
        Local at = 0
        If !Same(Part(body, 0, Magic.Count), Magic) Then Throw NotOne("its format isn't this one")
        at = Magic.Count
        Local length = Try Taken(body, ByRef at, 1, 0)
        Local release = Try Taken(body, ByRef at, length[0] As Int, 0)
        Local was = String.FromUtf8Lossy(release)
        If was != LuauVersion()
            Throw LuauError(LuauErrorKind.OTHER,
                            "the bytecode was compiled by Luau {was}, not {LuauVersion()}, " +
                            "which this program has")
        End If
        Local levels = Try Taken(body, ByRef at, 3, 0)
        For level In levels
            If level > 2 Then Throw NotOne("a compile option of {level} isn't from 0 to 2")
        End For
        Local options = LuauCompileOptions(levels[0] As Int, levels[1] As Int, levels[2] As Int)
        Local name = String.FromUtf8(Try Taken(body, ByRef at, Try CountAt(body, ByRef at), 0))
        If name == Null || name.Bytes.Contains(0) Then Throw NotOne("its name isn't text")
        Local code = Try Taken(body, ByRef at, Try CountAt(body, ByRef at), 0)
        If at != body.Count || code.Count == 0 Then Throw NotOne("its parts don't fill it")
        Return LuauBytecode(name, options, code)
    End Method
End Class

/// What a container's signature covers: the context and a 0, then its body.
Function Signed(body: UInt8[]): UInt8[]
    Local signed = Context.Bytes
    signed.Add(0)
    Appended(ByRef signed, body)
    Return signed
End Function

/// The error for a container that isn't one, saying why.
Function NotOne(why: String): LuauError
    Return LuauError(LuauErrorKind.OTHER, "the bytes aren't a bytecode container: {why}")
End Function

/// Adds `from`'s bytes to `into`.
Function Appended(ByRef into: UInt8[], from: UInt8[])
    For byte In from
        into.Add(byte)
    End For
End Function

/// Adds `count` to `into` as 4 bytes, little-endian.
Function Counted(ByRef into: UInt8[], count: Int64)
    For shift = 0 Until 4
        into.Add(((count >> (shift * 8)) & 255) As UInt8)
    End For
End Function

/// `count` of `bytes`' bytes from `from`, in a new array.
Function Part(bytes: UInt8[], from: Int, count: Int): UInt8[]
    Local part: UInt8[] = []
    For index = from Until from + count
        part.Add(bytes[index])
    End For
    Return part
End Function

/// Whether two arrays of bytes are the same.
Function Same(a: UInt8[], b: UInt8[]): Bool
    If a.Count != b.Count Then Return False
    For index = 0 Until a.Count
        If a[index] != b[index] Then Return False
    End For
    Return True
End Function

/// `count` bytes of `body` from `at`, after `skip` bytes there, moving `at` past them.
Function Taken(body: UInt8[], ByRef at: Int, count: Int, skip: Int): UInt8[] Throws LuauError
    If count < 0 || at + skip + count > body.Count Then Throw NotOne("it ends too soon")
    at += skip
    Local part = Part(body, at, count)
    at += count
    Return part
End Function

/// The 4-byte count at `at`, little-endian, moving `at` past it.
Function CountAt(body: UInt8[], ByRef at: Int): Int Throws LuauError
    Local bytes = Try Taken(body, ByRef at, 4, 0)
    Local count: Int64 = 0
    For index = 0 Until 4
        count = count | ((bytes[index] As Int64) << (index * 8))
    End For
    If count > 2147483647 Then Throw NotOne("a count is past what it can hold")
    Return count As Int
End Function
