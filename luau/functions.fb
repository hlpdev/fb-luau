//! A Luau function, as a handle the program calls.

Import "./c/fbl_frame"
Import "./c/fbl_ref"
Import "./errors"
Import "./state"
Import "./values"

/// A Luau function the program holds, which keeps it alive in its State until it goes. It holds
/// the State weakly: the State closes when nothing else refers to it, and the handle then panics.
///
/// # Examples
///
/// ```
/// # Import luau
/// Local lua = LuauState()
/// Local count = Try lua.Load("calls = (calls or 0) + 1")
/// Try count.Invoke()
/// Try count.Invoke()
/// Expect(Try lua.Get<Int>("calls") == 2)
/// ```
Public Class LuauFunction Implements LuauType
    /// The State it's in, which the program keeps: it holds it weakly, so a function of the
    /// program's that holds it, which the State holds, isn't a cycle.
    ReadOnly Field owner: Weak<LuauState>

    /// The State it's in, panicking at the caller once it's gone.
    @PanicsAtCaller
    Package Property Owner: LuauState
        Get
            Local held: LuauState? = owner
            If held == Null Then Panic("the Luau State is closed")
            Return held
        End Get
    End Property
    /// The State's reference to it.
    Package ReadOnly Field Ref: Int32

    Package New(owner: LuauState, ref: Int32)
        Self.owner = owner
        Ref = ref
    End New

    Method Destroy()
        Local held: LuauState? = owner
        If held != Null && held.IsOpen Then fbl_ref_free(held.Handle, Ref)
    End Method

    /// Gives it to Luau: the function itself, which has to be of the State it's given to.
    @PanicsAtCaller
    Public Static Method ToLuau(slots: LuauSlots, value: LuauFunction) Throws LuauError
        If !RefEquals(value.Owner, slots.Owner) Then Panic("a LuauFunction of another Luau State")
        Try slots.PushRef(value.Ref)
    End Method

    /// A handle of a function slot's function.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): LuauFunction Throws LuauError
        If slots.TypeAt(index) != FBL_TYPE_FUNCTION Then Throw slots.Wrong("LuauFunction", index)
        Return LuauFunction(slots.Owner, Try slots.RefAt(index))
    End Method

    /// A handle of the function in a frame's slot `index`.
    Package Static Method Kept(owner: LuauState, frame: Int32,
                               index: Int32): LuauFunction Throws LuauError
        Local ref: Int32 = 0
        Local status: Int32
        Unsafe
            status = fbl_ref_new(owner.Live(), frame, index, AddressOf(ref))
        End Unsafe
        Try owner.Check(status)
        Return LuauFunction(owner, ref)
    End Method

    /// A frame with the function in slot 0, which the caller closes with Owner.Closed.
    @PanicsAtCaller
    Package Method Opened(): LuauSlots Throws LuauError
        Local slots = LuauSlots(Owner, Owner.Opened())
        Try
            Try slots.PushRef(Ref)
        Catch error As LuauError
            Owner.Closed(slots.Frame)
            Throw error
        End Try
        Return slots
    End Method
End Class
