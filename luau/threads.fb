//! Luau's threads, its coroutines, on FutureBlitz's schedulers: a thread the program runs as an
//! Async Function would, or resumes by hand, the drivers that resume threads that wait, and the
//! `task` library, whose waits are the scheduler's.

Import std.collections
Import std.core
Import std.text
Import std.time

Import "./c/fbl_core"
Import "./c/fbl_frame"
Import "./c/fbl_ref"
Import "./c/fbl_state"
Import "./c/fbl_table"
Import "./c/fbl_thread"
Import "./errors"
Import "./shim"
Import "./state"
Import "./tables"
Import "./value"
Import "./values"

/// What a [LuauThread] is now, as `coroutine.status` says it, and whether the scheduler has it.
Public Enum LuauThreadStatus
    /// Made, or yielded: a resume goes on with it.
    SUSPENDED
    /// Running: the thread of the code that asks.
    RUNNING
    /// It resumed another thread, or called the program, which is running.
    NORMAL
    /// Its function returned, or it was closed.
    FINISHED
    /// An error ended it.
    FAILED
    /// It waits, on `task.wait` or a function from `SetAsync`, and a driver resumes it when what
    /// it waits for is done: the program can't resume it meanwhile.
    WAITING
End Enum

/// A Luau thread, a coroutine, that the program holds, which keeps it alive in its State until it
/// goes; it holds the State weakly, as every handle does. [Start] runs it on the scheduler, as an
/// Async Function runs, so its `task.wait(2)` waits as an `Await Wait(2.Seconds)` does; `Resume`
/// drives it by hand, as `coroutine.resume` does, until it waits, when the scheduler has it.
///
/// # Examples
///
/// ```
/// # Import luau
/// Local lua = LuauState()
/// Local counter = Try lua.Load("local n = 0 while true do n += 1 coroutine.yield(n) end")
/// Local thread = Try lua.Spawn(counter)
/// While thread.Status == LuauThreadStatus.SUSPENDED
///     Local n = (Try thread.Resume())[0].AsNumber() ?? 0
///     If n == 3 Then Break
/// End While
/// Expect(thread.Status == LuauThreadStatus.SUSPENDED)
/// ```
Public Class LuauThread Implements LuauType
    /// The State it's in, which it holds weakly, as every handle does.
    ReadOnly Field owner: Weak<LuauState>

    /// The State it's in, panicking at the caller once it's gone.
    @PanicsAtCaller
    Package Property Owner: LuauState
        Get
            Local held: LuauState? = owner
            If held == Null Then Panic("the Luau State is closed")
            Return held
        End Get
    End Property
    /// The State's reference to it.
    Package ReadOnly Field Ref: Int32
    /// Its number in its State, its own, the same for each handle of the thread.
    Package ReadOnly Field Id: UInt64

    Package New(owner: LuauState, ref: Int32, id: UInt64)
        Self.owner = owner
        Ref = ref
        Id = id
    End New

    Method Destroy()
        Local held: LuauState? = owner
        If held != Null && held.IsOpen Then fbl_ref_free(held.Handle, Ref)
    End Method

    /// Gives it to Luau: the thread itself, which has to be of the State it's given to.
    @PanicsAtCaller
    Public Static Method ToLuau(slots: LuauSlots, value: LuauThread) Throws LuauError
        If !RefEquals(value.Owner, slots.Owner) Then Panic("a LuauThread of another Luau State")
        Try slots.PushRef(value.Ref)
    End Method

    /// A handle of a thread slot's thread.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): LuauThread Throws LuauError
        If slots.TypeAt(index) != FBL_TYPE_THREAD Then Throw slots.Wrong("LuauThread", index)
        Local id = fbl_thread_id(slots.Owner.Live(), slots.Frame, index)
        If id == 0 Then Throw LuauError(LuauErrorKind.MEMORY, "not enough memory")
        Return LuauThread(slots.Owner, Try slots.RefAt(index), id)
    End Method

    /// What it is now: WAITING while a driver has it.
    ///
    /// # Panics
    ///
    /// When its State has no memory left to look at it with.
    @PanicsAtCaller
    Public Property Status: LuauThreadStatus
        Get
            If Owner.Waits.Contains(Id) Then Return LuauThreadStatus.WAITING
            Return Luaus()
        End Get
    End Property

    /// What Luau says it is, without the scheduler's WAITING.
    @PanicsAtCaller
    Package Method Luaus(): LuauThreadStatus
        Local slots = Try? Opened()
        If slots == Null Then Panic("not enough memory in the Luau State to see a thread's status")
        Defer Owner.Closed(slots.Frame)
        Return fbl_thread_status(Owner.Handle, slots.Frame, 0) As LuauThreadStatus
    End Method

    /// Runs it on the scheduler running the code, as an Async Function runs, as its driver: it
    /// resumes it, and each time it waits, on `task.wait` or a function from `SetAsync`, resumes
    /// it with what it waited for at the scheduler's tick when that's done; a `coroutine.yield` of
    /// its own waits for the next tick. What the threads it starts wait for, a coroutine's or
    /// `task.spawn`'s, it drives too. `s.Run(thread.Start())` runs it on a Scheduler of the
    /// program's own, whose pause and time scale its waits follow. Its Task is done when the
    /// thread ends.
    ///
    /// When the thread ends, what the threads it started still wait for goes to the State's own
    /// driver, `lua.Start()`'s, or, with none running, to ThreadError, as nothing would run it.
    ///
    /// # Errors
    ///
    /// The Task throws a LuauError for what the thread raises or meets as it runs; of CLOSED when
    /// its State closes while it waits, at the scheduler's next tick; and of RUNTIME for a thread
    /// that waits already, or isn't suspended.
    Public Async Method Start() Throws LuauError
        Local driver = Try LuauDriver.Started(Self)
        Try
            While True
                Await NextTick()
                If !(Try driver.Turned()) Then Break
            End While
        Catch error As LuauError
            driver.HandedOver()
            Throw error
        End Try
        driver.HandedOver()
    End Method

    /// Closes it, as `coroutine.close` does: it's finished, and lets go of what it held, so
    /// nothing goes on with it, and a driver doesn't resume it.
    ///
    /// # Errors
    ///
    /// A LuauError of RUNTIME for a thread that's running, or that resumed one that is.
    @PanicsAtCaller
    Public Method Close() Throws LuauError
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try Owner.Check(fbl_thread_close(Owner.Handle, slots.Frame, 0))
        Owner.Waits.Remove(Id)
    End Method

    /// The function it's in, running or yielded in, as fbl_thread_waits_in numbers it, or 0.
    Package Method WaitsIn(): Int64
        Local slots = Try? Opened()
        If slots == Null Then Return 0
        Defer Owner.Closed(slots.Frame)
        Return fbl_thread_waits_in(Owner.Handle, slots.Frame, 0)
    End Method

    /// A frame with it in slot 0, which the caller closes with Owner.Closed.
    @PanicsAtCaller
    Package Method Opened(): LuauSlots Throws LuauError
        Local slots = LuauSlots(Owner, Owner.Opened())
        Try
            Try slots.PushRef(Ref)
        Catch error As LuauError
            Owner.Closed(slots.Frame)
            Throw error
        End Try
        Return slots
    End Method

    /// Resumes it from a frame with it in slot 0, and what it's resumed with after: whether it
    /// finished, and, when `collect`, what it gave.
    @PanicsAtCaller
    Package Method Ran(slots: LuauSlots, raise: Int32,
                       collect: Bool): (Bool, LuauValue[]) Throws LuauError
        Local finished: Int32 = 0
        Local status: Int32
        Unsafe
            status = fbl_thread_resume(Owner.Handle, slots.Frame, 0, raise, AddressOf(finished))
        End Unsafe
        Try Owner.Check(status)
        Local values: LuauValue[] = []
        If collect
            For index = 0 Until slots.Count()
                values.Add(Try LuauValue.FromLuau(slots, index))
            End For
        End If
        Return (finished == 1, values)
    End Method

    /// Resumes it with what it waited for, the values or an error, raised as from `where`, or
    /// with nothing: whether it finished.
    @PanicsAtCaller
    Package Method Resumed(resumed: LuauResumed?, where: String): Bool Throws LuauError
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Local raise: Int32 = 0
        If resumed != Null
            Local failed = resumed.Failed
            If failed != Null
                Try slots.PushError(failed, where)
                raise = 1
            Else
                Try resumed.Push(slots)
            End If
        End If
        Return (Try Ran(slots, raise, False)).0
    End Method

    /// Gives an error that ended it, which nothing waits for, to its State, which gives it to its
    /// ThreadError once no call runs, unless the State is closed.
    Package Method Failed(error: LuauError)
        Local held: LuauState? = owner
        If held == Null || !held.IsOpen || error.Kind == LuauErrorKind.CLOSED Then Return
        held.Failed(error)
    End Method
End Class

/// What a thread is resumed with once what it waits for is done: values, which Push gives Luau,
/// or an error, raised in it where it yielded.
Package Class LuauResumed
    /// Gives the values to Luau.
    Package ReadOnly Field Push: Func(LuauSlots) Throws LuauError
    /// The error, or Null.
    Package ReadOnly Field Failed: Error?

    /// Values, which `push` gives Luau.
    Package New(push: Func(LuauSlots) Throws LuauError)
        Push = push
        Failed = Null
    End New

    /// An error.
    Package New(failed: Error)
        Push = Function(slots: LuauSlots) Throws LuauError
        End Function
        Failed = failed
    End New

    /// No values.
    Package Static Method Nothing(): LuauResumed
        Return LuauResumed(Function(slots: LuauSlots) Throws LuauError
        End Function)
    End Method
End Class

/// What a thread waits for: the scheduler's next tick, a time, or a Task of the program's; and
/// which driver resumes it, and when, in that driver's time.
Package Class LuauWaiting
    /// The thread.
    Package ReadOnly Field Thread: LuauThread
    /// The seconds of the scheduler's time it waits for, or 0 for its next tick.
    Package ReadOnly Field Seconds: Float64
    /// What it's resumed with after the time, or the tick.
    Package ReadOnly Field Given: LuauResumed
    /// The Task it waits for instead, or Null.
    Package ReadOnly Field Task: Task<LuauResumed>?
    /// Where it waited, which a Task's error is raised as from.
    Package ReadOnly Field Origin: String
    /// The driver that resumes it, by its number, and the time of that driver's scheduler when
    /// it's due; or, while Pending, the seconds from the driver's next turn, as a wait made
    /// outside a turn, or handed on, counts from it.
    Package Field Driver: Int = 0
    Package Field Due: Float64 = 0.0
    Package Field Pending: Bool = False

    /// A wait of `seconds`, or for the next tick, after which it's resumed with `given`.
    Package New(thread: LuauThread, seconds: Float64, given: LuauResumed)
        Thread = thread
        Seconds = seconds
        Given = given
        Task = Null
        Origin = ""
    End New

    /// A wait for `task`, called from `where`.
    Package New(thread: LuauThread, task: Task<LuauResumed>, where: String)
        Thread = thread
        Seconds = 0.0
        Given = LuauResumed.Nothing()
        Task = task
        Origin = where
    End New

    /// The function its thread waits in, for a wait of the thread's own, as fbl_thread_waits_in
    /// numbers it, or 0 for one another thread made, by task.spawn, defer, or delay.
    Package Field Within: Int64 = 0

    /// Whether its thread is still in this wait: it's suspended, in the function it waited in,
    /// not resumed by a script meanwhile, nor closed.
    Package Method IsHeld(): Bool
        If Within == 0 Then Return True
        If Thread.Luaus() != LuauThreadStatus.SUSPENDED Then Return False
        Return Thread.WaitsIn() == Within
    End Method

    /// Whether it's due in its driver's turn: its Task done, its time come, or a tick's.
    Package Method IsDue(now: Float64): Bool
        Local task = Task
        If task != Null Then Return task.IsDone()
        Return Seconds <= 0.0 || Due <= now
    End Method
End Class

/// What resumes a State's threads that wait, on the scheduler its coroutine is on: the State's own,
/// `lua.Start()`, for what no thread's Start runs, or a thread's Start, for its thread and what
/// the threads it starts wait for. No wait is a timer: at each of its scheduler's ticks, it reads
/// the scheduler's time and resumes what's due, so a wait is never early, and at most a tick
/// late; the State's time budget decides only whether another thread is resumed in a tick, and
/// each resume has the budget of its own.
Package Class LuauDriver
    /// Its number in its State.
    Package ReadOnly Field Number: Int
    /// Its State, held weakly, as a handle holds it.
    ReadOnly Field owner: Weak<LuauState>
    /// The thread whose Start it is, or Null for the State's own.
    Package ReadOnly Field Own: LuauThread?
    /// Its scheduler's time at its last turn, in seconds.
    Package Field Now: Float64 = 0.0
    /// Whether it's in its turn, when the scheduler running the code is its own.
    Package Field InTurn: Bool = False
    /// How long its turn has run, in real time, while it's in one.
    Field turnClock: Stopwatch? = Null

    /// The real seconds its turn has taken so far, or 0 outside one.
    Package Method TurnTime(): Float64
        Local clock = turnClock
        If clock == Null Then Return 0.0
        Return clock.Elapsed.TotalSeconds
    End Method

    Package New(owner: LuauState, number: Int, own: LuauThread?)
        Self.owner = owner
        Number = number
        Own = own
    End New

    /// A destroyed driver, as when its Scheduler goes with it waiting, gives its waits to the
    /// State's own driver, or, with none, lets them go, the threads suspended.
    Method Destroy()
        Local held: LuauState? = owner
        If held == Null || !held.IsOpen Then Return
        held.Dropped(Number)
        If held.StateDriver == Number Then held.StateDriver = 0
        Local heir = held.DriverOf(held.StateDriver)
        Local mine: UInt64[] = []
        For entry In held.Waits
            If entry.1.Driver == Number Then mine.Add(entry.0)
        End For
        For id In mine
            Local waiting = held.Waits.Get(id)
            If waiting == Null Then Continue
            If heir == Null
                held.Waits.Remove(id)
                held.Failed(LuauError(LuauErrorKind.YIELD,
                                      "a thread waited with nothing to resume it once the " +
                                      "scheduler its driver ran on went; lua.Start() runs the " +
                                      "State's waits"))
            Else
                HandTo(waiting, heir)
            End If
        End For
    End Method

    /// Gives `waiting` to `heir`, due as much later from heir's next turn as it had left.
    Method HandTo(waiting: LuauWaiting, heir: LuauDriver)
        If !waiting.Pending
            waiting.Due = Max(waiting.Due - Now, 0.0)
            waiting.Pending = True
        End If
        waiting.Driver = heir.Number
    End Method

    /// As a thread's Start ends: what it still drives goes to the State's own driver, or, with
    /// none running, ends as an error to ThreadError, since nothing would ever resume it.
    Package Method HandedOver()
        Local held: LuauState? = owner
        If held == Null || !held.IsOpen Then Return
        Local heir = held.DriverOf(held.StateDriver)
        Local mine: UInt64[] = []
        For entry In held.Waits
            If entry.1.Driver == Number Then mine.Add(entry.0)
        End For
        For id In mine
            Local waiting = held.Waits.Get(id)
            If waiting == Null Then Continue
            If heir != Null
                HandTo(waiting, heir)
            Else
                held.Waits.Remove(id)
                held.Failed(LuauError(LuauErrorKind.YIELD,
                                      "a thread waited with nothing to resume it once the Start " +
                                      "that ran it ended; lua.Start() runs the State's waits"))
            End If
        End For
        held.Report()
    End Method

    /// The State's own driver, for `lua.Start()`.
    ///
    /// # Panics
    ///
    /// When the State has one running already.
    @PanicsAtCaller
    Package Static Method OfState(state: LuauState): LuauDriver
        If state.DriverOf(state.StateDriver) != Null Then Panic("the Luau State's driver runs already")
        Local driver = state.NewDriver(Null)
        state.StateDriver = driver.Number
        Return driver
    End Method

    /// A thread's driver, for its Start, which has resumed it a first time.
    ///
    /// # Errors
    ///
    /// A LuauError of RUNTIME for a thread that waits already, of CLOSED for a closed State, and
    /// what the thread meets as it runs.
    Package Static Method Started(thread: LuauThread): LuauDriver Throws LuauError
        Local held = thread.Owner
        If !held.IsOpen Then Throw LuauError(LuauErrorKind.CLOSED, "the Luau State is closed")
        If held.Waits.Contains(thread.Id)
            Throw LuauError(LuauErrorKind.RUNTIME, "the Luau thread waits on the scheduler already")
        End If
        Local driver = held.NewDriver(thread)
        Try driver.Stepped(thread, Null, "")
        Return driver
    End Method

    /// Its turn at a tick of its scheduler's: reads the scheduler's time, and resumes what's due
    /// while the tick's budget lasts, the rest going first next tick; then whether it goes on:
    /// False once its own thread has ended. A tick inside a call of the program's into the State,
    /// as when the program waits on a Task in a function a script called, is no turn.
    ///
    /// # Errors
    ///
    /// For a thread's Start, what its thread met; for every driver, a LuauError of CLOSED once
    /// its State is, as ThreadError can close it.
    Package Method Turned(): Bool Throws LuauError
        Local held: LuauState? = owner
        If held == Null || !held.IsOpen
            Throw LuauError(LuauErrorKind.CLOSED, "the Luau State closed while its threads waited")
        End If
        If fbl_state_turn(held.Handle, 3) == 1 Then Return True
        Now = Scheduler.Current.Time().TotalSeconds
        Local clock = Stopwatch.StartNew()
        turnClock = clock
        Local due: LuauWaiting[] = []
        For entry In held.Waits
            Local waiting = entry.1
            If waiting.Driver != Number Then Continue
            If waiting.Pending
                waiting.Due = Now + waiting.Due
                waiting.Pending = False
            End If
            If waiting.IsDue(Now) Then due.Add(waiting)
        End For
        Local failed: LuauError? = Null
        If due.Count > 0
            Local budget = held.TickBudget
            held.Turning = True
            InTurn = True
            For waiting In due
                If !held.IsOpen Then Break
                // The tick's budget decides only whether another thread starts; each resume has
                // the State's budget of its own, so only what spins is ended.
                If budget > 0.Seconds && clock.Elapsed >= budget Then Break
                // The entry it collected, which another resumed in this turn may have replaced
                // with a wait of its own since.
                Local now = held.Waits.Get(waiting.Thread.Id)
                If now == Null || !RefEquals(now, waiting) Then Continue
                held.Waits.Remove(waiting.Thread.Id)
                // A wait a script went around, resuming or closing the thread itself, is dropped.
                If !waiting.IsHeld() Then Continue
                Local resumed = waiting.Given
                Local task = waiting.Task
                If task != Null Then resumed = task.Wait()
                Try
                    Try Stepped(waiting.Thread, resumed, waiting.Origin)
                Catch error As LuauError
                    If IsOwn(waiting.Thread) Then failed = error Else waiting.Thread.Failed(error)
                End Try
            End For
            InTurn = False
            held.Turning = False
        End If
        turnClock = Null
        If held.IsOpen Then held.Report()
        If failed != Null Then Throw failed
        If !held.IsOpen
            Throw LuauError(LuauErrorKind.CLOSED, "the Luau State closed while its threads waited")
        End If
        Local own = Own
        If own == Null Then Return True
        Return held.Waits.Contains(own.Id) || own.Luaus() == LuauThreadStatus.SUSPENDED
    End Method

    /// Whether `thread` is the one whose Start this is.
    Method IsOwn(thread: LuauThread): Bool
        Local own = Own
        Return own != Null && own.Id == thread.Id
    End Method

    /// Resumes `thread`, unless it's done, or closed meanwhile, with this the driver of what it
    /// waits for; a `coroutine.yield` of its own waits for the next tick.
    Package Method Stepped(thread: LuauThread, resumed: LuauResumed?,
                           where: String) Throws LuauError
        Local held = thread.Owner
        If !held.IsOpen || thread.Luaus() != LuauThreadStatus.SUSPENDED Then Return
        Local before = held.CurrentDriver
        held.CurrentDriver = Number
        Try
            If Try thread.Resumed(resumed, where)
                held.CurrentDriver = before
                Return
            End If
        Catch error As LuauError
            held.CurrentDriver = before
            Throw error
        End Try
        held.CurrentDriver = before
        If !held.IsOpen Then Return
        If !held.Waits.Contains(thread.Id) && thread.Luaus() == LuauThreadStatus.SUSPENDED
            Local tick = LuauWaiting(thread, 0.0, LuauResumed.Nothing())
            tick.Driver = Number
            held.Waits[thread.Id] = tick
        End If
    End Method
End Class

/// The State's driver: resumes what its threads wait for that no thread's Start runs, at each of
/// its scheduler's ticks, until the State closes, so a Scheduler it runs on isn't idle meanwhile.
Package Async Function Drove(driver: LuauDriver) Throws LuauError
    While True
        Await NextTick()
        If !(Try driver.Turned()) Then Return
    End While
End Function

/// What a thread waiting on a Task of the program's is resumed with: its result.
Package Async Function Settled<R: LuauType>(task: Task<R>): LuauResumed
    Return Given(Await task)
End Function

/// What a thread waiting on a Task of the program's is resumed with: its result, or its error.
Package Async Function Settled<R, E>(task: Task<R> Throws E): LuauResumed
    Where R: LuauType
    Where E: Error
    Try
        Return Given(Try Await task)
    Catch error
        Return LuauResumed(error)
    End Try
End Function

/// What a thread waiting on a Task of the program's is resumed with: nothing.
Package Async Function Settled(task: Task): LuauResumed
    Await task
    Return LuauResumed.Nothing()
End Function

/// What a thread waiting on a Task of the program's is resumed with: nothing, or its error.
Package Async Function Settled<E: Error>(task: Task Throws E): LuauResumed
    Try
        Try Await task
        Return LuauResumed.Nothing()
    Catch error
        Return LuauResumed(error)
    End Try
End Function

/// Resuming with `value`.
Function Given<R: LuauType>(value: R): LuauResumed
    Return LuauResumed(Function(slots: LuauSlots) Throws LuauError
        Try R.ToLuau(slots, value)
    End Function)
End Function

/// Resuming with the frame's values from slot `from`, which stay in the State, as one table it
/// keeps by reference, and are pushed from it at the resume: nothing of them is copied to the
/// program, so a script's strings stay Luau's, once, counted to its memory limit.
Function GivenFrom(slots: LuauSlots, from: Int32): LuauResumed Throws LuauError
    Local count = slots.Count() - from
    If count <= 0
        Return LuauResumed(Function(into: LuauSlots) Throws LuauError
        End Function)
    End If
    Local handle = slots.Owner.Live()
    Try slots.Owner.Check(fbl_table_new(handle, slots.Frame, count, 0))
    Local table = slots.Count() - 1
    For index = 0 Until count
        Try slots.PushNumber((index + 1) As Float64)
        Try slots.Owner.Check(fbl_table_raw_set(handle, slots.Frame, table, table + 1,
                                                from + index))
        slots.Truncate(table + 1)
    End For
    Local kept = Try LuauTable.FromLuau(slots, table)
    slots.Truncate(table)
    Return LuauResumed(Function(into: LuauSlots) Throws LuauError
        Local at = into.Count()
        Try LuauTable.ToLuau(into, kept)
        For index = 1 To count
            Try into.Owner.Check(fbl_table_raw_get_index(into.Owner.Live(), into.Frame, at,
                                                         index))
        End For
        into.Remove(at)
    End Function)
End Function

/// The thread in slot `index`, or a new one for the function there, for the task function `name`;
/// one given has to be suspended, not running, done, or waiting already.
Function ThreadAt(slots: LuauSlots, index: Int32, name: String): LuauThread Throws LuauError
    Local type = slots.TypeAt(index)
    If type == FBL_TYPE_THREAD
        Local given = Try LuauThread.FromLuau(slots, index)
        Local status = given.Status
        If status != LuauThreadStatus.SUSPENDED
            Throw LuauError(LuauErrorKind.RUNTIME,
                            "'{name}' takes a suspended thread, not one that's " +
                            "{status.ToString().ToLower()}")
        End If
        Return given
    End If
    If type != FBL_TYPE_FUNCTION
        Throw LuauError(LuauErrorKind.CONVERSION,
                        "invalid argument #{index + 1} to '{name}' (expected function or thread, " +
                        "got {LuauTypeName(type)})")
    End If
    Try slots.Owner.Check(fbl_thread_new(slots.Owner.Live(), slots.Frame, index))
    Local made = Try LuauThread.FromLuau(slots, slots.Count() - 1)
    slots.Remove(slots.Count() - 1)
    Return made
End Function

/// The seconds a script asks a task function to wait, from slot `index`, nil as none, kept to what
/// a Duration holds, and NaN as none.
Function SecondsAt(slots: LuauSlots, index: Int32, name: String): Float64 Throws LuauError
    If slots.Count() <= index || slots.TypeAt(index) == FBL_TYPE_NIL Then Return 0.0
    Local seconds = Try slots.Argument<Float64>(index, name)
    If seconds != seconds || seconds < 0.0 Then Return 0.0
    Return seconds > 9.0e9 ? 9.0e9 : seconds
End Function

/// `task.wait(seconds)`: yields the thread, which goes on once the scheduler's time has moved on
/// that much, or at its next tick, with the seconds it waited for.
Function TaskWait(slots: LuauSlots): Int32
    Try
        Try slots.Yieldable("wait")
        Local seconds = Try SecondsAt(slots, 0, "wait")
        Local thread = Try slots.Running()
        Local waiting = LuauWaiting(thread, seconds, Given(seconds))
        waiting.Within = thread.WaitsIn()
        Try slots.Owner.Waited(waiting)
        slots.Truncate(0)
        Return FBL_YIELD
    Catch error
        Return slots.Raise(error)
    End Try
End Function

/// `task.spawn(f, ...)`: runs a thread of `f`, or the suspended thread given, with the rest as its
/// arguments, now, until it waits or ends, and gives it; an error that ends it goes to ThreadError
/// once no call runs.
Function TaskSpawn(slots: LuauSlots): Int32
    Try
        Local thread = Try ThreadAt(slots, 0, "spawn")
        Local given = Try GivenFrom(slots, 1)
        Try
            Try thread.Resumed(given, "")
        Catch failed As LuauError
            thread.Failed(failed)
        End Try
        Return Try slots.Result(thread)
    Catch error
        Return slots.Raise(error)
    End Try
End Function

/// `task.defer(f, ...)`: runs a thread of `f`, or the suspended thread given, with the rest as its
/// arguments, at the scheduler's next tick, and gives it.
Function TaskDefer(slots: LuauSlots): Int32
    Try
        Local thread = Try ThreadAt(slots, 0, "defer")
        Try slots.Owner.Waited(LuauWaiting(thread, 0.0, Try GivenFrom(slots, 1)))
        Return Try slots.Result(thread)
    Catch error
        Return slots.Raise(error)
    End Try
End Function

/// `task.delay(seconds, f, ...)`: runs a thread of `f`, or the suspended thread given, with the
/// rest as its arguments, once the scheduler's time has moved on `seconds`, and gives it.
Function TaskDelay(slots: LuauSlots): Int32
    Try
        Local seconds = Try SecondsAt(slots, 0, "delay")
        Local thread = Try ThreadAt(slots, 1, "delay")
        Try slots.Owner.Waited(LuauWaiting(thread, seconds, Try GivenFrom(slots, 2)))
        Return Try slots.Result(thread)
    Catch error
        Return slots.Raise(error)
    End Try
End Function

/// `task.cancel(thread)`: closes the thread, so it doesn't go on, nor wait.
Function TaskCancel(slots: LuauSlots): Int32
    Try
        Local thread = Try slots.Argument<LuauThread>(0, "cancel")
        Try thread.Close()
        Return slots.NoResult()
    Catch error
        Return slots.Raise(error)
    End Try
End Function

/// Sets the global `task` to the task library: wait, spawn, defer, delay, and cancel, as Roblox
/// has them, on the scheduler running the State's driver.
Package Function TaskLibrary(lua: LuauState) Throws LuauError
    Local library = Try lua.NewTable()
    Try library.Set("wait",
                    Try lua.NewFunction("wait", Function(slots: LuauSlots) => TaskWait(slots)))
    Try library.Set("spawn",
                    Try lua.NewFunction("spawn", Function(slots: LuauSlots) => TaskSpawn(slots)))
    Try library.Set("defer",
                    Try lua.NewFunction("defer", Function(slots: LuauSlots) => TaskDefer(slots)))
    Try library.Set("delay",
                    Try lua.NewFunction("delay", Function(slots: LuauSlots) => TaskDelay(slots)))
    Try library.Set("cancel",
                    Try lua.NewFunction("cancel", Function(slots: LuauSlots) => TaskCancel(slots)))
    Try library.Freeze()
    Try lua.Set("task", library)
End Function
