//! The package's library, luau_native: the versions it was built at, what it says went wrong, and
//! the States it has open.

Import "./c/fbl_core"
Import "./c/fbl_state"

/// The version of the luau package's library the program runs with, like "0.1.0", which is the
/// package's.
///
/// # Examples
///
/// ```
/// Print("luau {LuauLibraryVersion()}, Luau {LuauVersion()}")
/// ```
Public Function LuauLibraryVersion(): String
    Unsafe
        Return fbl_core_version().ToString()
    End Unsafe
End Function

/// The release of Luau the package's library has in it, like "0.746", which says what scripts it
/// runs.
Public Function LuauVersion(): String
    Unsafe
        Return fbl_core_luau_version().ToString()
    End Unsafe
End Function

/// What the last call to the package's library that failed on this thread said went wrong.
Package Function LastError(): String
    Unsafe
        Return fbl_core_error().ToString()
    End Unsafe
End Function

/// How many States the process has open, on every thread, and the bytes they hold: what a
/// program's tests and soaks watch come back to what it was.
///
/// # Examples
///
/// ```
/// # Import luau
/// Local before = LuauStatesOpen()
/// Local lua = LuauState()
/// Expect(LuauStatesOpen().0 == before.0 + 1)
/// lua.Close()
/// Expect(LuauStatesOpen() == before)
/// ```
Public Function LuauStatesOpen(): (Int64, Int64) => (fbl_state_count(), fbl_state_memory_all())

/// Whether Luau's code generator is supported where the program runs, its processor and system:
/// where it isn't, a State's code runs in Luau's interpreter, whatever its NativeCode says.
///
/// # Examples
///
/// ```
/// # Import luau
/// Print(LuauNativeCodeSupported() ? "native code" : "the interpreter")
/// ```
Public Function LuauNativeCodeSupported(): Bool => fbl_state_native_supported() == 1
