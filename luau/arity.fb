    @PanicsAtCaller
    Public Method Wrap<A1, R>(f: Func(A1): R Throws Error,
                              name: String = "function"): LuauFunction Throws LuauError
        Where A1: LuauType
        Where R: LuauType
        Return Try NewFunction(name, Function(slots: LuauSlots): Int32
            Try
                Local a1 = Try slots.Argument<A1>(0, name)
                Return Try slots.Result(Try f(a1))
            Catch error
                Return slots.Raise(error)
            End Try
        End Function)
    End Method

