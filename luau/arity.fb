        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 0))
    End Method

    /// Calls it with 8 arguments, and gives its first 2 results, each as its type.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, or of CONVERSION when a result isn't
    /// of its type.
    @PanicsAtCaller
    Public Method Call2<R1, R2, A1, A2, A3, A4, A5, A6, A7, A8>(a1: A1, a2: A2, a3: A3, a4: A4,
                                                                a5: A5, a6: A6, a7: A7,
                                                                a8: A8): (R1, R2) Throws LuauError
        Where R1: LuauType
        Where R2: LuauType
        Where A1: LuauType
        Where A2: LuauType
        Where A3: LuauType
        Where A4: LuauType
        Where A5: LuauType
        Where A6: LuauType
        Where A7: LuauType
        Where A8: LuauType
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try A1.ToLuau(slots, a1)
        Try A2.ToLuau(slots, a2)
        Try A3.ToLuau(slots, a3)
        Try A4.ToLuau(slots, a4)
        Try A5.ToLuau(slots, a5)
        Try A6.ToLuau(slots, a6)
        Try A7.ToLuau(slots, a7)
        Try A8.ToLuau(slots, a8)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 2))
        Return (Try R1.FromLuau(slots, 0), Try R2.FromLuau(slots, 1))
    End Method

    /// Calls it with 8 arguments, and gives its first 3 results, each as its type.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, or of CONVERSION when a result isn't
    /// of its type.
    @PanicsAtCaller
    Public Method Call3<R1, R2, R3, A1, A2, A3, A4, A5, A6, A7, A8>(a1: A1, a2: A2, a3: A3, a4: A4,
                                                                    a5: A5, a6: A6, a7: A7,
                                                                    a8: A8): (R1, R2,
                                                                              R3) Throws LuauError
        Where R1: LuauType
        Where R2: LuauType
        Where R3: LuauType
        Where A1: LuauType
        Where A2: LuauType
        Where A3: LuauType
        Where A4: LuauType
        Where A5: LuauType
        Where A6: LuauType
        Where A7: LuauType
        Where A8: LuauType
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try A1.ToLuau(slots, a1)
        Try A2.ToLuau(slots, a2)
        Try A3.ToLuau(slots, a3)
        Try A4.ToLuau(slots, a4)
        Try A5.ToLuau(slots, a5)
        Try A6.ToLuau(slots, a6)
        Try A7.ToLuau(slots, a7)
        Try A8.ToLuau(slots, a8)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 3))
        Return (Try R1.FromLuau(slots, 0), Try R2.FromLuau(slots, 1), Try R3.FromLuau(slots, 2))
    End Method

    /// Calls it with 8 arguments, and gives every result it gives, of any types.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs.
    @PanicsAtCaller
    Public Method CallAll<A1, A2, A3, A4, A5, A6, A7, A8>(a1: A1, a2: A2, a3: A3, a4: A4, a5: A5,
                                                          a6: A6, a7: A7,
                                                          a8: A8): LuauValue[] Throws LuauError
        Where A1: LuauType
        Where A2: LuauType
        Where A3: LuauType
        Where A4: LuauType
        Where A5: LuauType
        Where A6: LuauType
        Where A7: LuauType
        Where A8: LuauType
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try A1.ToLuau(slots, a1)
        Try A2.ToLuau(slots, a2)
        Try A3.ToLuau(slots, a3)
        Try A4.ToLuau(slots, a4)
        Try A5.ToLuau(slots, a5)
        Try A6.ToLuau(slots, a6)
        Try A7.ToLuau(slots, a7)
        Try A8.ToLuau(slots, a8)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, -1))
        Local results: LuauValue[] = []
        For index = 0 Until slots.Count()
            results.Add(Try LuauValue.FromLuau(slots, index))
        End For
        Return results
    End Method

    /// It as a FutureBlitz function of 8 arguments that gives a result, which calls it
    /// as Call does, and keeps it alive while it's held.
    @PanicsAtCaller
    Public Method ToFunc<A1, A2, A3, A4, A5, A6, A7, A8, R>(): (Func(A1, A2, A3, A4, A5, A6, A7,
                                                                     A8): R Throws LuauError)
        Where A1: LuauType
        Where A2: LuauType
        Where A3: LuauType
        Where A4: LuauType
        Where A5: LuauType
        Where A6: LuauType
        Where A7: LuauType
        Where A8: LuauType
        Where R: LuauType
        Return Function(a1: A1, a2: A2, a3: A3, a4: A4, a5: A5, a6: A6, a7: A7,
                        a8: A8): R Throws LuauError
            Return Try Call<R, A1, A2, A3, A4, A5, A6, A7, A8>(a1, a2, a3, a4, a5, a6, a7, a8)
        End Function
    End Method

    /// It as a FutureBlitz function of 8 arguments that gives nothing, which calls it
    /// as Invoke does, and keeps it alive while it's held.
    @PanicsAtCaller
    Public Method ToAction<A1, A2, A3, A4, A5, A6, A7, A8>(): (Func(A1, A2, A3, A4, A5, A6, A7,
                                                                    A8) Throws LuauError)
        Where A1: LuauType
        Where A2: LuauType
        Where A3: LuauType
        Where A4: LuauType
        Where A5: LuauType
        Where A6: LuauType
        Where A7: LuauType
        Where A8: LuauType
        Return Function(a1: A1, a2: A2, a3: A3, a4: A4, a5: A5, a6: A6, a7: A7,
                        a8: A8) Throws LuauError
            Try Invoke(a1, a2, a3, a4, a5, a6, a7, a8)
        End Function
    End Method
End Extend
