        Try A2.ToLuau(slots, a2)
        Try A3.ToLuau(slots, a3)
        Try A4.ToLuau(slots, a4)
        Try A5.ToLuau(slots, a5)
        Try A6.ToLuau(slots, a6)
        Try A7.ToLuau(slots, a7)
        Try A8.ToLuau(slots, a8)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, -1))
        Local results: LuauValue[] = []
        For index = 0 Until slots.Count()
            results.Add(Try LuauValue.FromLuau(slots, index))
        End For
        Return results
    End Method

    /// It as a FutureBlitz function of 8 arguments that gives a result, which calls it
    /// as Call does, and keeps it alive while it's held.
    @PanicsAtCaller
    Public Method ToFunc<A1, A2, A3, A4, A5, A6, A7, A8, R>(): (Func(A1, A2, A3, A4, A5, A6, A7,
                                                                     A8): R Throws LuauError)
        Where A1: LuauType
        Where A2: LuauType
        Where A3: LuauType
        Where A4: LuauType
        Where A5: LuauType
        Where A6: LuauType
        Where A7: LuauType
        Where A8: LuauType
        Where R: LuauType
        Return Function(a1: A1, a2: A2, a3: A3, a4: A4, a5: A5, a6: A6, a7: A7,
                        a8: A8): R Throws LuauError
            Return Try Call<R, A1, A2, A3, A4, A5, A6, A7, A8>(a1, a2, a3, a4, a5, a6, a7, a8)
        End Function
    End Method

    /// It as a FutureBlitz function of 8 arguments that gives nothing, which calls it
    /// as Invoke does, and keeps it alive while it's held.
    @PanicsAtCaller
    Public Method ToAction<A1, A2, A3, A4, A5, A6, A7, A8>(): (Func(A1, A2, A3, A4, A5, A6, A7,
                                                                    A8) Throws LuauError)
        Where A1: LuauType
        Where A2: LuauType
        Where A3: LuauType
        Where A4: LuauType
        Where A5: LuauType
        Where A6: LuauType
        Where A7: LuauType
        Where A8: LuauType
        Return Function(a1: A1, a2: A2, a3: A3, a4: A4, a5: A5, a6: A6, a7: A7,
                        a8: A8) Throws LuauError
            Try Invoke(a1, a2, a3, a4, a5, a6, a7, a8)
        End Function
    End Method
End Extend

/// A Luau thread's resumes by hand.
Extend LuauThread
    /// Resumes it with no arguments, as `coroutine.resume` does: the first time, they're its
    /// function's arguments, and after, what the `coroutine.yield` it waits at gives. It runs
    /// until it yields or returns, and what it yields or returns comes back, of any types.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, which ends it, or of
    /// RUNTIME for a thread that isn't suspended.
    ///
    /// # Panics
    ///
    /// For a thread that runs on the
    /// scheduler, from Start or the task library.
    @PanicsAtCaller
    Public Method Resume(): LuauValue[] Throws LuauError
        If Owner.Driven.Contains(Id) Then Panic("the Luau thread runs on the scheduler")
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Return (Try Ran(slots, 0, True)).1
    End Method

    /// Resumes it with one argument, as `coroutine.resume` does: the first time, they're its
    /// function's arguments, and after, what the `coroutine.yield` it waits at gives. It runs
    /// until it yields or returns, and what it yields or returns comes back, of any types.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, which ends it, or of
    /// RUNTIME for a thread that isn't suspended.
    ///
    /// # Panics
    ///
    /// For a thread that runs on the
    /// scheduler, from Start or the task library.
    @PanicsAtCaller
    Public Method Resume<A1: LuauType>(a1: A1): LuauValue[] Throws LuauError
        If Owner.Driven.Contains(Id) Then Panic("the Luau thread runs on the scheduler")
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try A1.ToLuau(slots, a1)
        Return (Try Ran(slots, 0, True)).1
    End Method

