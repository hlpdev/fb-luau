                    Return slots.NoResult()
                Catch error
                    Return slots.Raise(error)
                End Try
            End Function
        End For
        For Method m: M In T
            Where m Has LuauAction
            Where M: Func(A1, A2, A3, A4, A5, A6, A7) Throws E
            Where A1: LuauType
            Where A2: LuauType
            Where A3: LuauType
            Where A4: LuauType
            Where A5: LuauType
            Where A6: LuauType
            Where A7: LuauType
            Where E: Error
            Local name = MemberName(m.Attribute(LuauAction)?.Name, m.Name)
            type.Methods[name] = Function(slots: LuauSlots): Int32
                Try
                    Local object = Try slots.Argument<T>(0, name)
                    Local a1 = Try slots.Argument<A1>(1, name)
                    Local a2 = Try slots.Argument<A2>(2, name)
                    Local a3 = Try slots.Argument<A3>(3, name)
                    Local a4 = Try slots.Argument<A4>(4, name)
                    Local a5 = Try slots.Argument<A5>(5, name)
                    Local a6 = Try slots.Argument<A6>(6, name)
                    Local a7 = Try slots.Argument<A7>(7, name)
                    Try m.Call(object, a1, a2, a3, a4, a5, a6, a7)
                    Return slots.NoResult()
                Catch error
                    Return slots.Raise(error)
                End Try
            End Function
        End For
        For Method m: M In T
            Where m Has LuauGet
            Where M: Func(): R
            Where R: LuauType
            Local name = MemberName(m.Attribute(LuauGet)?.Name, m.Name)
            type.Getters[name] = Function(slots: LuauSlots): Int32
                Try
                    Local object = Try slots.Argument<T>(0, name)
                    Return Try slots.Result(m.Call(object))
                Catch error
                    Return slots.Raise(error)
                End Try
            End Function
        End For
        For Method m: M In T
            Where m Has LuauSet
            Where M: Func(V)
            Where V: LuauType
            Local name = MemberName(m.Attribute(LuauSet)?.Name, m.Name)
            type.Setters[name] = Function(slots: LuauSlots): Int32
                Try
                    Local object = Try slots.Argument<T>(0, name)
                    Local value = Try slots.Argument<V>(1, name)
                    m.Call(object, value)
                    Return slots.NoResult()
                Catch error
                    Return slots.Raise(error)
                End Try
            End Function
        End For
        For Method m: M In T
            Where m Has LuauGet
            Where M: Func(): R Throws E
            Where R: LuauType
            Where E: Error
            Local name = MemberName(m.Attribute(LuauGet)?.Name, m.Name)
            type.Getters[name] = Function(slots: LuauSlots): Int32
                Try
                    Local object = Try slots.Argument<T>(0, name)
                    Return Try slots.Result(Try m.Call(object))
                Catch error
                    Return slots.Raise(error)
                End Try
            End Function
        End For
        For Method m: M In T
            Where m Has LuauSet
            Where M: Func(V) Throws E
            Where V: LuauType
            Where E: Error
            Local name = MemberName(m.Attribute(LuauSet)?.Name, m.Name)
            type.Setters[name] = Function(slots: LuauSlots): Int32
                Try
                    Local object = Try slots.Argument<T>(0, name)
                    Local value = Try slots.Argument<V>(1, name)
                    Try m.Call(object, value)
                    Return slots.NoResult()
                Catch error
                    Return slots.Raise(error)
                End Try
            End Function
        End For
        For Method m: M In T
            Where M: Func(): String
            If m.Name != "ToString" Then Continue
            Local show = Function(slots: LuauSlots): Int32
                Try
                    Local object = Try slots.Argument<T>(0, "__tostring")
                    Return Try slots.Result(m.Call(object))
                Catch error
                    Return slots.Raise(error)
                End Try
            End Function
            type.Pending.Add((LuauOperator.TOSTRING, Try NewFunction("__tostring", show)))
        End For
        Try Finished(type)
        Return type
    End Method
End Extend

/// A Luau function's calls from the program.
Extend LuauFunction
    /// Calls it with no arguments, and gives its first result as an R, or nil's when it gives
    /// none.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, or of CONVERSION when a result isn't
    /// of its type.
    @PanicsAtCaller
    Public Method Call<R: LuauType>(): R Throws LuauError
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 1))
        Return Try R.FromLuau(slots, 0)
    End Method

    /// Calls it with no arguments, and lets its results go.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs.
    @PanicsAtCaller
    Public Method Invoke() Throws LuauError
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 0))
    End Method

    /// Calls it with no arguments, and gives its first 2 results, each as its type.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, or of CONVERSION when a result isn't
    /// of its type.
    @PanicsAtCaller
    Public Method Call2<R1, R2>(): (R1, R2) Throws LuauError
        Where R1: LuauType
        Where R2: LuauType
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 2))
        Return (Try R1.FromLuau(slots, 0), Try R2.FromLuau(slots, 1))
    End Method

    /// Calls it with no arguments, and gives its first 3 results, each as its type.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, or of CONVERSION when a result isn't
    /// of its type.
    @PanicsAtCaller
    Public Method Call3<R1, R2, R3>(): (R1, R2, R3) Throws LuauError
        Where R1: LuauType
        Where R2: LuauType
        Where R3: LuauType
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 3))
        Return (Try R1.FromLuau(slots, 0), Try R2.FromLuau(slots, 1), Try R3.FromLuau(slots, 2))
    End Method

    /// Calls it with no arguments, and gives every result it gives, of any types.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs.
    @PanicsAtCaller
    Public Method CallAll(): LuauValue[] Throws LuauError
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, -1))
        Local results: LuauValue[] = []
        For index = 0 Until slots.Count()
            results.Add(Try LuauValue.FromLuau(slots, index))
        End For
        Return results
    End Method

    /// It as a FutureBlitz function of no arguments that gives a result, which calls it
    /// as Call does, and keeps it alive while it's held.
    @PanicsAtCaller
    Public Method ToFunc<R: LuauType>(): (Func(): R Throws LuauError)
        Return Function(): R Throws LuauError
            Return Try Call<R>()
        End Function
    End Method

    /// It as a FutureBlitz function of no arguments that gives nothing, which calls it
    /// as Invoke does, and keeps it alive while it's held.
    @PanicsAtCaller
    Public Method ToAction(): (Func() Throws LuauError)
        Return Function() Throws LuauError
            Try Invoke()
        End Function
    End Method

    /// Calls it with one argument, and gives its first result as an R, or nil's when it gives
    /// none.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, or of CONVERSION when a result isn't
    /// of its type.
    @PanicsAtCaller
    Public Method Call<R, A1>(a1: A1): R Throws LuauError
        Where R: LuauType
