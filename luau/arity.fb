    /// Registers T, whose objects cross as themselves, and exposes what its reflection says a
    /// script reaches: its Methods marked [LuauExpose], [LuauAction], [LuauGet], and
    /// [LuauSet], each of LuauTypes, and its ToString, for tostring. Registering it again
    /// gives the same builder.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method Register<T: LuauObject>(): LuauTypeBuilder<T> Throws LuauError
        Local kept = KeptType<T>()
        If kept != Null Then Return kept
        Local type = NewType<T>()
        For Method m: M In T
            Where m Has LuauExpose
            Where M: Func(): R
            Where R: LuauType
            Local name = MemberName(m.Attribute(LuauExpose)?.Name, m.Name)
            type.Methods[name] = Function(slots: LuauSlots): Int32
                Try
                    Local object = Try slots.Argument<T>(0, name)
                    Return Try slots.Result(m.Call(object))
                Catch error
                    Return slots.Raise(error)
                End Try
            End Function
        End For
        For Method m: M In T
            Where m Has LuauExpose
            Where M: Func(): R Throws E
            Where R: LuauType
            Where E: Error
            Local name = MemberName(m.Attribute(LuauExpose)?.Name, m.Name)
            type.Methods[name] = Function(slots: LuauSlots): Int32
                Try
