//! What's the same for each number of a function's arguments, from none to 8: a State's
//! SetFunction and Wrap, and a LuauFunction's calls. tools/gen_arity.py writes it; run it again
//! instead of editing it.

Import std.core
Import "./c/fbl_call"
Import "./errors"
Import "./functions"
Import "./state"
Import "./value"
Import "./values"

/// A State's functions both ways: the program's, given to Luau.
Extend LuauState
    /// Sets the global `name` to `f`, a function of no arguments that gives a result, as a Luau
    /// function, as [Wrap] makes it.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method SetFunction<R: LuauType>(name: String, f: Func(): R) Throws LuauError
        Try Set(name, Try Wrap(f, name))
    End Method

    /// `f`, a function of no arguments that gives a result, as a Luau function, named `name` in
    /// Luau's errors and tracebacks: its arguments are read as their types, a missing one as
    /// nil, and an argument of another type is an error in the script, "invalid argument #1
    /// to 'name' (expected Int32, got string)"; its result is given back as its type; and an
    /// error it throws is raised in the script, as its Message after where it was called,
    /// which a script's pcall catches, and which comes back out of the program's call as the
    /// LuauError's Cause.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method Wrap<R: LuauType>(f: Func(): R,
                                    name: String = "function"): LuauFunction Throws LuauError
        Return Try NewFunction(name, Function(slots: LuauSlots): Int32
            Try
                Return Try slots.Result(f())
            Catch error
                Return slots.Raise(error)
            End Try
        End Function)
    End Method

    /// Sets the global `name` to `f`, a function of no arguments that gives a result, and throws, as a Luau
    /// function, as [Wrap] makes it.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method SetFunction<R: LuauType>(name: String, f: Func(): R Throws Error) Throws LuauError
        Try Set(name, Try Wrap(f, name))
    End Method

    /// `f`, a function of no arguments that gives a result, and throws, as a Luau function, named `name` in
    /// Luau's errors and tracebacks: its arguments are read as their types, a missing one as
    /// nil, and an argument of another type is an error in the script, "invalid argument #1
    /// to 'name' (expected Int32, got string)"; its result is given back as its type; and an
    /// error it throws is raised in the script, as its Message after where it was called,
    /// which a script's pcall catches, and which comes back out of the program's call as the
    /// LuauError's Cause.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method Wrap<R: LuauType>(f: Func(): R Throws Error,
                                    name: String = "function"): LuauFunction Throws LuauError
        Return Try NewFunction(name, Function(slots: LuauSlots): Int32
            Try
                Return Try slots.Result(Try f())
            Catch error
                Return slots.Raise(error)
            End Try
        End Function)
    End Method

    /// Sets the global `name` to `f`, a function of no arguments that gives nothing, as a Luau
    /// function, as [Wrap] makes it.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method SetFunction(name: String, f: Func()) Throws LuauError
        Try Set(name, Try Wrap(f, name))
    End Method

    /// `f`, a function of no arguments that gives nothing, as a Luau function, named `name` in
    /// Luau's errors and tracebacks: its arguments are read as their types, a missing one as
    /// nil, and an argument of another type is an error in the script, "invalid argument #1
    /// to 'name' (expected Int32, got string)"; its result is given back as its type; and an
    /// error it throws is raised in the script, as its Message after where it was called,
    /// which a script's pcall catches, and which comes back out of the program's call as the
    /// LuauError's Cause.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method Wrap(f: Func(), name: String = "function"): LuauFunction Throws LuauError
        Return Try NewFunction(name, Function(slots: LuauSlots): Int32
            f()
            Return slots.NoResult()
        End Function)
    End Method

    /// Sets the global `name` to `f`, a function of no arguments that gives nothing, and throws, as a Luau
    /// function, as [Wrap] makes it.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method SetFunction(name: String, f: Func() Throws Error) Throws LuauError
        Try Set(name, Try Wrap(f, name))
    End Method

    /// `f`, a function of no arguments that gives nothing, and throws, as a Luau function, named `name` in
    /// Luau's errors and tracebacks: its arguments are read as their types, a missing one as
    /// nil, and an argument of another type is an error in the script, "invalid argument #1
    /// to 'name' (expected Int32, got string)"; its result is given back as its type; and an
    /// error it throws is raised in the script, as its Message after where it was called,
    /// which a script's pcall catches, and which comes back out of the program's call as the
    /// LuauError's Cause.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method Wrap(f: Func() Throws Error,
                       name: String = "function"): LuauFunction Throws LuauError
        Return Try NewFunction(name, Function(slots: LuauSlots): Int32
            Try
                Try f()
                Return slots.NoResult()
            Catch error
                Return slots.Raise(error)
            End Try
        End Function)
    End Method

    /// Sets the global `name` to `f`, a function of one argument that gives a result, as a Luau
    /// function, as [Wrap] makes it.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method SetFunction<A1, R>(name: String, f: Func(A1): R) Throws LuauError
        Where A1: LuauType
        Where R: LuauType
        Try Set(name, Try Wrap(f, name))
    End Method

    /// `f`, a function of one argument that gives a result, as a Luau function, named `name` in
    /// Luau's errors and tracebacks: its arguments are read as their types, a missing one as
    /// nil, and an argument of another type is an error in the script, "invalid argument #1
    /// to 'name' (expected Int32, got string)"; its result is given back as its type; and an
    /// error it throws is raised in the script, as its Message after where it was called,
    /// which a script's pcall catches, and which comes back out of the program's call as the
    /// LuauError's Cause.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method Wrap<A1, R>(f: Func(A1): R,
                              name: String = "function"): LuauFunction Throws LuauError
        Where A1: LuauType
        Where R: LuauType
        Return Try NewFunction(name, Function(slots: LuauSlots): Int32
            Try
                Local a1 = Try slots.Argument<A1>(0, name)
                Return Try slots.Result(f(a1))
            Catch error
                Return slots.Raise(error)
            End Try
        End Function)
    End Method

    /// Sets the global `name` to `f`, a function of one argument that gives a result, and throws, as a Luau
    /// function, as [Wrap] makes it.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method SetFunction<A1, R>(name: String, f: Func(A1): R Throws Error) Throws LuauError
        Where A1: LuauType
        Where R: LuauType
        Try Set(name, Try Wrap(f, name))
    End Method

    /// `f`, a function of one argument that gives a result, and throws, as a Luau function, named `name` in
    /// Luau's errors and tracebacks: its arguments are read as their types, a missing one as
