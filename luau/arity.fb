/// A Luau function's calls from the program.
Extend LuauFunction
    /// Calls it with no arguments, and gives its first result as an R, or nil's when it gives
    /// none.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, or of CONVERSION when a result isn't
    /// of its type.
    @PanicsAtCaller
    Public Method Call<R: LuauType>(): R Throws LuauError
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 1))
        Return Try R.FromLuau(slots, 0)
    End Method

    /// Calls it with no arguments, and lets its results go.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs.
    @PanicsAtCaller
    Public Method Invoke() Throws LuauError
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 0))
    End Method

    /// Calls it with no arguments, and gives its first 2 results, each as its type.
    ///
    /// # Errors
    ///
    /// A LuauError for what it raises or meets as it runs, or of CONVERSION when a result isn't
    /// of its type.
    @PanicsAtCaller
    Public Method Call2<R1, R2>(): (R1, R2) Throws LuauError
        Where R1: LuauType
        Where R2: LuauType
        Local slots = Try Opened()
        Defer Owner.Closed(slots.Frame)
        Try Owner.Check(fbl_call_function(Owner.Handle, slots.Frame, 0, 2))
        Return (Try R1.FromLuau(slots, 0), Try R2.FromLuau(slots, 1))
    End Method

    /// Calls it with no arguments, and gives its first 3 results, each as its type.
    ///
