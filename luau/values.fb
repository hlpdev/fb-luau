//! What crosses between a program and Luau by its type: the LuauType Interface, and the types
//! the package gives it, the numbers, Bool, and String.

Import std.ffi
Import std.core
Import "./c/fbl_call"
Import "./c/fbl_callback"
Import "./c/fbl_core"
Import "./c/fbl_frame"
Import "./c/fbl_ref"
Import "./c/fbl_thread"
Import "./errors"
Import "./functions"
Import "./library"
Import "./shim"
Import "./state"
Import "./threads"
Import "./value"

/// What crosses between a program and Luau by its type: a type that implements it is one a
/// State's Get and Set, a function's arguments and results, and a table's keys and values take.
/// The package gives it to the numbers, Bool, and String, and to its handles; a program gives it
/// to a type of its own through what the package has for that, never by these members, which
/// only the package can use, since a [LuauSlots] is only its own.
Public Interface LuauType
    /// Gives `value` to Luau, after the values `slots` has.
    Static Method ToLuau(slots: LuauSlots, value: Self) Throws LuauError
    /// The value in slot `index` of `slots`, as this type.
    Static Method FromLuau(slots: LuauSlots, index: Int32): Self Throws LuauError
End Interface

/// The values a call between a program and Luau has, which only the package's own code reads
/// and fills.
Public Struct LuauSlots
    /// The State they're on.
    Package Field Owner: LuauState
    /// Their frame's number.
    Package Field Frame: Int32
    /// How many tables deep a conversion has gone, which stops past 256, as Load's does, so a
    /// table that holds itself is an error, not a hang.
    Package Field Depth: Int = 0

    /// The same slots, a table deeper.
    Package Method Deeper(): LuauSlots Throws LuauError
        If Depth >= 256
            Throw LuauError(LuauErrorKind.CONVERSION,
                            "a table more than 256 deep, or one that holds itself")
        End If
        Return LuauSlots(Owner, Frame, Depth + 1)
    End Method

    /// How many values the frame has.
    @PanicsAtCaller
    Package Method Count(): Int32
        Local count = fbl_frame_count(Owner.Live(), Frame)
        If count < 0 Then Panic(LastError())
        Return count
    End Method

    /// Takes the frame's values from `count` on away.
    @PanicsAtCaller
    Package Method Truncate(count: Int32)
        If !fbl_frame_truncate(Owner.Live(), Frame, count) Then Panic(LastError())
    End Method

    /// Takes slot `index` out, the slots after it each one lower.
    @PanicsAtCaller
    Package Method Remove(index: Int32)
        If !fbl_frame_remove(Owner.Live(), Frame, index) Then Panic(LastError())
    End Method

    /// Calls `function` with the frame's values as its arguments, and leaves its results in their
    /// place: FBL_OK.
    @PanicsAtCaller
    Package Method CalledWith(function: LuauFunction): Int32 Throws LuauError
        Try LuauFunction.ToLuau(Self, function)
        If !fbl_frame_insert(Owner.Live(), Frame, 0) Then Panic(LastError())
        Try Owner.Check(fbl_call_function(Owner.Handle, Frame, 0, -1))
        Return FBL_OK
    End Method

    /// Adds the value of a reference the State has to the frame.
    @PanicsAtCaller
    Package Method PushRef(ref: Int32) Throws LuauError
        Try Owner.Check(fbl_ref_push(Owner.Live(), Frame, ref))
    End Method

    /// A new reference to slot `index`'s value.
    @PanicsAtCaller
    Package Method RefAt(index: Int32): Int32 Throws LuauError
        Local ref: Int32 = 0
        Local status: Int32
        Unsafe
            status = fbl_ref_new(Owner.Live(), Frame, index, AddressOf(ref))
        End Unsafe
        Try Owner.Check(status)
        Return ref
    End Method

    /// Slot `index`'s Luau integer, which has to be one.
    Package Method IntegerAt(index: Int32): Int64
        Local value: Int64 = 0
        Unsafe
            fbl_frame_integer(Owner.Handle, Frame, index, AddressOf(value))
        End Unsafe
        Return value
    End Method

    /// Slot `index`'s string's bytes, which has to be one.
    Package Method BytesAt(index: Int32): UInt8[]
        Local length: Int64 = 0
        Unsafe
            Local bytes = fbl_frame_string(Owner.Handle, Frame, index, AddressOf(length))
            If bytes == Null || length <= 0 Then Return []
            Return Buffer<UInt8>.View(bytes, length).ToArray()
        End Unsafe
    End Method

    /// Adds a string of `bytes` to the frame.
    @PanicsAtCaller
    Package Method PushBytes(bytes: UInt8[]) Throws LuauError
        Local kept = bytes
        Local status: Int32
        Unsafe
            status = fbl_frame_push_string(Owner.Live(), Frame, PointerOf(ByRef kept), kept.Count)
        End Unsafe
        Try Owner.Check(status)
    End Method

    /// The type of slot `index`'s value, as the library numbers them.
    @PanicsAtCaller
    Package Method TypeAt(index: Int32): Int32
        Local type = fbl_frame_type(Owner.Live(), Frame, index)
        If type < 0 Then Panic(LastError())
        Return type
    End Method

    /// A LuauError of CONVERSION, saying a T was expected, and what slot `index` has instead.
    Package Method Wrong(expected: String, index: Int32): LuauError
        Return LuauError(LuauErrorKind.CONVERSION,
                         "expected {expected}, got {LuauTypeName(TypeAt(index))}")
    End Method

    /// Slot `index`'s number, which has to be one, or a Luau integer, as a value of the type
    /// `expected` names.
    Package Method NumberAt(index: Int32, expected: String): Float64 Throws LuauError
        Local type = TypeAt(index)
        If type == FBL_TYPE_INTEGER Then Return IntegerAt(index) As Float64
        If type != FBL_TYPE_NUMBER Then Throw Wrong(expected, index)
        Local value: Float64 = 0
        Unsafe
            fbl_frame_number(Owner.Handle, Frame, index, AddressOf(value))
        End Unsafe
        Return value
    End Method

    /// Slot `index`'s number, which has to be whole and from `low` to `high`, as a value of the
    /// integer type `expected` names.
    Package Method WholeAt(index: Int32, expected: String, low: Float64,
                           high: Float64): Float64 Throws LuauError
        Local value = Try NumberAt(index, expected)
        If value != Floor(value) || value < low || value > high
            Throw LuauError(LuauErrorKind.CONVERSION, "expected {expected}, got {value}")
        End If
        Return value
    End Method

    /// Argument `index` of a call of the program's function `name`, as a T: nil when the call has
    /// fewer.
    ///
    /// # Errors
    ///
    /// A LuauError of CONVERSION when it isn't a T, as Luau says it: "invalid argument #2 to
    /// 'damage' (expected Int32, got string)".
    @PanicsAtCaller
    Package Method Argument<T: LuauType>(index: Int32, name: String): T Throws LuauError
        While Count() <= index
            Try Owner.Check(fbl_frame_push_nil(Owner.Live(), Frame))
        End While
        Try
            Return Try T.FromLuau(Self, index)
        Catch error As LuauError
            If error.Kind != LuauErrorKind.CONVERSION Then Throw error
            Throw LuauError(LuauErrorKind.CONVERSION,
                            "invalid argument #{index + 1} to '{name}' ({error.Message})")
        End Try
    End Method

    /// Leaves `value` as a call's one result: FBL_OK.
    @PanicsAtCaller
    Package Method Result<T: LuauType>(value: T): Int32 Throws LuauError
        Truncate(0)
        Try T.ToLuau(Self, value)
        Return FBL_OK
    End Method

    /// Leaves a call no results: FBL_OK.
    @PanicsAtCaller
    Package Method NoResult(): Int32
        Truncate(0)
        Return FBL_OK
    End Method

    /// Leaves `error` as what a call raises, a status for the library: the value a LuauError from
    /// Luau's code raised, as it was, and any other error's message after where the function was
    /// called, as Luau's own errors are; and keeps it, so it's the Cause of the LuauError it comes
    /// back out as.
    Package Method Raise(error: Error): Int32
        Truncate(0)
        Local where = ""
        If fbl_callback_where(Owner.Live(), Frame) == FBL_OK
            where = Try? String.FromLuau(Self, 0) ?? ""
            Truncate(0)
        End If
        Try? PushError(error, where)
        Return FBL_RUNTIME
    End Method

    /// Adds `error` to the slots as Luau raises it: the value a LuauError from Luau's code raised,
    /// as it was, or the error's message after `where`, keeping the error by it, so it's the Cause
    /// of the LuauError it comes back out as.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY when there's no room for either.
    Package Method PushError(error: Error, where: String) Throws LuauError
        Local count = Count()
        // A LuauError goes on as it was, its value too when that's this State's, or copied; it's
        // kept by its message either way, so it comes back out as the Cause, with its Kind.
        If error Is LuauError
            Local value = (error As LuauError).Value
            If value != Null && value.CanGoTo(Owner)
                Try
                    Try LuauValue.ToLuau(Self, value)
                    Owner.Raised[error.Message] = error
                    Return
                Catch failed As LuauError
                    Truncate(count)
                End Try
            End If
        End If
        Local message = where + error.Message
        Owner.Raised[message] = error
        Try String.ToLuau(Self, message)
    End Method

    /// Nothing when the program's function with these slots can yield its thread, to wait.
    ///
    /// # Errors
    ///
    /// A LuauError of YIELD when nothing can wait for it: on a call of the program's, which runs
    /// to its end, or in a metamethod, saying that `name` waits.
    Package Method Yieldable(name: String) Throws LuauError
        If fbl_thread_can_yield(Owner.Live(), Frame) == 1 Then Return
        Throw LuauError(LuauErrorKind.YIELD,
                        "attempt to yield where nothing can wait for it: '{name}' waits, so it " +
                        "runs on a thread on the scheduler, not in a call of the program's or a " +
                        "metamethod")
    End Method

    /// The thread that called the program's function with these slots.
    Package Method Running(): LuauThread Throws LuauError
        Try Owner.Check(fbl_thread_current(Owner.Live(), Frame))
        Local thread = Try LuauThread.FromLuau(Self, Count() - 1)
        Remove(Count() - 1)
        Return thread
    End Method

    /// Yields the thread that called the program's function with these slots, to wait for `task`,
    /// which gives what it's resumed with: FBL_YIELD, for the library.
    Package Method Awaited(task: Task<LuauResumed>): Int32 Throws LuauError
        Local where = ""
        If fbl_callback_where(Owner.Live(), Frame) == FBL_OK
            where = Try? String.FromLuau(Self, Count() - 1) ?? ""
            Remove(Count() - 1)
        End If
        Owner.Waiting.Add(LuauWaiting(Try Running(), task, where))
        Truncate(0)
        Return FBL_YIELD
    End Method

    /// Nothing when slot `index` holds a value a table's key can be.
    ///
    /// # Errors
    ///
    /// A LuauError of CONVERSION for nil or NaN, which no table's key is.
    Package Method KeyAt(index: Int32) Throws LuauError
        Local type = TypeAt(index)
        If type == FBL_TYPE_NIL
            Throw LuauError(LuauErrorKind.CONVERSION, "a table's key can't be nil")
        End If
        If type == FBL_TYPE_NUMBER
            Local number = Try Float64.FromLuau(Self, index)
            If number != number Then Throw LuauError(LuauErrorKind.CONVERSION, "a table's key can't be NaN")
        End If
    End Method

    /// Adds the value of the State's reference `ref`, for a member that can't throw, panicking at
    /// the caller with what happened when the State has no memory left for it.
    @PanicsAtCaller
    Package Method PushHeld(ref: Int32)
        Try
            Try PushRef(ref)
        Catch error As LuauError
            Panic("the Luau State has no memory left to reach the value: {error.Message}")
        End Try
    End Method

    /// Gives a number to Luau.
    @PanicsAtCaller
    Package Method PushNumber(value: Float64) Throws LuauError
        Try Owner.Check(fbl_frame_push_number(Owner.Live(), Frame, value))
    End Method
End Struct

/// Whether `value` is a number an Int64 holds with every digit, from -2^53 to 2^53, so its `As
/// Int64` can't panic, and gives it back as it was when it's whole: not NaN, nor an infinity.
Package Function Exact(value: Float64): Bool
    Return value == value && value <= 9007199254740992.0 && value >= -9007199254740992.0
End Function

/// Rounds `value` down to a whole number, without std.math, whose Floor is for Floats too.
Function Floor(value: Float64): Float64
    If !Exact(value) Then Return value
    Local whole = (value As Int64) As Float64
    Return whole > value ? whole - 1 : whole
End Function

/// A Bool, which is Luau's boolean, and is read only from one: nil isn't False.
Extend Bool Implements LuauType
    /// Gives it to Luau as a boolean.
    Public Static Method ToLuau(slots: LuauSlots, value: Bool) Throws LuauError
        Try slots.Owner.Check(fbl_frame_push_boolean(slots.Owner.Live(), slots.Frame, value))
    End Method

    /// A boolean slot's value.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): Bool Throws LuauError
        If slots.TypeAt(index) != FBL_TYPE_BOOLEAN Then Throw slots.Wrong("Bool", index)
        Local value = False
        Unsafe
            fbl_frame_boolean(slots.Owner.Handle, slots.Frame, index, AddressOf(value))
        End Unsafe
        Return value
    End Method
End Extend

/// A String, which is Luau's string. One Luau gives that isn't well-formed UTF-8 has U+FFFD for
/// each byte that doesn't start well-formed UTF-8.
Extend String Implements LuauType
    /// Gives it to Luau as a string of its UTF-8 bytes.
    Public Static Method ToLuau(slots: LuauSlots, value: String) Throws LuauError
        Local bytes = value.Bytes
        Local status: Int32
        Unsafe
            status = fbl_frame_push_string(slots.Owner.Live(), slots.Frame, PointerOf(ByRef bytes),
                                           bytes.Count)
        End Unsafe
        Try slots.Owner.Check(status)
    End Method

    /// A string slot's value; a number isn't one.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): String Throws LuauError
        If slots.TypeAt(index) != FBL_TYPE_STRING Then Throw slots.Wrong("String", index)
        Local length: Int64 = 0
        Unsafe
            Return TextAt(fbl_frame_string(slots.Owner.Handle, slots.Frame, index,
                                           AddressOf(length)),
                          length)
        End Unsafe
    End Method
End Extend

/// A Float64, which is Luau's number.
Extend Float64 Implements LuauType
    /// Gives it to Luau as a number.
    Public Static Method ToLuau(slots: LuauSlots, value: Float64) Throws LuauError
        Try slots.PushNumber(value)
    End Method

    /// A number slot's value.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): Float64 Throws LuauError
        Return Try slots.NumberAt(index, "Float64")
    End Method
End Extend

/// A Float32, which is Luau's number, read from one a Float32 holds: a finite number past a
/// Float32's largest isn't one, but infinity and NaN are.
Extend Float32 Implements LuauType
    /// Gives it to Luau as a number.
    Public Static Method ToLuau(slots: LuauSlots, value: Float32) Throws LuauError
        Try slots.PushNumber(value)
    End Method

    /// A number slot's value, which has to be one a Float32 holds.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): Float32 Throws LuauError
        Local value = Try slots.NumberAt(index, "Float32")
        // Infinity less itself is NaN, as NaN less anything is, so this is a finite number.
        Local finite = value - value == 0
        If finite && (value > 3.4028234663852886e38 || value < -3.4028234663852886e38)
            Throw LuauError(LuauErrorKind.CONVERSION, "expected Float32, got {value}")
        End If
        Return value As Float32
    End Method
End Extend

/// An Int32, which is Luau's number, read from a whole one in its range.
Extend Int32 Implements LuauType
    /// Gives it to Luau as a number.
    Public Static Method ToLuau(slots: LuauSlots, value: Int32) Throws LuauError
        Try slots.PushNumber(value)
    End Method

    /// A whole number slot's value, in an Int32's range.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): Int32 Throws LuauError
        Return (Try slots.WholeAt(index, "Int32", -2147483648.0, 2147483647.0)) As Int32
    End Method
End Extend

/// An Int64, which is Luau's number while it's one a number holds exactly, from -2^53 to 2^53.
Extend Int64 Implements LuauType
    /// Gives it to Luau as a number.
    ///
    /// # Errors
    ///
    /// A LuauError of CONVERSION past 2^53 either way, which a number would round.
    Public Static Method ToLuau(slots: LuauSlots, value: Int64) Throws LuauError
        If value > 9007199254740992 || value < -9007199254740992 Then Throw Inexact("{value}")
        Try slots.PushNumber(value As Float64)
    End Method

    /// A whole number slot's value, in an Int64's range, or a Luau integer's.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): Int64 Throws LuauError
        If slots.TypeAt(index) == FBL_TYPE_INTEGER Then Return slots.IntegerAt(index)
        Return (Try slots.WholeAt(index, "Int64", -9223372036854775808.0,
                                  9223372036854774784.0)) As Int64
    End Method
End Extend

/// An Int16, which is Luau's number, read from a whole one in its range.
Extend Int16 Implements LuauType
    /// Gives it to Luau as a number.
    Public Static Method ToLuau(slots: LuauSlots, value: Int16) Throws LuauError
        Try slots.PushNumber(value)
    End Method

    /// A whole number slot's value, in an Int16's range.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): Int16 Throws LuauError
        Return (Try slots.WholeAt(index, "Int16", -32768.0, 32767.0)) As Int16
    End Method
End Extend

/// An Int8, which is Luau's number, read from a whole one in its range.
Extend Int8 Implements LuauType
    /// Gives it to Luau as a number.
    Public Static Method ToLuau(slots: LuauSlots, value: Int8) Throws LuauError
        Try slots.PushNumber(value)
    End Method

    /// A whole number slot's value, in an Int8's range.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): Int8 Throws LuauError
        Return (Try slots.WholeAt(index, "Int8", -128.0, 127.0)) As Int8
    End Method
End Extend

/// A UInt64, which is Luau's number while it's one a number holds exactly, up to 2^53.
Extend UInt64 Implements LuauType
    /// Gives it to Luau as a number.
    ///
    /// # Errors
    ///
    /// A LuauError of CONVERSION past 2^53, which a number would round.
    Public Static Method ToLuau(slots: LuauSlots, value: UInt64) Throws LuauError
        If value > 9007199254740992 Then Throw Inexact("{value}")
        Try slots.PushNumber(value As Float64)
    End Method

    /// A whole number slot's value, in a UInt64's range, or a Luau integer's from 0 up.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): UInt64 Throws LuauError
        If slots.TypeAt(index) == FBL_TYPE_INTEGER
            Local value = slots.IntegerAt(index)
            If value < 0
                Throw LuauError(LuauErrorKind.CONVERSION, "expected UInt64, got {value}")
            End If
            Return value As UInt64
        End If
        Return (Try slots.WholeAt(index, "UInt64", 0.0, 18446744073709549568.0)) As UInt64
    End Method
End Extend

/// A UInt32, which is Luau's number, read from a whole one in its range.
Extend UInt32 Implements LuauType
    /// Gives it to Luau as a number.
    Public Static Method ToLuau(slots: LuauSlots, value: UInt32) Throws LuauError
        Try slots.PushNumber(value)
    End Method

    /// A whole number slot's value, in a UInt32's range.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): UInt32 Throws LuauError
        Return (Try slots.WholeAt(index, "UInt32", 0.0, 4294967295.0)) As UInt32
    End Method
End Extend

/// A UInt16, which is Luau's number, read from a whole one in its range.
Extend UInt16 Implements LuauType
    /// Gives it to Luau as a number.
    Public Static Method ToLuau(slots: LuauSlots, value: UInt16) Throws LuauError
        Try slots.PushNumber(value)
    End Method

    /// A whole number slot's value, in a UInt16's range.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): UInt16 Throws LuauError
        Return (Try slots.WholeAt(index, "UInt16", 0.0, 65535.0)) As UInt16
    End Method
End Extend

/// A UInt8, which is Luau's number, read from a whole one in its range.
Extend UInt8 Implements LuauType
    /// Gives it to Luau as a number.
    Public Static Method ToLuau(slots: LuauSlots, value: UInt8) Throws LuauError
        Try slots.PushNumber(value)
    End Method

    /// A whole number slot's value, in a UInt8's range.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): UInt8 Throws LuauError
        Return (Try slots.WholeAt(index, "UInt8", 0.0, 255.0)) As UInt8
    End Method
End Extend

/// A LuauError of CONVERSION, saying `value` is past what a Luau number holds exactly.
Function Inexact(value: String): LuauError
    Return LuauError(LuauErrorKind.CONVERSION,
                     "{value} is past what a Luau number holds exactly, 2^53 either way")
End Function

/// Luau's 64-bit integer, of its `integer` library and `1i` literals, which a number isn't: the
/// two never compare equal in Luau, so a program says which it gives.
///
/// # Examples
///
/// ```
/// # Import luau
/// Local lua = LuauState()
/// Try lua.Set("big", LuauInteger(9007199254740993))
/// Expect(Try lua.Evaluate<String>("return typeof(big)") == "integer")
/// Expect(Try lua.Get<Int64>("big") == 9007199254740993)
/// ```
Public Struct LuauInteger Implements LuauType
    /// Its value.
    Public Field Value: Int64

    /// Gives it to Luau as an integer.
    Public Static Method ToLuau(slots: LuauSlots, value: LuauInteger) Throws LuauError
        Try slots.Owner.Check(fbl_frame_push_integer(slots.Owner.Live(), slots.Frame, value.Value))
    End Method

    /// An integer slot's value; a number isn't one.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): LuauInteger Throws LuauError
        If slots.TypeAt(index) != FBL_TYPE_INTEGER Then Throw slots.Wrong("LuauInteger", index)
        Return LuauInteger(slots.IntegerAt(index))
    End Method
End Struct

/// A Luau string as its bytes, which can be any, as a String's can't: binary data a script holds
/// in a string, like what string.pack makes.
///
/// # Examples
///
/// ```
/// # Import luau
/// Local lua = LuauState()
/// Local packed = Try lua.Evaluate<LuauBytes>("return string.pack('<I2', 513)")
/// Expect(packed.Bytes == [1 As UInt8, 2])
/// ```
Public Struct LuauBytes Implements LuauType
    /// Its bytes.
    Public Field Bytes: UInt8[]

    /// Gives it to Luau as a string of its bytes.
    Public Static Method ToLuau(slots: LuauSlots, value: LuauBytes) Throws LuauError
        Try slots.PushBytes(value.Bytes)
    End Method

    /// A string slot's bytes, as they are.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): LuauBytes Throws LuauError
        If slots.TypeAt(index) != FBL_TYPE_STRING Then Throw slots.Wrong("LuauBytes", index)
        Return LuauBytes(slots.BytesAt(index))
    End Method
End Struct

/// Luau's nil, as a value of its own: what a function that takes nothing takes, or a result
/// that's only nil.
Public Struct LuauNil Implements LuauType
    /// Gives Luau a nil.
    Public Static Method ToLuau(slots: LuauSlots, value: LuauNil) Throws LuauError
        Try slots.Owner.Check(fbl_frame_push_nil(slots.Owner.Live(), slots.Frame))
    End Method

    /// A nil slot's; anything else isn't one.
    Public Static Method FromLuau(slots: LuauSlots, index: Int32): LuauNil Throws LuauError
        If slots.TypeAt(index) != FBL_TYPE_NIL Then Throw slots.Wrong("LuauNil", index)
        Return LuauNil()
    End Method
End Struct
