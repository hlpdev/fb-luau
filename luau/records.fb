//! Records: Structs and Classes that cross as tables of their Fields, copied, through std's Load
//! and Save, so a record has what they have.

Import std.core
Import std.text
Import "./c/fbl_frame"
Import "./c/fbl_table"
Import "./errors"
Import "./library"
Import "./shim"
Import "./values"

/// A type that crosses as a table of its Fields, by name, copied each way, through std's Load and
/// Save: listing it is all a Struct or Class needs, and what Load and Save take, a T?, a T[], a
/// Map, an Enum by its name, another record, and std's attributes, like `@Rename`, `@Skip`, and
/// `@Strict`, its Fields can have. A Field the table hasn't is its default, or its zero, as Load
/// has it. A record is data: a Field of a handle, like a LuauTable, isn't one Load takes.
///
/// A Luau table is an array when its keys are 1 to its length, an Object when they're strings,
/// and an empty one is whichever its Field is.
///
/// # Examples
///
/// ```
/// # Import luau
/// Struct Spawn Implements LuauRecord
///     Field Name: String
///     Field Count: Int = 1
///     Field Tags: String[]
///     Field Boss: String?
/// End Struct
///
/// Local lua = LuauState()
/// Local spawn = Try lua.Evaluate<Spawn>(r"return { Name = 'rat', Tags = { 'small' } }")
/// Expect(spawn.Name == "rat" && spawn.Count == 1 && spawn.Tags == ["small"] && spawn.Boss == Null)
/// Try lua.Set("spawn", Spawn("bat", 3, [], "vampire"))
/// Expect(Try lua.Evaluate<String>("return spawn.Boss .. spawn.Count") == "vampire3")
/// ```
Public Interface LuauRecord Extends LuauType
    /// Gives it to Luau as a new table of its Fields, as Save writes them.
    Static Method ToLuau(slots: LuauSlots, value: Self) Throws LuauError
        Try PushValue(slots, Save(value))
    End Method

    /// A table slot's table, read into a new value, as Load reads it.
    Static Method FromLuau(slots: LuauSlots, index: Int32): Self Throws LuauError
        Local name = TypeName<Self>()
        If slots.TypeAt(index) != FBL_TYPE_TABLE Then Throw slots.Wrong(name, index)
        Local data = Try ValueAt(slots, index)
        // An empty table was read as an empty array; where Load wanted an Object, it's one, and
        // so is each empty table at that path in every element of the arrays on the way, as an
        // array's elements are one type.
        For swap = 0 To 10000
            Try
                recordLoads++
                Return Try Load<Self>(data)
            Catch error As ParseError
                Local path = error.Path ?? ""
                If error.Kind == ParseErrorKind.WRONG_TYPE && SwappedEmpty(ByRef data, path)
                    Continue
                End If
                Throw LuauError(LuauErrorKind.CONVERSION,
                                "a table isn't a {name}: {Said(error, data, path)}", "", error)
            End Try
        End For
        Throw LuauError(LuauErrorKind.CONVERSION, "a table isn't a {name}")
    End Method
End Interface

/// A slot's value as a std Value, a table's as an Array or an Object, a table deeper each step.
Package Function ValueAt(slots: LuauSlots, index: Int32): Value Throws LuauError
    Select slots.TypeAt(index)
        Case FBL_TYPE_NIL
            Return Value()
        Case FBL_TYPE_BOOLEAN
            Return Value(Try Bool.FromLuau(slots, index))
        Case FBL_TYPE_NUMBER
            Local number = Try Float64.FromLuau(slots, index)
            If Exact(number) && number == (number As Int64) As Float64
                Return Value(number As Int64)
            End If
            Return Value(number)
        Case FBL_TYPE_INTEGER
            Return Value(slots.IntegerAt(index))
        Case FBL_TYPE_STRING
            Return Value(Try String.FromLuau(slots, index))
        Case FBL_TYPE_TABLE
            Return Try TableAt(Try slots.Deeper(), index)
        Default
            Throw LuauError(LuauErrorKind.CONVERSION,
                            "a {LuauTypeName(slots.TypeAt(index))} isn't data a record holds")
    End Select
End Function

/// A table slot's table as an Array of its items from 1, when its keys are 1 to its count, or an
/// Object of its string keys.
Function TableAt(slots: LuauSlots, index: Int32): Value Throws LuauError
    Local handle = slots.Owner.Live()
    Local top = slots.Count()
    Local count = 0
    Local strings = 0
    Local most: Float64 = 0
    Local items = True
    Local iterator: Int32 = 0
    While True
        iterator = fbl_table_next(handle, slots.Frame, index, iterator)
        If iterator == -1 Then Break
        If iterator < -1 Then Panic(LastError())
        count++
        Select slots.TypeAt(top)
            Case FBL_TYPE_STRING
                strings++
            Case FBL_TYPE_NUMBER
                Local key = Try Float64.FromLuau(slots, top)
                If Exact(key) && key >= 1 && key == (key As Int64) As Float64
                    If key > most Then most = key
                Else
                    items = False
                End If
            Default
                items = False
        End Select
        slots.Truncate(top)
    End While
    If count == 0 Then Return Value.Array()
    If strings == 0 && items && most == count As Float64
        Local array = Value.Array()
        For item = 1 To count
            Try slots.Owner.Check(fbl_table_raw_get_index(handle, slots.Frame, index, item))
            array.Add(Try ValueAt(slots, top))
            slots.Truncate(top)
        End For
        Return array
    End If
    If strings != count
        Throw LuauError(LuauErrorKind.CONVERSION,
                        "a table of keys that aren't strings, of items with holes, or of both " +
                        "keys and items, isn't data a record holds")
    End If
    Local entries = Value.Object()
    iterator = 0
    While True
        iterator = fbl_table_next(handle, slots.Frame, index, iterator)
        If iterator == -1 Then Break
        entries[Try String.FromLuau(slots, top)] = Try ValueAt(slots, top + 1)
        slots.Truncate(top)
    End While
    Return entries
End Function

/// Gives a std Value to Luau: an Array as a table of its items from 1, an Object as one of its
/// keys.
Package Function PushValue(slots: LuauSlots, data: Value) Throws LuauError
    Local handle = slots.Owner.Live()
    Select data.Kind
        Case ValueKind.NULL
            Try slots.Owner.Check(fbl_frame_push_nil(handle, slots.Frame))
        Case ValueKind.BOOL
            Try Bool.ToLuau(slots, data.AsBool() ?? False)
        Case ValueKind.INT
            Try Int64.ToLuau(slots, data.AsInt64() ?? 0)
        Case ValueKind.UINT
            Try UInt64.ToLuau(slots, data.AsUInt64() ?? 0)
        Case ValueKind.DOUBLE
            Try Float64.ToLuau(slots, data.AsDouble() ?? 0)
        Case ValueKind.STRING
            Try String.ToLuau(slots, data.AsString() ?? "")
        Case ValueKind.BYTES
            Try slots.PushBytes(data.AsBytes() ?? [])
        Case ValueKind.ARRAY
            Local deeper = Try slots.Deeper()
            Local items = data.AsArray() ?? []
            Try slots.Owner.Check(fbl_table_new(handle, slots.Frame, items.Count, 0))
            Local table = slots.Count() - 1
            For index = 0 Until items.Count
                Try slots.Owner.Check(fbl_frame_push_number(handle, slots.Frame, index + 1))
                Try PushValue(deeper, items[index])
                Try slots.Owner.Check(fbl_table_raw_set(handle, slots.Frame, table, table + 1,
                                                        table + 2))
                slots.Truncate(table + 1)
            End For
        Case ValueKind.OBJECT
            Local deeper = Try slots.Deeper()
            Local keys = data.Keys()
            Try slots.Owner.Check(fbl_table_new(handle, slots.Frame, 0, keys.Count))
            Local table = slots.Count() - 1
            For key In keys
                Try String.ToLuau(slots, key)
                Try PushValue(deeper, data[key] ?? Value())
                Try slots.Owner.Check(fbl_table_raw_set(handle, slots.Frame, table, table + 1,
                                                        table + 2))
                slots.Truncate(table + 1)
            End For
    End Select
End Function

/// How many Loads records have run on this thread, which the tests count.
ThreadLocal Global recordLoads: Int = 0

/// How many Loads records have run on this thread.
Package Function RecordLoads(): Int => recordLoads

/// A step of a Load error's path: a key, or an index, when Index isn't -1.
Struct PathStep
    Field Key: String
    Field Index: Int64
End Struct

/// The steps of a path as std's Load writes them: a key alone first or after a dot, an index in
/// brackets, and a key in brackets and quotes, as JSON quotes a string, when it's empty or has a
/// dot or a bracket; or Null for text that isn't one, which nothing then swaps.
Function PathSteps(path: String): PathStep[]?
    Local bytes = path.Bytes
    Local steps: PathStep[] = []
    Local at = 0
    While at < bytes.Count
        Local byte = bytes[at]
        If byte == 91
            // [digits] or ["quoted"].
            at++
            If at < bytes.Count && bytes[at] == 34
                Local key = QuotedKey(bytes, ByRef at)
                If key == Null || at >= bytes.Count || bytes[at] != 93 Then Return Null
                steps.Add(PathStep(key, -1))
                at++
                Continue
            End If
            Local number: Int64 = 0
            Local digits = 0
            While at < bytes.Count && bytes[at] >= 48 && bytes[at] <= 57 && digits < 18
                number = number * 10 + (bytes[at] - 48) As Int64
                digits++
                at++
            End While
            If digits == 0 || at >= bytes.Count || bytes[at] != 93 Then Return Null
            steps.Add(PathStep("", number))
            at++
            Continue
        End If
        If byte == 46
            If steps.Count == 0 Then Return Null
            at++
        ElseIf steps.Count > 0
            Return Null
        End If
        // A key, to the next dot or bracket.
        Local part: UInt8[] = []
        While at < bytes.Count && bytes[at] != 46 && bytes[at] != 91 && bytes[at] != 93
            part.Add(bytes[at])
            at++
        End While
        If part.Count == 0 Then Return Null
        Local key = String.FromUtf8(part)
        If key == Null Then Return Null
        steps.Add(PathStep(key, -1))
    End While
    Return steps
End Function

/// The quoted key at `at`, its opening quote, as JSON quotes a string: `\"`, `\\`, `\/`, `\b`,
/// `\f`, `\n`, `\r`, `\t`, and `\u` and four hex digits; `at` past its closing quote. Null for
/// one that isn't.
Function QuotedKey(bytes: UInt8[], ByRef at: Int): String?
    Local key: UInt8[] = []
    at++
    While at < bytes.Count
        Local byte = bytes[at]
        If byte == 34
            at++
            Return String.FromUtf8(key)
        End If
        If byte != 92
            key.Add(byte)
            at++
            Continue
        End If
        at++
        If at >= bytes.Count Then Return Null
        Select bytes[at]
            Case 34, 92, 47
                key.Add(bytes[at])
            Case 98
                key.Add(8)
            Case 102
                key.Add(12)
            Case 110
                key.Add(10)
            Case 114
                key.Add(13)
            Case 116
                key.Add(9)
            Case 117
                If at + 4 >= bytes.Count Then Return Null
                Local code = 0
                For digit = 1 To 4
                    Local hex = bytes[at + digit]
                    If hex >= 48 && hex <= 57
                        code = code * 16 + (hex - 48) As Int
                    ElseIf hex >= 97 && hex <= 102
                        code = code * 16 + (hex - 87) As Int
                    ElseIf hex >= 65 && hex <= 70
                        code = code * 16 + (hex - 55) As Int
                    Else
                        Return Null
                    End If
                End For
                at += 4
                Local char = Char.From(code)
                If char == Null Then Return Null
                For each In "{char}".Bytes
                    key.Add(each)
                End For
            Default
                Return Null
        End Select
        at++
    End While
    Return Null
End Function

/// Makes the empty Array at Load's `path` in `data` an empty Object, where a Field wanted one,
/// and each empty Array at that path with any index in its index steps; whether it made one.
Function SwappedEmpty(ByRef data: Value, path: String): Bool
    If path == ""
        If !data.IsArray || data.Count != 0 Then Return False
        data = Value.Object()
        Return True
    End If
    Local steps = PathSteps(path)
    If steps == Null || steps.Count == 0 Then Return False
    Return Swapped(data, steps, 0) > 0
End Function

/// Makes each empty Array that steps `at` and on name from `parent` an empty Object, any index
/// standing for every element of its array: how many it made.
Function Swapped(parent: Value, steps: PathStep[], at: Int): Int
    Local step = steps[at]
    Local last = at == steps.Count - 1
    If step.Index < 0
        Local child = parent[step.Key]
        If child == Null Then Return 0
        If !last Then Return Swapped(child, steps, at + 1)
        If !child.IsArray || child.Count != 0 Then Return 0
        parent[step.Key] = Value.Object()
        Return 1
    End If
    If !parent.IsArray Then Return 0
    Local made = 0
    For index = 0 Until parent.Count
        Local child = parent[index]
        If child == Null Then Continue
        If !last
            made += Swapped(child, steps, at + 1)
        ElseIf child.IsArray && child.Count == 0
            parent[index] = Value.Object()
            made++
        End If
    End For
    Return made
End Function

/// What Load's `error` says, but that an empty table it found is one, not the Array or Object it
/// was read as.
Function Said(error: ParseError, data: Value, path: String): String
    Local message = error.Message
    If error.Kind != ParseErrorKind.WRONG_TYPE Then Return message
    Local none: PathStep[] = []
    Local steps = path == "" ? none : PathSteps(path)
    If steps == Null Then Return message
    Local found: Value? = data
    For step In steps
        Local here = found
        If here == Null Then Return message
        found = step.Index < 0 ? here[step.Key] : here[step.Index As Int]
    End For
    If found == Null || found.Count != 0 || (!found.IsArray && !found.IsObject) Then Return message
    For kind In [", found an Array", ", found an Object"]
        If message.EndsWith(kind)
            Return message.Slice(0, message.Length - kind.Length) + ", found an empty table"
        End If
    End For
    Return message
End Function
