Import std.core
Import std.test
Import std.text
Import std.time
Import luau

/// Twice `n`, a tick later, as an Async Function the program gives scripts.
Async Function Doubled(n: Int): Int
    Await NextTick()
    Return n * 2
End Function

/// An error, a tick later.
Async Function Refused(why: String): Int Throws ParseError
    Await NextTick()
    Throw ParseError(ParseErrorKind.SYNTAX, why)
End Function

/// Nothing, `seconds` of the scheduler's time later.
Async Function Slept(seconds: Float64)
    Await Wait(seconds.Seconds)
End Function

/// Runs the main scheduler for `milliseconds` of the real clock.
Function Waited(milliseconds: Int)
    Wait((milliseconds As Int64).Milliseconds).Wait()
End Function

/// Ticks `scheduler` by `step` until `task` is done: the time it took, or -1 past `most`.
Function Ticked(scheduler: Scheduler, task: Task Throws LuauError, step: Float64,
                most: Float64): Float64
    Local time: Float64 = 0.0
    While !task.IsDone()
        If time > most Then Return -1.0
        scheduler.Tick(step)
        time += step
    End While
    Return time
End Function

/// Closes `lua`, and runs the main scheduler until its driver's Task, `driving`, ends with CLOSED.
Function Stopped(lua: LuauState, driving: Task Throws LuauError)
    lua.Close()
    Local error = ExpectThrows<LuauError>(driving.Wait())
    Expect(error != Null && error.Kind == LuauErrorKind.CLOSED)
End Function

@Test
Function AStartedThreadWaitsOnTheMainScheduler() Throws LuauError
    Local lua = LuauState()
    Try lua.Run(
        "function main() log = 'a' local waited = task.wait(0.01) log ..= 'b' .. waited end")
    Local thread = Try lua.Spawn(Try lua.Get<LuauFunction>("main"))
    Local done = thread.Start()
    // It ran until it waited, and the program goes on meanwhile.
    Expect(Try lua.Get<String>("log") == "a")
    Expect(!done.IsDone())
    Try done.Wait()
    Expect(Try lua.Get<String>("log") == "ab0.01")
    Expect(thread.Status == LuauThreadStatus.FINISHED)
End Function

@Test
Function AThreadOnAProgramsSchedulerFollowsItsPauseAndTimeScale() Throws LuauError
    Local lua = LuauState()
    Try lua.Run("function main() task.wait(2) done = true end")
    Local playback = Scheduler()
    Local thread = Try lua.Spawn(Try lua.Get<LuauFunction>("main"))
    Local done = thread.Start()
    playback.Run(done)
    // Paused: real time passes, but the Scheduler's doesn't.
    Waited(20)
    Expect(!done.IsDone())
    // Its time: done at 2 seconds of it, late by its first tick and two more at most.
    Local took = Ticked(playback, done, 0.1, 10.0)
    Expect(took >= 2.0 && took <= 2.35, "{took}")
    Expect(Try lua.Get<Bool>("done"))
End Function

@Test
Function AnAsyncFunctionOnAProgramsSchedulerWaitsByItsTime() Throws LuauError
    Local lua = LuauState()
    Try lua.SetAsync("sleep", Function(seconds: Float64) => Slept(seconds))
    Try lua.Run("function main() task.wait(1) sleep(2) done = true end")
    Local playback = Scheduler()
    Local done = (Try lua.Spawn(Try lua.Get<LuauFunction>("main"))).Start()
    playback.Run(done)
    // The sleep starts at the first wait's end, on the Scheduler running it then.
    Local took = Ticked(playback, done, 0.1, 10.0)
    Expect(took >= 3.0 && took <= 3.5, "{took}")
    Expect(Try lua.Get<Bool>("done"))
End Function

@Test
Function AnAsyncFunctionsTaskIsWaitedForAndItsErrorRaisedInTheScript() Throws LuauError
    Local lua = LuauState()
    Try lua.SetAsync("double", Function(n: Int) => Doubled(n))
    Try lua.SetAsync("refuse", Function(why: String) => Refused(why))
    Try lua.SetAsync("sleep", Function(seconds: Float64) => Slept(seconds))
    Try lua.Run("function main()\n" +
                "    result = double(21)\n" +
                "    sleep(0.01)\n" +
                "    ok, message = pcall(refuse, 'no')\n" +
                "    refuse('again')\n" +
                "end")
    Local done = (Try lua.Spawn(Try lua.Get<LuauFunction>("main"))).Start()
    Local error = ExpectThrows<LuauError>(done.Wait())
    Expect(Try lua.Get<Int>("result") == 42)
    Expect(!(Try lua.Get<Bool>("ok")))
    Expect(Try lua.Get<String>("message") == "no")
    Expect(error != Null && error.Kind == LuauErrorKind.RUNTIME)
    Expect(error != Null && error.Message == "chunk:5: again")
    Expect(error != Null && error.Cause Is ParseError)
End Function

@Test
Function AThreadsTaskGivesItsError() Throws LuauError
    Local lua = LuauState()
    Try lua.Run("function main() task.wait() error('late') end")
    Local done = (Try lua.Spawn(Try lua.Get<LuauFunction>("main"))).Start()
    Local error = ExpectThrows<LuauError>(done.Wait())
    Expect(error != Null && error.Kind == LuauErrorKind.RUNTIME)
    Expect(error != Null && error.Message == "chunk:1: late")
    Expect(error != Null && error.Traceback.Contains("main"))
End Function

@Test
Function AStateClosedWithThreadsWaitingLetsThemGo() Throws LuauError
    Local lua = LuauState()
    Try lua.Run("function main() task.wait(5) reached = true end")
    Local playback = Scheduler()
    Local thread = Try lua.Spawn(Try lua.Get<LuauFunction>("main"))
    Local done = thread.Start()
    playback.Run(done)
    playback.Tick(0.1)
    lua.Close()
    // Its Task ends at the next tick; its timer within a second of the Scheduler's.
    playback.Tick(0.1)
    Expect(done.IsDone())
    Local error = ExpectThrows<LuauError>(done.Wait())
    Expect(error != Null && error.Kind == LuauErrorKind.CLOSED)
    playback.Tick(1.1)
    Expect(playback.IsIdle())
End Function

@Test
Function AYieldWhereNothingCanWaitIsAnErrorOfYield() Throws LuauError
    Local lua = LuauState()
    Local called = 0
    Try lua.SetAsync("double", Function(n: Int): Task<Int>
        called++
        Return Doubled(n)
    End Function)
    Local sources = ["task.wait(1)", "double(1)", "coroutine.yield()",
                     "coroutine.wrap(function() task.wait(1) end)()"]
    For source In sources
        Local error = ExpectThrows<LuauError>(lua.Run(source))
        Expect(error != Null && error.Kind == LuauErrorKind.YIELD, source)
        Expect(error != Null && error.Message.Contains("nothing can wait for it"), source)
    End For
    Expect(called == 0)
    // In a metamethod, on a thread on the scheduler.
    Try lua.Run(
        r"function main() return setmetatable({}, { __index = function() return double(1) " +
        r"end }).x end")
    Local done = (Try lua.Spawn(Try lua.Get<LuauFunction>("main"))).Start()
    Local error = ExpectThrows<LuauError>(done.Wait())
    Expect(error != Null && error.Kind == LuauErrorKind.YIELD)
    Expect(called == 0)
End Function

@Test
Function TheTaskLibrarySpawnsDefersDelaysAndCancels() Throws LuauError
    Local lua = LuauState()
    Local driving = lua.Start()
    Try lua.Run(r"order = {}" + "\n" +
                "local function add(what) table.insert(order, what) end\n" +
                "task.spawn(function(what) add(what) task.wait() add('spawned') end, 'now')\n" +
                "task.defer(add, 'deferred')\n" +
                "task.delay(0.01, add, 'delayed')\n" +
                "task.cancel(task.delay(0.01, add, 'cancelled'))\n" +
                "add('ran')")
    Expect(Try lua.Evaluate<String>("return table.concat(order, ' ')") == "now ran")
    Waited(100)
    Local order = Try lua.Evaluate<String>("return table.concat(order, ' ')")
    Expect(order.StartsWith("now ran "), order)
    Expect(order.EndsWith(" delayed"), order)
    Expect(order.Contains("spawned") && order.Contains("deferred"), order)
    Expect(!order.Contains("cancelled"))
    Stopped(lua, driving)
End Function

@Test
Function ACoroutineThatWaitsGoesOnByTheScheduler() Throws LuauError
    Local lua = LuauState()
    Local driving = lua.Start()
    Try lua.Run(
        "log = '' coroutine.wrap(function() task.wait() log ..= 'later' end)() log ..= 'now '")
    Expect(Try lua.Get<String>("log") == "now ")
    Waited(30)
    Expect(Try lua.Get<String>("log") == "now later")
    Stopped(lua, driving)
End Function

@Test
Function AnErrorEndingAThreadNothingWaitsForGoesToThreadError() Throws LuauError
    Local errors: String[] = []
    Local options = LuauOptions()
    options.ThreadError = Function(error: LuauError)
        errors.Add(error.Message)
    End Function
    Local lua = Try LuauState(options)
    Local driving = lua.Start()
    Try lua.Run("task.spawn(function() error('spawned') end)\n" +
                "task.defer(function() error('deferred') end)")
    // Given once the call's ended, not inside it.
    Expect(errors == ["chunk:1: spawned"])
    Waited(30)
    Expect(errors == ["chunk:1: spawned", "chunk:2: deferred"])
    Stopped(lua, driving)
End Function

@Test
Function AThreadIsResumedByHand() Throws LuauError
    Local lua = LuauState()
    Try lua.Run(
        "co = coroutine.create(function(a, b) local c = coroutine.yield(a + b) return c * 2 end)")
    Local thread = Try lua.Get<LuauThread>("co")
    Expect(thread.Status == LuauThreadStatus.SUSPENDED)
    Local first = Try thread.Resume(2, 3)
    Expect(first.Count == 1 && first[0].AsNumber() == 5)
    Local last = Try thread.Resume(10)
    Expect(last.Count == 1 && last[0].AsNumber() == 20)
    Expect(thread.Status == LuauThreadStatus.FINISHED)
    Local error = ExpectThrows<LuauError>(thread.Resume())
    Expect(error != Null && error.Message == "cannot resume a thread that's dead")
    Try lua.Set("again", thread)
    Expect(Try lua.Evaluate<String>("return coroutine.status(again)") == "dead")
End Function

@Test
Function AThreadCanBeClosed() Throws LuauError
    Local lua = LuauState()
    Local thread = Try lua.Spawn(Try lua.Load("coroutine.yield() reached = true"))
    Try thread.Resume()
    Try thread.Close()
    Expect(thread.Status == LuauThreadStatus.FINISHED)
    Expect(Try lua.Evaluate<Bool>("return reached == nil"))
    Expect(ExpectThrows<LuauError>(lua.Run("task.cancel(coroutine.running())")) != Null)
End Function

@Test
Function TheTaskLibraryIsAnOption() Throws LuauError
    Local options = LuauOptions()
    options.Tasks = False
    Local lua = Try LuauState(options)
    Expect(Try lua.Evaluate<Bool>("return task == nil"))
    Expect(Try LuauState().Evaluate<Bool>("return table.isfrozen(task)"))
End Function

@Test
Function AWaitOfCenturiesEndsWhenItsStateCloses() Throws LuauError
    Local lua = LuauState()
    Local driving = lua.Start()
    Try lua.Run("task.delay(1e9, function() end) task.spawn(function() task.wait(1e300) end)")
    Expect(lua.Waits.Count == 2)
    Waited(20)
    Stopped(lua, driving)
    // Its timer's next wake is within a second; then nothing of the State's is on the scheduler.
    Waited(1100)
    Expect(Scheduler.Main.IsIdle())
End Function

@Test
Function TheMostThatWaitIsALimit() Throws LuauError
    Local options = LuauOptions()
    options.MostWaiting = 100
    Local lua = Try LuauState(options)
    Local driving = lua.Start()
    Local error = ExpectThrows<LuauError>(lua.Run(
        "local t = coroutine.create(function() end) " +
        "for i = 1, 1e5 do task.delay(1e9, coroutine.create(function() end)) end"))
    Expect(error != Null && error.Message.Contains("more than 100 threads would wait"),
           error?.Message ?? "")
    Expect(lua.Waits.Count == 100)
    Stopped(lua, driving)
End Function

@Test
Function AThreadOnlyWaitsForOneThingAtATime() Throws LuauError
    Local lua = LuauState()
    Local driving = lua.Start()
    Try lua.Run("local t = coroutine.create(function() end) task.defer(t) " +
                "local ok, e = pcall(task.defer, t) assert(not ok and e:find('waiting'))")
    Stopped(lua, driving)
End Function

@Test
Function AThreadThatWaitsIsWaitingAndTheProgramCantResumeIt() Throws LuauError
    Local lua = LuauState()
    Local driving = lua.Start()
    Local thread = Try lua.Spawn(Try lua.Load("task.wait(0.01) reached = true"))
    Try thread.Resume()
    Expect(thread.Status == LuauThreadStatus.WAITING)
    Local resumed = ExpectThrows<LuauError>(thread.Resume())
    Expect(resumed != Null && resumed.Message.Contains("waits on the scheduler"))
    Local started = ExpectThrows<LuauError>(thread.Start().Wait())
    Expect(started != Null && started.Kind == LuauErrorKind.RUNTIME)
    // The scheduler goes on with it.
    Waited(50)
    Expect(Try lua.Evaluate<Bool>("return reached == true"))
    Expect(thread.Status == LuauThreadStatus.FINISHED)
    Stopped(lua, driving)
End Function

@Test
Function ATickHasOneTimeBudgetForAllItResumes() Throws LuauError
    Local options = LuauOptions()
    options.TimeBudget = 20.Milliseconds
    Local lua = Try LuauState(options)
    Local driving = lua.Start()
    Try lua.Run("for i = 1, 100 do task.defer(function() while true do " +
                "local t = os.clock() while os.clock() - t < 0.004 do end task.wait() end end) end")
    For tick = 0 Until 3
        Local started = Instant.Now()
        Scheduler.Main.Step()
        Expect(started.Elapsed < 40.Milliseconds, "{started.Elapsed.TotalMilliseconds} ms")
    End For
    Stopped(lua, driving)
End Function

/// Errors that say which raise they were.
Class Counted Extends Error
    ReadOnly Field Number: Int

    New(number: Int)
        Super.New("counted {number}")
        Number = number
    End New
End Class

@Test
Function OneCallKeepsTheMostRecent64ErrorsItRaised() Throws LuauError
    Local lua = LuauState()
    Local weak: Weak<LuauState> = lua
    Local raised = 0
    Try lua.SetFunction("fail", Function() Throws Error
        raised++
        Throw Counted(raised)
    End Function)
    Try lua.SetFunction("kept", Function(): Int
        Local held: LuauState? = weak
        If held == Null Then Return -1
        Return held.Raised.Count
    End Function)
    Local error = ExpectThrows<LuauError>(lua.Run(
        "for i = 1, 10000 do pcall(fail) end assert(kept() == 64) fail()"))
    Expect(error != Null && error.Cause Is Counted)
    Expect(error != Null && (error.Cause As Counted).Number == 10001)
End Function

/// Starts `thread` on a Scheduler that's dropped as this returns, with the thread waiting.
Function Dropped(thread: LuauThread)
    Local playback = Scheduler()
    playback.Run(thread.Start())
    playback.Tick(0.1)
End Function

@Test
Function AThreadWhoseSchedulerGoesIsResumedByAnother() Throws LuauError
    Local lua = LuauState()
    Local thread = Try lua.Spawn(Try lua.Load("task.wait(5) reached = true"))
    Dropped(thread)
    // Its driver went with the Scheduler, so nothing waits for it, and the program resumes it.
    Expect(thread.Status == LuauThreadStatus.SUSPENDED)
    Try thread.Resume()
    Expect(Try lua.Evaluate<Bool>("return reached == true"))
End Function

/// A State made, run, and told to wait on this thread, which isn't the main one.
Function OnWorker(): String
    Local lua = LuauState()
    Local answer = (Try? lua.Evaluate<Int>("return 6 * 7")) ?? 0
    Local waited = "none"
    Try
        Try lua.Run("task.wait(1)")
    Catch error As LuauError
        waited = error.Kind == LuauErrorKind.YIELD ? "yield" : "other"
    End Try
    Return "{answer} {waited}"
End Function

@Test
Function StatesWorkOnOtherThreads() Throws LuauError
    Local first: Task<String> = Spawn(Function() => OnWorker())
    Local second: Task<String> = Spawn(Function() => OnWorker())
    Expect(first.Wait() == "42 yield")
    Expect(second.Wait() == "42 yield")
End Function

@Test
Function ThreadErrorRunsOnceTheCallEndsAndCanCloseItsState() Throws LuauError
    Local options = LuauOptions()
    Local closers: Weak<LuauState>[] = []
    Local seen = 0
    options.ThreadError = Function(error: LuauError)
        seen++
        For closer In closers
            Local held: LuauState? = closer
            held?.Close()
        End For
    End Function
    Local lua = Try LuauState(options)
    closers.Add(lua)
    Try lua.Run("task.spawn(function() error('spawned') end) after = true")
    Expect(seen == 1)
    Expect(!lua.IsOpen)
End Function

@Test
Function SpawningAThreadThatIsntSuspendedIsTheCallersError() Throws LuauError
    Local lua = LuauState()
    Try lua.Run("runner = coroutine.running()")
    Local sources = ["task.spawn(coroutine.running())",
                     "local t = coroutine.create(function() end) coroutine.resume(t) task.spawn(t)",
                     "task.spawn(runner)"]
    For source In sources
        Local error = ExpectThrows<LuauError>(lua.Run(source))
        Expect(error != Null && error.Message.Contains("takes a suspended thread"), source)
    End For
End Function

@Test
Function ATasksArgumentsStayInTheState() Throws LuauError
    // A megabyte string, given 8,000 times to each of 10,000 delays, is Luau's once: the program
    // keeps one table a delay, not 8 GB of copies.
    Local options = LuauOptions()
    options.MemoryLimit = 16 * 1024 * 1024
    options.MostWaiting = 20000
    Local lua = Try LuauState(options)
    Local waits = lua.Start()
    Local before = LuauProcessMemory()
    // The tables count to the State's limit, which they reach partway, and the program's memory
    // doesn't grow by what they hold.
    Try
        Try lua.Run("local s = string.rep('x', 2^20) local t = table.create(7999, s) " +
                    "for i = 1, 10000 do task.delay(1e9, function() end, table.unpack(t)) end")
    Catch error As LuauError
        Expect(error.Kind == LuauErrorKind.MEMORY, error.Message)
    End Try
    Expect(LuauProcessMemory() - before < 256 * 1024 * 1024, "the program's memory grew")
    // And they arrive, as they were given.
    Try lua.Run("got = nil task.defer(function(a, b, c) got = a .. b .. tostring(c) end, 'x', 'y', nil)")
    Scheduler.Main.Step()
    Scheduler.Main.Step()
    Expect(Try lua.Get<String>("got") == "xynil")
    lua.Close()
    ExpectThrows<LuauError>(waits.Wait())
End Function

@Test
Function AStartsDelaysGoToTheStatesDriverWhenItsThreadEnds() Throws LuauError
    Local lua = LuauState()
    Local world = Scheduler()
    Local waits = lua.Start()
    world.Run(waits)
    Try lua.Run("function main() task.delay(2, function() ran = true end) task.wait(0.5) end")
    Local done = (Try lua.Spawn(Try lua.Get<LuauFunction>("main"))).Start()
    world.Run(done)
    Local time: Float64 = 0.0
    While time < 3.0
        world.Tick(0.1)
        time += 0.1
    End While
    Expect(done.IsDone())
    Expect(Try lua.Get<Bool>("ran"))
    lua.Close()
    world.Tick(0.1)
    Expect(world.IsIdle())
End Function

@Test
Function AWaitMadeMidTickIsNeverEarlyNorMoreThanATickLate() Throws LuauError
    Local lua = LuauState()
    Local world = Scheduler()
    Try lua.SetFunction("now", Function(): Float64 => world.Time().TotalSeconds)
    Local waits = lua.Start()
    world.Run(waits)
    Try lua.Run("function main() task.wait(0.25) local a = now() task.wait(0.3) waited = now() - a end")
    Local done = (Try lua.Spawn(Try lua.Get<LuauFunction>("main"))).Start()
    world.Run(done)
    For tick = 1 To 20
        world.Tick(0.25)
    End For
    Local waited = Try lua.Get<Float64>("waited")
    Expect(waited >= 0.3 && waited <= 0.55, "{waited}")
    lua.Close()
End Function

@Test
Function AStartWhoseThreadErrorClosesTheStateEndsClosed() Throws LuauError
    Local options = LuauOptions()
    Local closers: Weak<LuauState>[] = []
    options.ThreadError = Function(error: LuauError)
        For closer In closers
            Local held: LuauState? = closer
            held?.Close()
        End For
    End Function
    Local lua = Try LuauState(options)
    closers.Add(lua)
    Try lua.Run("function main() task.spawn(function() error('x') end) coroutine.yield() end")
    Local done = (Try lua.Spawn(Try lua.Get<LuauFunction>("main"))).Start()
    For step = 1 To 5
        Scheduler.Main.Step()
    End For
    Local error = ExpectThrows<LuauError>(done.Wait())
    Expect(error != Null && error.Kind == LuauErrorKind.CLOSED)
End Function

@Test
Function AHogEndsOnlyItselfAndTheOthersFinish() Throws LuauError
    Local options = LuauOptions()
    options.TimeBudget = 30.Milliseconds
    Local lua = Try LuauState(options)
    Local world = Scheduler()
    world.Run(lua.Start())
    // The hog spins just short of the budget, then waits, each tick; the bystanders each wait
    // ten ticks.
    Try lua.Run("finished = 0 " +
                "task.spawn(function() while true do local t = os.clock() " +
                "while os.clock() - t < 0.025 do end task.wait() end end) " +
                "for i = 1, 5 do task.spawn(function() for j = 1, 10 do task.wait() end " +
                "finished += 1 end) end")
    For tick = 1 To 40
        world.Tick(0.1)
    End For
    Expect(Try lua.Get<Int>("finished") == 5)
    lua.Close()
End Function

@Test
Function ATickInsideACallIsNoTurn() Throws LuauError
    // The program's function steps the main scheduler while a script's call runs: the driver's
    // turn then does nothing, rather than panic, and what's due goes the next tick.
    Local lua = LuauState()
    Local waits = lua.Start()
    Try lua.SetFunction("step", Function()
        Scheduler.Main.Step()
    End Function)
    Try lua.Run("task.defer(function() deferred = true end) step()")
    Scheduler.Main.Step()
    Scheduler.Main.Step()
    Expect(Try lua.Get<Bool>("deferred"))
    lua.Close()
    ExpectThrows<LuauError>(waits.Wait())
End Function

@Test
Function AnAsyncFunctionIsntCalledPastTheWaitsLimit() Throws LuauError
    Local options = LuauOptions()
    options.MostWaiting = 3
    Local lua = Try LuauState(options)
    Local waits = lua.Start()
    Local called = 0
    Try lua.SetAsync("work", Function(): Task<Int>
        called++
        Return Doubled(1)
    End Function)
    // Three threads wait on work; the rest are refused before work is called for them.
    Try lua.Run("for i = 1, 10 do task.spawn(function() pcall(work) end) end")
    Expect(called <= 3, "{called}")
    lua.Close()
    ExpectThrows<LuauError>(waits.Wait())
End Function

@Test
Function ACallsKeptErrorsAreCappedByBytesToo() Throws LuauError
    // 64 errors of the State's size would be 64 times its limit: a megabyte of them is kept.
    Local options = LuauOptions()
    options.MemoryLimit = 8 * 1024 * 1024
    Local lua = Try LuauState(options)
    Local count = 0
    Try lua.SetFunction("forEach", Function(f: LuauFunction) Throws Error
        Try f.Invoke()
    End Function)
    Local before = LuauProcessMemory()
    Try lua.Run("local big = string.rep('x', 2^20) " +
                "for i = 1, 64 do pcall(forEach, function() error(big .. i, 0) end) end")
    Expect(LuauProcessMemory() - before < 32 * 1024 * 1024, "the kept errors grew")
    Expect(count == 0)
End Function
