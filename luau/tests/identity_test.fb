Import std.core
Import std.test
Import luau

/// A point, equal to another of the same X, and hashed by its X, so its Hash changes with it.
Class Point Implements LuauObject
    Field x: Int

    New(x: Int)
        Self.x = x
    End New

    Operator ==(a: Point, b: Point): Bool => a.x == b.x

    Method Hash(): UInt64 => x As UInt64

    @LuauGet("X") Method GetX(): Int => x
    @LuauSet("X") Method SetX(value: Int)
        x = value
    End Method
End Class

@Test
Function TwoEqualObjectsAreTwoUserdata() Throws LuauError
    Local lua = LuauState()
    Try lua.Register<Point>()
    Local a = Point(1)
    Local b = Point(1)
    Try lua.Set("a", a)
    Try lua.Set("b", b)
    Expect(Try lua.Evaluate<Bool>("return a ~= b"))
    // A change to one isn't the other's.
    Try lua.Run("b.X = 9")
    Expect(a.x == 1 && b.x == 9)
End Function

@Test
Function AnObjectWhoseHashChangesIsStillItsOneUserdata() Throws LuauError
    Local lua = LuauState()
    Try lua.Register<Point>()
    Local a = Point(1)
    Try lua.Set("a", a)
    Try lua.Run("first = a")
    a.x = 42
    Try lua.Set("again", a)
    Expect(Try lua.Evaluate<Bool>("return first == again"))
    // Released once: the State lets go of it when Luau's done with both.
    Try lua.Run("first = nil again = nil a = nil")
    lua.Collect()
    lua.Collect()
    Expect(LuauStatesOpen(here: True).0 >= 1)
End Function
