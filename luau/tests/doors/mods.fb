//! A mod's Door, which a test registers beside a game's of the same name.

Import luau

/// A mod's door.
Public Class Door Implements LuauObject
    /// Who made it.
    @LuauExpose Public Method Maker(): String => "mods"
    /// Whether it's locked, which only a mod's door says.
    @LuauGet Public Method Locked(): Bool => True
End Class
