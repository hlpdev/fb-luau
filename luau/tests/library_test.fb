Import std.concurrent
Import std.test
Import luau

@Test
Function TheLibraryIsThePackagesVersion()
    Expect(LuauLibraryVersion() == "0.1.0")
End Function

@Test
Function TheLibraryHasLuau0746()
    Expect(LuauVersion() == "0.746")
End Function

@Test
Function NoFailureSaysNothing()
    // A thread of its own, which nothing else has used, has called nothing that fails.
    Const said = Channel<String>(1)
    Local thread = Thread.Start(Function() => said.Send(LastError()))
    thread.Join()
    Expect(said.Receive() == "")
End Function
