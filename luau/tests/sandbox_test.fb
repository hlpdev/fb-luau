Import std.collections
Import std.core
Import std.test
Import std.text
Import std.time
Import luau
Import "./support/slack"

@Test
Function ScriptsDontSeeEachOthersGlobals() Throws LuauError
    Local lua = LuauState()
    Try lua.Set("shared", 1)
    Local first = Try lua.NewScript()
    Local second = Try lua.NewScript()
    Try first.Run("mine = 'first' shared = 99")
    Expect(Try first.Get<String>("mine") == "first")
    Expect(Try second.Evaluate<Bool>("return mine == nil"))
    Expect(Try second.Get<Int>("shared") == 1)
    Expect(Try lua.Get<Int>("shared") == 1)
    Try second.Set("given", "two")
    Expect(Try second.Evaluate<String>("return given") == "two")
    Expect(Try first.Evaluate<Bool>("return given == nil"))
End Function

@Test
Function TheSharedGlobalsAndLibrariesAreFrozen() Throws LuauError
    Local lua = LuauState()
    Local script = Try lua.NewScript()
    Expect(lua.IsFrozen)
    Expect(ExpectThrows<LuauError>(script.Run("string.upper = nil")) != Null)
    Expect(ExpectThrows<LuauError>(script.Run("math.pi = 3")) != Null)
    Expect(ExpectThrows<LuauError>(script.Run("getmetatable('').__index = {{}}")) != Null)
    // Its _G is its own globals.
    Try script.Run("rawset(_G, 'x', 1) _G.y = 2")
    Expect(Try script.Evaluate<Int>("return x + y") == 3)
    Expect(ExpectThrows<LuauError>(script.Run("setmetatable(_G, nil)")) != Null)
    Expect(Try script.Evaluate<String>("return getmetatable(_G)") == "The metatable is locked")
    Expect(ExpectThrows<LuauError>(lua.Set("late", 1)) != Null)
    Expect(Try script.Evaluate<String>("return string.upper('ok')") == "OK")
End Function

@Test
Function WhatReachesOtherEnvironmentsIsLeftOut() Throws LuauError
    Local lua = LuauState()
    Expect(Try lua.Evaluate<Bool>("return getfenv == nil and setfenv == nil and loadstring == nil"))
    Local options = LuauOptions()
    options.Environments = True
    options.LoadString = True
    Local open = Try LuauState(options)
    Expect(Try open.Evaluate<Bool>("return type(getfenv) == 'function'"))
    Expect(Try open.Evaluate<Int>("return loadstring('return 40 + 2')()") == 42)
    Expect(Try open.Evaluate<Bool>(
        r"local f, err = loadstring('return +') return f == nil and err ~= nil"))
End Function

@Test
Function CollectGarbageIsWhatTheOptionsSay() Throws LuauError
    Local lua = LuauState()
    Expect(Try lua.Evaluate<Float64>("return collectgarbage('count')") > 0)
    Expect(ExpectThrows<LuauError>(lua.Run("collectgarbage('stop')")) != Null)
    Expect(ExpectThrows<LuauError>(lua.Run("collectgarbage()")) != Null)
    Local options = LuauOptions()
    options.CollectGarbage = LuauCollectGarbage.FULL
    Local full = Try LuauState(options)
    Try full.Run("collectgarbage() collectgarbage('step') assert(collectgarbage('isrunning'))")
    options.CollectGarbage = LuauCollectGarbage.NONE
    Local none = Try LuauState(options)
    Expect(Try none.Evaluate<Bool>("return collectgarbage == nil"))
End Function

@Test
Function OnlyTheLibrariesAskedForAreOpen() Throws LuauError
    Local options = LuauOptions()
    options.Libraries = LuauLibraries.BASE | LuauLibraries.STRING
    Local lua = Try LuauState(options)
    Expect(Try lua.Evaluate<Bool>("return math == nil and os == nil and string ~= nil"))
End Function

@Test
Function ALoopPastItsTimeBudgetEndsEvenInAPcall() Throws LuauError
    Local options = LuauOptions()
    options.TimeBudget = 50.Milliseconds
    Local lua = Try LuauState(options)
    For source In ["while true do end",
                   "while true do pcall(function() while true do end end) end",
                   r"local t = setmetatable({}, { __index = function() while true do end end }) local x = t.y",
                   "coroutine.wrap(function() while true do end end)()",
                   "repeat local t = {{}} until false"]
        Local watch = Stopwatch.StartNew()
        Local error = ExpectThrows<LuauError>(lua.Run(source))
        Expect(error?.Kind == LuauErrorKind.TIMEOUT, source)
        Expect(watch.Elapsed < Slack(5.Seconds), source)
    End For
    // The next call has its own budget.
    Expect(Try lua.Evaluate<Int>("local n = 0 for i = 1, 1000 do n += i end return n") == 500500)
End Function

@Test
Function PrintGoesWhereTheOptionsSay() Throws LuauError
    Local lines: String[] = []
    Local options = LuauOptions()
    options.Print = Function(text: String)
        lines.Add(text)
    End Function
    Local lua = Try LuauState(options)
    Try lua.Run("print('one', 2, true, nil) print()")
    Expect(lines == ["one\t2\ttrue\tnil", ""], "{lines}")
    Local script = Try lua.NewScript()
    Try script.Run("print('from a script')")
    Expect(lines.Count == 3 && lines[2] == "from a script")
End Function

@Test
Function AMetamethodTheProgramsOwnGetOrSetRunsHasTheBudget() Throws LuauError
    Local options = LuauOptions()
    options.TimeBudget = 20.Milliseconds
    Local lua = Try LuauState(options)
    Try lua.Run(r"spin = setmetatable({}, { __index = function() while true do end end, " +
                r"__newindex = function() while true do end end, " +
                r"__len = function() while true do end end })")
    Local spin = Try lua.Get<LuauTable>("spin")
    Local started = Instant.Now()
    Local timeouts = 0
    For attempt = 0 Until 6
        Local error: LuauError? = Null
        Select attempt
            Case 0
                error = ExpectThrows<LuauError>(spin.Get<Int>("x"))
            Case 1
                error = ExpectThrows<LuauError>(spin.GetOrNull<Int>("x"))
            Case 2
                error = ExpectThrows<LuauError>(spin.Has("x"))
            Case 3
                error = ExpectThrows<LuauError>(spin.Set("x", 1))
            Case 4
                error = ExpectThrows<LuauError>(spin.Remove("x"))
            Default
                Try lua.Run("setmetatable(_G, getmetatable(spin))")
                error = ExpectThrows<LuauError>(lua.Get<Int>("missing"))
        End Select
        If error != Null && error.Kind == LuauErrorKind.TIMEOUT Then timeouts++
    End For
    Expect(timeouts == 6, "{timeouts}")
    Expect(ExpectThrows<LuauError>(lua.Set("late", 1))?.Kind == LuauErrorKind.TIMEOUT)
    Expect(started.Elapsed < Slack(5.Seconds))
    Expect(Try lua.Evaluate<Int>("return 1 + 1") == 2)
End Function

@Test
Function ATimeBudgetUnderAMicrosecondIsOneAndTheLongestRuns() Throws LuauError
    Local options = LuauOptions()
    options.TimeBudget = Duration.FromNanoseconds(1)
    Local tight = Try LuauState(options)
    Expect(ExpectThrows<LuauError>(tight.Run("while true do end"))?.Kind == LuauErrorKind.TIMEOUT)
    options.TimeBudget = Duration.MaxValue()
    Local loose = Try LuauState(options)
    Expect(Try loose.Evaluate<Int>("local n = 0 for i = 1, 100 do n += i end return n") == 5050)
End Function

@Test
Function LoadstringNamesAChunkByItsSourceAsLuauDoes() Throws LuauError
    Local options = LuauOptions()
    options.LoadString = True
    Local lua = Try LuauState(options)
    Local said = Try lua.Evaluate<String>("local f, e = loadstring('hello world') return e")
    Expect(said.StartsWith("[string \"hello world\"]:1:"), said)
    Local named = Try lua.Evaluate<String>("local f, e = loadstring('x x', '=mine') return e")
    Expect(named.StartsWith("mine:1:"), named)
End Function

@Test
Function SourceThatIsntUtf8LoadsAsItsBytes() Throws LuauError
    // "é" in Latin-1, one byte, 0xE9, in a string, which no String can hold.
    Local source: UInt8[] = "return #'".Bytes
    source.Add(0xE9)
    source.Add(39)
    Local lua = LuauState()
    Expect(Try (Try lua.Load(source)).Call<Int>() == 1)
    Local script = Try lua.NewScript("=latin")
    Expect(Try (Try script.Load(source)).Call<Int>() == 1)
End Function

@Test
Function ALevelDoesntReachAnotherScriptsFunctionThroughASharedModule() Throws LuauError
    // A shared bus calls each script's handler; the spy's handler looks up its stack, at level 2
    // the bus's function and at level 3 the victim's chunk that fired it, each another's.
    Local files: Map<String, String> = {
        "bus.luau": r"local handlers = {} return { on = function(f) table.insert(handlers, f) end, fire = function() for _, f in handlers do f() end end }"
    }
    Local options = LuauOptions()
    options.Environments = True
    options.Modules = Function(path: String): String? => files.Get(path)
    Local lua = Try LuauState(options)
    Local spy = Try lua.NewScript("@spy.luau")
    Local victim = Try lua.NewScript("@victim.luau")
    Try spy.Run(r"local bus = require('./bus') bus.on(function() " +
                r"if how == 'fenv' then return getfenv(level) end " +
                r"if how == 'info' then return debug.info(level, 'f') end " +
                r"return debug.info(tostring(level), 'f') end)", "@spy.luau")
    For level In [2, 3]
        For how In ["fenv", "info", "string"]
            Try spy.Run("how = '" + how + "' level = {level}")
            Local error =
                ExpectThrows<LuauError>(victim.Run(r"local bus = require('./bus') bus.fire()",
                                                   "@victim.luau"))
            Expect(error != Null && error.Message.Contains("another environment"),
                   "{how} {level}: " + (error?.Message ?? "no error"))
        End For
    End For
    // Its own level is its own.
    Try spy.Run("how = 'fenv' level = 1")
    Try victim.Run(r"local bus = require('./bus') bus.fire()", "@victim.luau")
End Function

/// What a test keeps of one script's to give another: a thread.
Class Kept
    Field Thread: LuauThread? = Null
End Class

@Test
Function AThreadHandedOverIsTheirsButItsFunctionsArentReached() Throws LuauError
    // A thread a script hands to another's code is theirs to resume or close, as a function it
    // hands over is theirs to call; its functions, at its levels, still aren't reached.
    Local lua = LuauState()
    Local kept = Kept()
    Try lua.SetFunction("keep", Function(thread: LuauThread)
        kept.Thread = thread
    End Function)
    Try lua.SetFunction("taken", Function(): LuauThread Throws LuauError
        Local thread = kept.Thread
        If thread == Null Then Throw LuauError(LuauErrorKind.RUNTIME, "none kept")
        Return thread
    End Function)
    Local owner = Try lua.NewScript("@owner.luau")
    Local other = Try lua.NewScript("@other.luau")
    Try owner.Run(r"local t = coroutine.create(function() coroutine.yield() end) " +
                  r"coroutine.resume(t) keep(t)", "@owner.luau")
    Expect(!(Try other.Evaluate<Bool>(r"return (pcall(debug.info, taken(), 1, 'f'))",
                                      "@other.luau")))
    Expect(Try other.Evaluate<Bool>(r"return (coroutine.resume(taken()))", "@other.luau"))
    Expect(Try other.Evaluate<String>(r"return coroutine.status(taken())", "@other.luau") == "dead")
End Function

@Test
Function AModulesCoroutinesWorkForTheScriptsThatRequireIt() Throws LuauError
    // Each module has an environment of its own: its generator, a helper that resumes what it's
    // given, and a signal that keeps a thread and spawns it later all work for a script.
    Local files: Map<String, String> = {
        "words.luau": r"return { each = function(list) return coroutine.wrap(function() " +
        r"for _, w in list do coroutine.yield(w) end end) end }",
        "helpers.luau": r"return { run = function(f, ...) local co = coroutine.create(f) " +
        r"return coroutine.resume(co, ...) end, " +
        r"close = function(co) return coroutine.close(co) end }",
        "signal.luau": r"local Signal = {} Signal.__index = Signal " +
        r"function Signal.new() return setmetatable({ waiting = {} }, Signal) end " +
        r"function Signal.Wait(self) table.insert(self.waiting, coroutine.running()) " +
        r"return coroutine.yield() end " +
        r"function Signal.Fire(self, ...) local waiting = self.waiting " +
        r"self.waiting = {} for _, t in waiting do task.spawn(t, ...) end end " +
        r"return Signal"
    }
    Local options = LuauOptions()
    options.Modules = Function(path: String): String? => files.Get(path)
    Local lua = Try LuauState(options)
    Local script = Try lua.NewScript("@mod.luau")
    Expect(Try script.Evaluate<Int>(r"local words = require('./words') local n = 0 " +
                                    r"for w in words.each({ 'a', 'b', 'c' }) do n += 1 end return n",
                                    "@mod.luau") == 3)
    Expect(Try script.Evaluate<Int>(r"local helpers = require('./helpers') " +
                                    r"local _, v = helpers.run(function(a) return a * 2 end, 21) " +
                                    r"local co = coroutine.create(function() coroutine.yield() end) " +
                                    r"coroutine.resume(co) helpers.close(co) " +
                                    r"return coroutine.status(co) == 'dead' and v or 0",
                                    "@mod.luau") == 42)
    Expect(Try script.Evaluate<Int>(r"local Signal = require('./signal') local s = Signal.new() " +
                                    r"local got = 0 task.spawn(function() got = s:Wait() end) " +
                                    r"s:Fire(5) return got", "@mod.luau") == 5)
End Function

@Test
Function AWrappedCoroutineGetsEveryArgumentFromTheProgram() Throws LuauError
    Local lua = LuauState()
    Try lua.Run(r"f = coroutine.wrap(function(a, b, c) return a + b + c end) ran = false " +
                r"task.spawn(coroutine.wrap(function() ran = true end))")
    Local f = Try lua.Get<LuauFunction>("f")
    Expect(Try f.Call<Int>(1, 2, 3) == 6)
    Expect(Try lua.Get<Bool>("ran"))
End Function

@Test
Function ADefaultStateEndsARunawayScript() Throws LuauError
    // Without asking, a State's memory and each call's time are limited.
    Local options = LuauOptions()
    Expect(options.MemoryLimit == 256 * 1024 * 1024 && options.TimeBudget == 10.Seconds)
    Local lua = LuauState()
    // A driver's tick has the call's budget, LuauState() as LuauState(LuauOptions()).
    Expect(lua.TickBudget == options.TimeBudget && lua.MostWaiting == options.MostWaiting)
    // Memory taken in one step, past the limit, which no machine's speed ends first.
    Local hoard = ExpectThrows<LuauError>(lua.Run("local s = string.rep('x', 300 * 1024 * 1024)"))
    Expect(hoard?.Kind == LuauErrorKind.MEMORY)
    Local spin = ExpectThrows<LuauError>(lua.Run("while true do end"))
    Expect(spin?.Kind == LuauErrorKind.TIMEOUT)
    Expect(Try lua.Evaluate<Int>("return 1 + 1") == 2)
End Function

@Test
Function TheSandboxPresetHasWhatItSays() Throws LuauError
    Local options = LuauOptions.Sandbox()
    Expect(options.MemoryLimit == 64 * 1024 * 1024 && options.TimeBudget == 50.Milliseconds)
    Expect(options.MostWaiting == 1000 && options.Libraries == LuauLibraries.ALL)
    Expect(options.CollectGarbage == LuauCollectGarbage.COUNT)
    Expect(!options.LoadString && !options.Environments)
    Expect(options.NativeCode == LuauNativeCode.OFF)
    Local lua = Try LuauState(options)
    Expect(Try lua.Evaluate<Bool>("return loadstring == nil and getfenv == nil and setfenv == nil"))
    Expect(ExpectThrows<LuauError>(lua.Run("while true do end"))?.Kind == LuauErrorKind.TIMEOUT)
    Expect(ExpectThrows<LuauError>(lua.Run("local s = string.rep('x', 80 * 1024 * 1024)"))?.Kind ==
           LuauErrorKind.MEMORY)
    Local _script = Try lua.NewScript()
    Expect(lua.IsFrozen)
End Function
