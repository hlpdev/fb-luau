//! A State, a Luau VM of the program's own: making one, running and loading code in it, its
//! globals, and its memory.

Import std.collections
Import std.core

Import "./c/fbl_call"
Import "./c/fbl_callback"
Import "./c/fbl_core"
Import "./c/fbl_frame"
Import "./c/fbl_load"
Import "./c/fbl_state"
Import "./c/fbl_table"
Import "./c/fbl_udata"
Import "./callbacks"
Import "./errors"
Import "./functions"
Import "./library"
Import "./objects"
Import "./shim"
Import "./tables"
Import "./value"
Import "./values"

/// How a State's code is compiled, as Luau's compiler takes it.
Public Struct LuauCompileOptions
    /// How much the compiler optimizes: 0 not at all, 1 what keeps debugging as it is, the
    /// default, or 2, which inlines functions and unrolls loops too.
    Public Field Optimization: Int = 1
    /// How much it keeps for debugging: 0 nothing, 1 lines and functions' names, the default,
    /// which tracebacks need, or 2 every local's name too.
    Public Field Debug: Int = 1
    /// How much it counts for coverage: 0 nothing, the default, 1 each statement, or 2 each
    /// expression too.
    Public Field Coverage: Int = 0
End Struct

/// What a State is made with.
///
/// # Examples
///
/// ```
/// # Import luau
/// Local options = LuauOptions()
/// options.MemoryLimit = 16 * 1024 * 1024
/// Local lua = Try LuauState(options)
/// Expect(lua.MemoryUsed < options.MemoryLimit)
/// ```
Public Struct LuauOptions
    /// The most bytes the State's VM may hold at once, or 0, the default, for no limit. Past it, a
    /// script gets Luau's "not enough memory", which a call gives as a LuauError of MEMORY, and
    /// the State goes on, with what was freed free.
    Public Field MemoryLimit: Int64 = 0
    /// How its code is compiled.
    Public Field Compile: LuauCompileOptions = LuauCompileOptions()
End Struct

/// A Luau VM of the program's own, which runs scripts. It stays on the thread that made it, as
/// every Class's objects do, and two States share nothing. It closes when nothing refers to it,
/// or at [Close], and its handles, like a [LuauFunction], keep it until they go.
///
/// # Examples
///
/// ```
/// # Import luau
/// Local lua = LuauState()
/// Try lua.Run("lives = 3")
/// Expect(Try lua.Get<Int>("lives") == 3)
/// Expect(Try lua.Evaluate<String>("return 'hi ' .. lives") == "hi 3")
/// ```
Public Class LuauState
    /// The library's handle of the State, or 0 once it's closed.
    Package Field Handle: UInt64
    /// The program's functions Luau has, by their numbers, each run with its call's slots.
    Package Field Functions: Map<Int64, Func(LuauSlots): Int32>
    /// The numbers the next one takes.
    Field nextFunction: Int64 = 0
    /// The program's errors raised in Luau in the program's call that's running, by the message
    /// they were raised with, so one that comes back out is the LuauError's Cause.
    Package Field Raised: Map<String, Error>
    /// Its registered types, by their names, each a LuauTypeBuilder, and what lets go of an
    /// object of each type, by its number.
    Package Field Types: Map<String, Object>
    Package Field TypesByNumber: Map<Int32, Func(Int64)>
    /// The program's objects Luau has, by the numbers their userdata hold, and each one's type.
    Package Field Objects: Map<Int64, LuauKept>
    Package Field ObjectTypes: Map<Int64, Int32>
    Field nextType: Int32 = 0
    Field nextObject: Int64 = 0

    /// Makes a State with the default options: no memory limit, and Luau's libraries.
    @PanicsAtCaller
    Public New()
        Functions = {}
        Raised = {}
        Types = {}
        TypesByNumber = {}
        Objects = {}
        ObjectTypes = {}
        Local made = Made(LuauOptions())
        If made.0 == 0 Then Panic(made.2)
        Handle = made.0
        Registered(Self)
    End New

    /// Makes a State with `options`.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY when the State doesn't fit in `options`' memory limit.
    ///
    /// # Panics
    ///
    /// When a memory limit is below 0, or a compile option isn't from 0 to 2.
    @PanicsAtCaller
    Public New(options: LuauOptions) Throws LuauError
        Functions = {}
        Raised = {}
        Types = {}
        TypesByNumber = {}
        Objects = {}
        ObjectTypes = {}
        Local made = Made(options)
        If made.1 == FBL_MEMORY Then Throw LuauError(LuauErrorKind.MEMORY, made.2)
        If made.0 == 0 Then Panic(made.2)
        Handle = made.0
        Registered(Self)
    End New

    Method Destroy()
        If Handle != 0 Then fbl_state_close(Handle)
    End Method

    /// Whether it's still open, not closed by [Close].
    Public Property IsOpen: Bool
        Get => Handle != 0
    End Property

    /// Closes it now: its VM and everything in it go, and what it held of the program's. Using it,
    /// or a handle of it, after panics. Closing it again does nothing.
    ///
    /// # Panics
    ///
    /// Inside a call it runs, as from a function a script called.
    @PanicsAtCaller
    Public Method Close()
        If Handle == 0 Then Return
        If !fbl_state_close(Handle) Then Panic(LastError())
        Handle = 0
        Functions.Clear()
        Raised.Clear()
        Types.Clear()
        TypesByNumber.Clear()
        Objects.Clear()
        ObjectTypes.Clear()
    End Method

    /// The bytes its VM holds now.
    @PanicsAtCaller
    Public Property MemoryUsed: Int64
        Get
            Local used = fbl_state_memory(Live())
            If used < 0 Then Panic(LastError())
            Return used
        End Get
    End Property

    /// Collects its garbage now, all of it, as Luau's collector would in steps.
    @PanicsAtCaller
    Public Method Collect()
        If fbl_state_collect(Live()) != FBL_OK Then Panic(LastError())
    End Method

    /// Compiles and runs `source`, as the chunk `name`, which its errors and tracebacks show: Luau
    /// names a file's chunk "@path", and any other "=name".
    ///
    /// # Errors
    ///
    /// A LuauError of SYNTAX for source that doesn't compile, and of RUNTIME, MEMORY, or YIELD
    /// for what it meets as it runs.
    @PanicsAtCaller
    Public Method Run(source: String, name: String = "=chunk") Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(Loaded(frame, source, name))
        Try Check(fbl_call_function(Handle, frame, 0, 0))
    End Method

    /// Compiles and runs `source`, as Run does, and gives its first result as a T, or nil's.
    ///
    /// # Errors
    ///
    /// What Run throws, and a LuauError of CONVERSION when its result isn't a T.
    @PanicsAtCaller
    Public Method Evaluate<T: LuauType>(source: String, name: String = "=chunk"): T Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(Loaded(frame, source, name))
        Try Check(fbl_call_function(Handle, frame, 0, 1))
        Return Try T.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// Compiles `source`, as Run does, into a function to call later, without running it.
    ///
    /// # Errors
    ///
    /// A LuauError of SYNTAX for source that doesn't compile, or of MEMORY.
    @PanicsAtCaller
    Public Method Load(source: String, name: String = "=chunk"): LuauFunction Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(Loaded(frame, source, name))
        Return Try LuauFunction.Kept(Self, frame, 0)
    End Method

    /// The global `name`'s value, as a T, read as a script reads it.
    ///
    /// # Errors
    ///
    /// A LuauError of CONVERSION when it isn't a T, or what its globals' metatable raises.
    @PanicsAtCaller
    Public Method Get<T: LuauType>(name: String): T Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Local bytes = name.Bytes
        Unsafe
            Try Check(fbl_frame_get_global(Handle, frame, PointerOf(ByRef bytes), bytes.Count))
        End Unsafe
        Return Try T.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// Sets the global `name` to `value`, as a script sets it.
    ///
    /// # Errors
    ///
    /// A LuauError of CONVERSION when `value` can't be given to Luau, MEMORY, or what its globals'
    /// metatable raises.
    @PanicsAtCaller
    Public Method Set<T: LuauType>(name: String, value: T) Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try T.ToLuau(LuauSlots(Self, frame), value)
        Local bytes = name.Bytes
        Unsafe
            Try Check(fbl_frame_set_global(Handle, frame, PointerOf(ByRef bytes), bytes.Count, 0))
        End Unsafe
    End Method

    /// A new, empty table.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method NewTable(): LuauTable Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(fbl_table_new(Handle, frame, 0, 0))
        Return Try LuauTable.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// A new table of `items`, from 1, as a script writes `{ a, b, c }`.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY, or CONVERSION for an item that can't be given to Luau.
    @PanicsAtCaller
    Public Method NewTable<T: LuauType>(items: T[]): LuauTable Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Local slots = LuauSlots(Self, frame)
        Try Check(fbl_table_new(Handle, frame, items.Count, 0))
        For index = 0 Until items.Count
            Try Check(fbl_frame_push_number(Handle, frame, index + 1))
            Try T.ToLuau(slots, items[index])
            Try Check(fbl_table_raw_set(Handle, frame, 0, 1, 2))
            slots.Truncate(1)
        End For
        Return Try LuauTable.FromLuau(slots, 0)
    End Method

    /// A new table of `entries`, as a script writes `{ [key] = value }`.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY, or CONVERSION for a key or value that can't be given to Luau, or a
    /// key Luau's tables can't hold, like NaN.
    @PanicsAtCaller
    Public Method NewTable<K, V>(entries: Map<K, V>): LuauTable Throws LuauError
        Where K: LuauType & Hashable
        Where V: LuauType
        Local frame = Opened()
        Defer Closed(frame)
        Local slots = LuauSlots(Self, frame)
        Try Check(fbl_table_new(Handle, frame, 0, entries.Count))
        For entry In entries
            Try K.ToLuau(slots, entry.0)
            Try V.ToLuau(slots, entry.1)
            Try Check(fbl_table_raw_set(Handle, frame, 0, 1, 2))
            slots.Truncate(1)
        End For
        Return Try LuauTable.FromLuau(slots, 0)
    End Method

    /// Its handle, panicking at the caller once it's closed.
    @PanicsAtCaller
    Package Method Live(): UInt64
        If Handle == 0 Then Panic("the Luau State is closed")
        Return Handle
    End Method

    /// A new frame on it, for a call's values, which Closed closes.
    @PanicsAtCaller
    Package Method Opened(): Int32
        Local frame = fbl_frame_open(Live())
        If frame < 0 Then Panic(LastError())
        Return frame
    End Method

    /// Closes the frame Opened gave. Once the program's call that opened the first is done, it lets
    /// go of the functions Luau has collected, and of the errors it raised.
    Package Method Closed(frame: Int32)
        If Handle == 0 Then Return
        fbl_frame_close(Handle, frame)
        If frame != 0 Then Return
        Raised.Clear()
        Local taken: Int64[64]
        While True
            Local count: Int32
            Unsafe
                count = fbl_callback_released(Handle, AddressOf(taken[0]), 64)
            End Unsafe
            For index = 0 Until count
                Functions.Remove(taken[index])
            End For
            If count < 64 Then Break
        End While
        While True
            Local count: Int32
            Unsafe
                count = fbl_udata_released(Handle, AddressOf(taken[0]), 64)
            End Unsafe
            For index = 0 Until count
                Local id = taken[index]
                Local number = ObjectTypes.Get(id)
                If number != Null
                    Local release = TypesByNumber.Get(number)
                    If release != Null Then release(id)
                End If
                Objects.Remove(id)
                ObjectTypes.Remove(id)
            End For
            If count < 64 Then Return
        End While
    End Method

    /// T's registration, if it has one.
    Package Method KeptType<T: LuauObject>(): LuauTypeBuilder<T>?
        Local kept = Types.Get(TypeName<T>())
        If kept == Null Then Return Null
        Return kept As LuauTypeBuilder<T>
    End Method

    /// A new registration of T, which Finished finishes.
    Package Method NewType<T: LuauObject>(): LuauTypeBuilder<T>
        nextType++
        Return LuauTypeBuilder<T>(Self, nextType, TypeName<T>())
    End Method

    /// Gives `type`'s objects their metatable, of its __index, __newindex, and __namecall, and its
    /// Methods each a Luau function, and keeps it.
    @PanicsAtCaller
    Package Method Finished<T: LuauObject>(type: LuauTypeBuilder<T>) Throws LuauError
        For entry In type.Methods
            type.Functions[entry.0] = Try NewFunction(entry.0, entry.1)
        End For
        Local name = type.Name
        Local index = Try NewFunction(name + ".__index",
                                      Function(slots: LuauSlots) => type.Indexed(slots))
        Local newIndex = Try NewFunction(name + ".__newindex",
                                         Function(slots: LuauSlots) => type.NewIndexed(slots))
        Local nameCall = Try NewFunction(name + ".__namecall",
                                         Function(slots: LuauSlots) => type.NameCalled(slots), True)
        Local frame = Opened()
        Defer Closed(frame)
        Local slots = LuauSlots(Self, frame)
        Try LuauFunction.ToLuau(slots, index)
        Try LuauFunction.ToLuau(slots, newIndex)
        Try LuauFunction.ToLuau(slots, nameCall)
        Try Check(fbl_udata_type(Handle, frame, type.Number, name, 0, 1, 2))
        Types[name] = type
        TypesByNumber[type.Number] = Function(id: Int64) => type.Released(id)
        For entry In type.Pending
            Try type.AddOperator(entry.0, entry.1)
        End For
    End Method

    /// T's registration, panicking at the caller when it has none.
    @PanicsAtCaller
    Package Method TypeOf<T: LuauObject>(): LuauTypeBuilder<T>
        Local kept = Types.Get(TypeName<T>())
        If kept == Null Then Panic("{TypeName<T>()} isn't registered; Register<{TypeName<T>()}>() first")
        Return kept As LuauTypeBuilder<T>
    End Method

    /// Adds `value`'s userdata to the frame: the one Luau has for it, or a new one.
    @PanicsAtCaller
    Package Method PushObject<T: LuauObject>(slots: LuauSlots, value: T) Throws LuauError
        Local type = TypeOf<T>()
        Local id = type.Ids.Get(value)
        If id != Null && fbl_udata_push(Live(), slots.Frame, id) == FBL_OK Then Return
        nextObject++
        Local object = nextObject
        Local status = fbl_udata_new(Live(), slots.Frame, object, type.Number)
        Try Check(status)
        Objects[object] = LuauBox<T>(value)
        ObjectTypes[object] = type.Number
        type.Ids[value] = object
    End Method

    /// The object a userdata slot holds, as a T.
    @PanicsAtCaller
    Package Method ObjectAt<T: LuauObject>(slots: LuauSlots, index: Int32): T Throws LuauError
        Local name = TypeName<T>()
        If slots.TypeAt(index) != FBL_TYPE_USERDATA Then Throw slots.Wrong(name, index)
        Local id: Int64 = 0
        Local number: Int32 = 0
        Local found: Bool
        Unsafe
            found = fbl_udata_object(Live(), slots.Frame, index, AddressOf(id), AddressOf(number))
        End Unsafe
        If !found Then Throw slots.Wrong(name, index)
        Local kept = Objects.Get(id)
        Local box: LuauBox<T>? = Null
        If kept != Null Then box = kept As? LuauBox<T>
        If box == Null
            Throw LuauError(LuauErrorKind.CONVERSION, "expected {name}, got another type's object")
        End If
        Return box.Value
    End Method

    /// Runs the program's function `function` for a call of it from Luau, whose frame is `frame`:
    /// a status, its results or its error left in the frame. FBL_OTHER for one it hasn't.
    Package Method Invoked(frame: Int32, function: Int64): Int32
        Local invoke = Functions.Get(function)
        If invoke == Null Then Return FBL_OTHER
        Return invoke(LuauSlots(Self, frame))
    End Method

    /// A new Luau function, named `name`, that runs `invoke` when Luau calls it; for a type's
    /// __namecall, `named`, with the method's name first in its slots.
    @PanicsAtCaller
    Package Method NewFunction(name: String, invoke: Func(LuauSlots): Int32,
                               named: Bool = False): LuauFunction Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        nextFunction++
        Local function = nextFunction
        Functions[function] = invoke
        Local status: Int32
        If named
            status = fbl_callback_namecall(Handle, frame, function, name)
        Else
            status = fbl_callback_function(Handle, frame, function, name)
        End If
        If status != FBL_OK Then Functions.Remove(function)
        Try Check(status)
        Return Try LuauFunction.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// Nothing, for FBL_OK; or the State's last error as a LuauError, or a panic, at the caller, for
    /// a call the program shouldn't have made.
    @PanicsAtCaller
    Package Method Check(status: Int32) Throws LuauError
        If status == FBL_OK Then Return
        If status == FBL_MISUSE Then Panic(LastError())
        Local message: String
        Local traceback: String
        Local length: Int64 = 0
        Unsafe
            message = TextAt(fbl_state_error_message(Handle, AddressOf(length)), length)
            traceback = TextAt(fbl_state_error_traceback(Handle, AddressOf(length)), length)
        End Unsafe
        Throw LuauError(status As LuauErrorKind, message, traceback, Raised.Get(message),
                        ErrorValue())
    End Method

    /// The value of the last error a call met, or Null for one that isn't a value of Luau's.
    Package Method ErrorValue(): LuauValue?
        Local frame = fbl_frame_open(Handle)
        If frame < 0 Then Return Null
        Defer fbl_frame_close(Handle, frame)
        If fbl_state_error_value(Handle, frame) != FBL_OK Then Return Null
        Local value = Try? LuauValue.FromLuau(LuauSlots(Self, frame), 0)
        If value == Null || value.IsNil Then Return Null
        Return value
    End Method

    /// Compiles `source` as `name` into the frame's next slot, as a function: a status.
    Package Method Loaded(frame: Int32, source: String, name: String): Int32
        Local bytes = source.Bytes
        Unsafe
            Return fbl_load_source(Handle, frame, PointerOf(ByRef bytes), bytes.Count, name)
        End Unsafe
    End Method
End Class

/// A State made with `options`, as its handle, the library's status, and what it says went wrong;
/// a handle of 0 when it couldn't be made.
Function Made(options: LuauOptions): (UInt64, Int32, String)
    Local given = fbl_state_options_t(memory_limit: options.MemoryLimit,
                                      optimization: options.Compile.Optimization,
                                      debug: options.Compile.Debug,
                                      coverage: options.Compile.Coverage, unused: 0)
    Local status: Int32 = FBL_OK
    Local handle: UInt64
    Unsafe
        handle = fbl_state_new(AddressOf(given), AddressOf(status))
    End Unsafe
    Return (handle, status, handle == 0 ? LastError() : "")
End Function
