//! A State, a Luau VM of the program's own: making one, running and loading code in it, its
//! globals, and its memory.

Import std.collections
Import std.core
Import std.time

Import "./arity"
Import "./buffers"
Import "./bytecode"
Import "./c/fbl_buffer"
Import "./c/fbl_bytecode"
Import "./c/fbl_call"
Import "./c/fbl_callback"
Import "./c/fbl_core"
Import "./c/fbl_frame"
Import "./c/fbl_load"
Import "./c/fbl_require"
Import "./c/fbl_sandbox"
Import "./c/fbl_state"
Import "./c/fbl_table"
Import "./c/fbl_thread"
Import "./c/fbl_udata"
Import "./callbacks"
Import "./definitions"
Import "./errors"
Import "./functions"
Import "./library"
Import "./objects"
Import "./scripts"
Import "./shim"
Import "./tables"
Import "./threads"
Import "./value"
Import "./values"

/// How a State's code is compiled, as Luau's compiler takes it.
Public Struct LuauCompileOptions
    /// How much the compiler optimizes: 0 not at all, 1 what keeps debugging as it is, the
    /// default, or 2, which inlines functions and unrolls loops too.
    Public Field Optimization: Int = 1
    /// How much it keeps for debugging: 0 nothing, 1 lines and functions' names, the default,
    /// which tracebacks need, or 2 every local's name too.
    Public Field Debug: Int = 1
    /// How much it counts for coverage: 0 nothing, the default, 1 each statement, or 2 each
    /// expression too.
    Public Field Coverage: Int = 0
End Struct

/// What a State is made with.
///
/// # Examples
///
/// ```
/// # Import luau
/// Local options = LuauOptions()
/// options.MemoryLimit = 16 * 1024 * 1024
/// Local lua = Try LuauState(options)
/// Expect(lua.MemoryUsed < options.MemoryLimit)
/// ```
Public Struct LuauOptions
    /// The most bytes the State's VM may hold at once, or 0, the default, for no limit, garbage not
    /// yet collected counting too: with a limit, the collector runs more often, aiming at a quarter
    /// more than what's live. Past it, a script gets Luau's "not enough memory", which a call gives
    /// as a LuauError of MEMORY, and the State goes on, having collected all it could.
    Public Field MemoryLimit: Int64 = 0
    /// How long each call of the program's into the State may run, or 0, the default, for no
    /// limit: every one that can run a script's code, a call, a thread's resume, and a table's or
    /// the globals' get and set, which can run a metamethod, and a driver's tick, for all the
    /// threads it resumes then, rounded up to a whole microsecond.
    /// Past it, the script meets a LuauError of TIMEOUT at each of Luau's safe points, its loops'
    /// and calls', which its own pcall can't keep it from, until the call returns; a C function
    /// that runs long, like a string pattern that backtracks, has it only once it returns. A
    /// budget below 0 panics, where the State's made.
    Public Field TimeBudget: Duration
    /// How its code is compiled.
    Public Field Compile: LuauCompileOptions = LuauCompileOptions()
    /// The libraries it opens.
    Public Field Libraries: LuauLibraries = LuauLibraries.ALL
    /// What collectgarbage its scripts have.
    Public Field CollectGarbage: LuauCollectGarbage = LuauCollectGarbage.COUNT
    /// What it compiles to native code, as its code loads: OFF by default, as a script shouldn't
    /// turn native code on for itself unasked; MARKED for what `--!native` and `@native` mark.
    Public Field NativeCode: LuauNativeCode = LuauNativeCode.OFF
    /// The most bytes its native code may take, 16 MB by default, which isn't the VM's memory and
    /// doesn't count to MemoryLimit: past it, what's compiled from there runs in Luau's
    /// interpreter, the same but slower. Code loaded again, as hot reload and ForgetModules load
    /// it, takes more of it each time. A cap below 0 panics, where the State's made.
    Public Field NativeMemory: Int64 = 16 * 1024 * 1024
    /// Whether its scripts have loadstring, which compiles source, never bytecode: False by
    /// default.
    Public Field LoadString: Bool = False
    /// Whether its scripts have getfenv and setfenv, which reach other functions' environments
    /// and turn off Luau's fast paths: False by default.
    Public Field Environments: Bool = False
    /// Where `print` writes, a line each call, its arguments by tostring with tabs between; or
    /// Null, the default, for std's Print, as Luau's own writes to the C runtime's stdout.
    Public Field Print: (Func(String))? = Null
    /// What reads its modules' files, for `require`: called with a file's path from the modules'
    /// root, with "/" between its parts, like "doors.luau", "lib/init.luau", or "lib/.luaurc", it
    /// gives the file's text, or Null when there's no such file, and an error it throws is the
    /// require's, in the script. A module "lib/doors" is "lib/doors.luau", "lib/doors.lua",
    /// "lib/doors/init.luau", or "lib/doors/init.lua", and a chunk named "@path" requires from its
    /// path, as Luau's rules have it; one of any other name, from the root. Nothing above the root
    /// is asked for, so a script requires only what this gives, and no path has an empty part, a
    /// ":", a "\", NUL, or a Windows device's name, or is past 1,024 bytes of 64 parts, so
    /// `root / Path(path)` stays under `root`. Its calls are the program's own file reading, in
    /// the script's call: a require asks for at most four files for its module and a ".luaurc"
    /// for each folder it walks. A module's table is frozen through its fields and their
    /// metatables, as every script that requires it shares it; what its functions reach by their
    /// upvalues, a local table say, stays the module's own to change, for every script that
    /// requires it. Null, the default, gives no modules, and `require` is an error that says so.
    Public Field Modules: (Func(String): String? Throws Error)? = Null
    /// Whether its scripts have the `task` library, Roblox's: True by default.
    Public Field Tasks: Bool = True
    /// What gets an error that ends a thread nothing waits for, one `task.spawn`, `task.defer`, or
    /// `task.delay` runs, or one that went on from a wait, once no call runs; or Null, the
    /// default, for std's PrintError of its message and traceback.
    Public Field ThreadError: (Func(LuauError))? = Null
    /// The most threads that may wait at once, past which a script's wait is an error: 10,000 by
    /// default.
    Public Field MostWaiting: Int = 10000
End Struct

/// The most bytes of text a State keeps of errors, raised in one call or waiting for ThreadError.
Const MostErrorBytes: Int64 = 1024 * 1024

/// A Luau VM of the program's own, which runs scripts. It stays on the thread that made it, as
/// every Class's objects do, and two States share nothing. It closes when nothing refers to it,
/// or at [Close]. Its handles, like a [LuauFunction], hold it weakly, so they don't keep it open,
/// and panic once it's closed.
///
/// # Examples
///
/// ```
/// # Import luau
/// Local lua = LuauState()
/// Try lua.Run("lives = 3")
/// Expect(Try lua.Get<Int>("lives") == 3)
/// Expect(Try lua.Evaluate<String>("return 'hi ' .. lives") == "hi 3")
/// ```
Public Class LuauState
    /// The library's handle of the State, or 0 once it's closed.
    Package Field Handle: UInt64
    /// The program's functions Luau has, by their numbers, each run with its call's slots.
    Package Field Functions: Map<Int64, Func(LuauSlots): Int32>
    /// The numbers the next one takes.
    Field nextFunction: Int64 = 0
    /// The program's errors raised in Luau in the program's call that's running, by the message
    /// they were raised with, so one that comes back out is the LuauError's Cause.
    Package Field Raised: Map<String, Error>
    Package Field RaisedOrder: String[]
    /// Its registered types, by their names, each a LuauTypeBuilder, and what lets go of an
    /// object of each type, by its number.
    Package Field Types: Map<Int64, Object>
    Package Field TypesByNumber: Map<Int32, Func(Int64)>
    /// What empties each registration, as the State closes.
    Package Field Emptiers: Func()[]
    /// The program's objects Luau has, by the numbers their userdata hold, and each one's type.
    Package Field Objects: Map<Int64, LuauKept>
    Package Field ObjectTypes: Map<Int64, Int32>
    Field nextType: Int32 = 0
    Field nextObject: Int64 = 0
    /// What its threads wait for, by their numbers, a thread one thing at a time; its drivers, by
    /// theirs, held weakly, as each is its coroutine's; the driver in its turn now, and the State's
    /// own, by number, or 0 for none; whether a driver's turn is open; and the most that may wait.
    Package Field Waits: Map<UInt64, LuauWaiting>
    /// What Definitions writes: each registered type's members, by its name, then by each one's
    /// kind and name, and the globals the program set, by their names.
    Package Field DeclaredTypes: Map<String, Map<String, LuauDeclared>>
    Package Field DeclaredGlobals: Map<String, LuauDeclared>
    /// Whether it has the `task` library, which Definitions declares.
    Package Field HasTasks: Bool = False
    Package Field Drivers: Map<Int, Weak<LuauDriver>>
    Field nextDriver: Int = 0
    Package Field CurrentDriver: Int = 0
    Package Field StateDriver: Int = 0
    Package Field Turning: Bool = False
    Package Field MostWaiting: Int = 10000
    /// How long a driver's tick may resume threads for: the State's time budget, or none for 0.
    Package Field TickBudget: Duration
    /// The errors that ended threads nothing waits for, which go to ThreadError once no call runs.
    Package Field Failures: LuauError[]
    /// What gets an error that ends a thread nothing waits for.
    Package Field ThreadError: Func(LuauError)

    /// Makes a State with the default options: no memory limit, and Luau's libraries.
    @PanicsAtCaller
    Public New()
        Functions = {}
        Raised = {}
        RaisedOrder = []
        Types = {}
        TypesByNumber = {}
        Emptiers = []
        Objects = {}
        ObjectTypes = {}
        Waits = {}
        DeclaredTypes = {}
        DeclaredGlobals = {}
        Drivers = {}
        Failures = []
        ThreadError = Function(error: LuauError)
            Reported(error)
        End Function
        Local made = Made(LuauOptions())
        If made.0 == 0 Then Panic(made.2)
        Handle = made.0
        Registered(Self)
        TickBudget = Duration.FromNanoseconds(0)
        Try? Printing(Null)
        Try
            Try TaskLibrary(Self)
            HasTasks = True
        Catch error As LuauError
        End Try
        Try? Requiring(Null)
        // What it sets for itself is Luau's, or declared on its own.
        DeclaredGlobals.Clear()
    End New

    /// Makes a State with `options`.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY when the State doesn't fit in `options`' memory limit.
    ///
    /// # Panics
    ///
    /// When a memory limit or a time budget is below 0, or a compile option isn't from 0 to 2.
    @PanicsAtCaller
    Public New(options: LuauOptions) Throws LuauError
        Functions = {}
        Raised = {}
        RaisedOrder = []
        Types = {}
        TypesByNumber = {}
        Emptiers = []
        Objects = {}
        ObjectTypes = {}
        Waits = {}
        DeclaredTypes = {}
        DeclaredGlobals = {}
        Drivers = {}
        Failures = []
        ThreadError = Function(error: LuauError)
            Reported(error)
        End Function
        Local given = options.ThreadError
        If given != Null Then ThreadError = given
        If options.MostWaiting < 0 Then Panic("{options.MostWaiting} threads can't wait at most")
        If options.NativeMemory < 0 Then Panic("a native code cap of {options.NativeMemory} bytes is below 0")
        MostWaiting = options.MostWaiting
        TickBudget = options.TimeBudget
        Local made = Made(options)
        If made.1 == FBL_MEMORY Then Throw LuauError(LuauErrorKind.MEMORY, made.2)
        If made.0 == 0 Then Panic(made.2)
        Handle = made.0
        Registered(Self)
        // A New that throws never runs Destroy, so what's made is closed first.
        Try
            Try Printing(options.Print)
            If options.Tasks Then Try TaskLibrary(Self)
            HasTasks = options.Tasks
            Try Requiring(options.Modules)
        Catch error As LuauError
            Close()
            Throw error
        End Try
        DeclaredGlobals.Clear()
    End New

    Method Destroy()
        If Handle != 0 Then fbl_state_close(Handle)
    End Method

    /// Whether it's still open, not closed by [Close].
    Public Property IsOpen: Bool
        Get => Handle != 0
    End Property

    /// Closes it now: its VM and everything in it go, and what it held of the program's. Using it,
    /// or a handle of it, after panics. Closing it again does nothing.
    ///
    /// # Panics
    ///
    /// Inside a call it runs, as from a function a script called.
    @PanicsAtCaller
    Public Method Close()
        If Handle == 0 Then Return
        If !fbl_state_close(Handle) Then Panic(LastError())
        Handle = 0
        Functions.Clear()
        Raised.Clear()
        RaisedOrder.Clear()
        // A registration the program still holds lets go of every object Luau had.
        For empty In Emptiers
            empty()
        End For
        Emptiers.Clear()
        Types.Clear()
        TypesByNumber.Clear()
        Objects.Clear()
        ObjectTypes.Clear()
        Waits.Clear()
        DeclaredTypes.Clear()
        DeclaredGlobals.Clear()
        Drivers.Clear()
        Failures.Clear()
        CurrentDriver = 0
        StateDriver = 0
    End Method

    /// The bytes its VM holds now.
    @PanicsAtCaller
    Public Property MemoryUsed: Int64
        Get
            Local used = fbl_state_memory(Live())
            If used < 0 Then Panic(LastError())
            Return used
        End Get
    End Property

    /// Collects its garbage now, all of it, as Luau's collector would in steps.
    @PanicsAtCaller
    Public Method Collect()
        If fbl_state_collect(Live()) != FBL_OK Then Panic(LastError())
        // Outside a call, it lets go of what Luau collected now, as the end of a call does.
        Closed(Opened())
    End Method

    /// Runs a step of its collector, of about `kilobytes`, or Luau's own step for 0, as a game's
    /// frame might, and outside a call, lets go of what Luau collected: whether it finished a cycle.
    ///
    /// # Panics
    ///
    /// For kilobytes below 0.
    @PanicsAtCaller
    Public Method Step(kilobytes: Int32 = 0): Bool
        Local finished = fbl_state_step(Live(), kilobytes)
        If finished < 0 Then Panic(LastError())
        Closed(Opened())
        Return finished == 1
    End Method

    /// Whether the global `name` is set, to anything but nil, as a script reads it.
    ///
    /// # Errors
    ///
    /// What its globals' metatable raises.
    @PanicsAtCaller
    Public Method Has(name: String): Bool Throws LuauError
        Return !(Try Get<LuauValue>(name)).IsNil
    End Method

    /// Compiles and runs `source`, as the chunk `name`, which its errors and tracebacks show: Luau
    /// names a file's chunk "@path", and any other "=name".
    ///
    /// # Errors
    ///
    /// A LuauError of SYNTAX for source that doesn't compile, and of RUNTIME, MEMORY, or YIELD
    /// for what it meets as it runs.
    @PanicsAtCaller
    Public Method Run(source: String, name: String = "=chunk") Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(Loaded(frame, source.Bytes, name))
        Try Check(fbl_call_function(Handle, frame, 0, 0))
    End Method

    /// Compiles and runs `source`, as Run does, and gives its first result as a T, or nil's.
    ///
    /// # Errors
    ///
    /// What Run throws, and a LuauError of CONVERSION when its result isn't a T.
    @PanicsAtCaller
    Public Method Evaluate<T: LuauType>(source: String, name: String = "=chunk"): T Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(Loaded(frame, source.Bytes, name))
        Try Check(fbl_call_function(Handle, frame, 0, 1))
        Return Try T.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// Runs bytecode compiled ahead, as Run runs source.
    ///
    /// # Errors
    ///
    /// A LuauError of RUNTIME, MEMORY, or YIELD for what it meets as it runs.
    @PanicsAtCaller
    Public Method Run(code: LuauBytecode) Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(LoadedCode(frame, code, -1))
        Try Check(fbl_call_function(Handle, frame, 0, 0))
    End Method

    /// Runs bytecode compiled ahead, and gives its first result as a T, as Evaluate does source.
    ///
    /// # Errors
    ///
    /// What Run throws, and a LuauError of CONVERSION when its result isn't a T.
    @PanicsAtCaller
    Public Method Evaluate<T: LuauType>(code: LuauBytecode): T Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(LoadedCode(frame, code, -1))
        Try Check(fbl_call_function(Handle, frame, 0, 1))
        Return Try T.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// Loads bytecode compiled ahead into a function to call later, without running it.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method Load(code: LuauBytecode): LuauFunction Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(LoadedCode(frame, code, -1))
        Return Try LuauFunction.Kept(Self, frame, 0)
    End Method

    /// Compiles `source`, as Run does, into a function to call later, without running it.
    ///
    /// # Errors
    ///
    /// A LuauError of SYNTAX for source that doesn't compile, or of MEMORY.
    @PanicsAtCaller
    Public Method Load(source: String, name: String = "=chunk"): LuauFunction Throws LuauError
        Return Try Load(source.Bytes, name)
    End Method

    /// Compiles `source`, its bytes as they are, which Luau's source is, so a file that isn't
    /// UTF-8, like one of Latin-1, loads as it would in Luau's own tools.
    ///
    /// # Errors
    ///
    /// A LuauError of SYNTAX for source that doesn't compile, or of MEMORY.
    @PanicsAtCaller
    Public Method Load(source: UInt8[], name: String = "=chunk"): LuauFunction Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(Loaded(frame, source, name))
        Return Try LuauFunction.Kept(Self, frame, 0)
    End Method

    /// The global `name`'s value, as a T, read as a script reads it.
    ///
    /// # Errors
    ///
    /// A LuauError of CONVERSION when it isn't a T, or what its globals' metatable raises.
    @PanicsAtCaller
    Public Method Get<T: LuauType>(name: String): T Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Local bytes = name.Bytes
        Unsafe
            Try Check(fbl_frame_get_global(Handle, frame, PointerOf(ByRef bytes), bytes.Count))
        End Unsafe
        Return Try T.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// Sets the global `name` to `value`, as a script sets it.
    ///
    /// # Errors
    ///
    /// A LuauError of CONVERSION when `value` can't be given to Luau, MEMORY, or what its globals'
    /// metatable raises.
    @PanicsAtCaller
    Public Method Set<T: LuauType>(name: String, value: T) Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try T.ToLuau(LuauSlots(Self, frame), value)
        Local bytes = name.Bytes
        Unsafe
            Try Check(fbl_frame_set_global(Handle, frame, PointerOf(ByRef bytes), bytes.Count, 0))
        End Unsafe
        DeclaredGlobals[name] = LuauDeclared(LuauDeclaredKind.VALUE, name, Null, TypeName<T>())
    End Method

    /// Says global `name` is a function of `arguments`' types that gives `result`'s, or nothing for
    /// Null, for Definitions.
    Package Method DeclareFunction(name: String, arguments: String[], result: String?)
        DeclaredGlobals[name] = LuauDeclared(LuauDeclaredKind.FUNCTION, name, arguments, result)
    End Method

    /// A new, empty table.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method NewTable(): LuauTable Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(fbl_table_new(Handle, frame, 0, 0))
        Return Try LuauTable.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// A new table of `items`, from 1, as a script writes `{ a, b, c }`.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY, or CONVERSION for an item that can't be given to Luau.
    @PanicsAtCaller
    Public Method NewTable<T: LuauType>(items: T[]): LuauTable Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Local slots = LuauSlots(Self, frame)
        Try Check(fbl_table_new(Handle, frame, items.Count, 0))
        For index = 0 Until items.Count
            Try Check(fbl_frame_push_number(Handle, frame, index + 1))
            Try T.ToLuau(slots, items[index])
            Try Check(fbl_table_raw_set(Handle, frame, 0, 1, 2))
            slots.Truncate(1)
        End For
        Return Try LuauTable.FromLuau(slots, 0)
    End Method

    /// A new table of `entries`, as a script writes `{ [key] = value }`.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY, or CONVERSION for a key or value that can't be given to Luau, or a
    /// key Luau's tables can't hold, like NaN.
    @PanicsAtCaller
    Public Method NewTable<K, V>(entries: Map<K, V>): LuauTable Throws LuauError
        Where K: LuauType & Hashable
        Where V: LuauType
        Local frame = Opened()
        Defer Closed(frame)
        Local slots = LuauSlots(Self, frame)
        Try Check(fbl_table_new(Handle, frame, 0, entries.Count))
        For entry In entries
            Try K.ToLuau(slots, entry.0)
            Try slots.KeyAt(1)
            Try V.ToLuau(slots, entry.1)
            Try Check(fbl_table_raw_set(Handle, frame, 0, 1, 2))
            slots.Truncate(1)
        End For
        Return Try LuauTable.FromLuau(slots, 0)
    End Method

    /// A new buffer of `size` bytes, all 0.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    ///
    /// # Panics
    ///
    /// For a size below 0 or past 1 GiB, Luau's largest.
    @PanicsAtCaller
    Public Method NewBuffer(size: Int64): LuauBuffer Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(fbl_buffer_new(Handle, frame, size))
        Return Try LuauBuffer.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// A new buffer of `bytes`.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method NewBuffer(bytes: UInt8[]): LuauBuffer Throws LuauError
        Local made = Try NewBuffer(bytes.Count)
        made.Write(0, bytes)
        Return made
    End Method

    /// Freezes its globals and every library in them: from then on nothing changes them, a script
    /// or the program, and Luau's fast paths take them as they are. Its first NewScript freezes it
    /// too. Freezing it again does nothing.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method Freeze() Throws LuauError
        Try Check(fbl_sandbox_freeze(Live()))
    End Method

    /// Whether its globals are frozen.
    @PanicsAtCaller
    Public Property IsFrozen: Bool
        Get
            Local frozen = fbl_sandbox_is_frozen(Live())
            If frozen < 0 Then Panic(LastError())
            Return frozen == 1
        End Get
    End Property

    /// A new thread, which runs `f` when it's started or first resumed.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method Spawn(f: LuauFunction): LuauThread Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Local slots = LuauSlots(Self, frame)
        Try LuauFunction.ToLuau(slots, f)
        Try Check(fbl_thread_new(Handle, frame, 0))
        Return Try LuauThread.FromLuau(slots, 1)
    End Method

    /// Forgets every module's value, so the next `require` of each runs it again, as when its files
    /// have changed.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method ForgetModules() Throws LuauError
        Try Check(fbl_require_forget(Live()))
    End Method

    /// Runs its threads' waits, as its driver, on the scheduler running the code: each that no
    /// thread's Start runs, `task.spawn`'s, `task.delay`'s, and a coroutine's of a call of the
    /// program's, at the scheduler's ticks. Without it, or a thread's Start under the call, a
    /// script's wait is an error of YIELD. `s.Run(lua.Start())` puts it on a Scheduler of the
    /// program's own. It's the main thread's, as Async code is; a State on another thread has no
    /// driver, and its scripts don't wait. Call it once, before a script's first wait.
    ///
    /// It runs until the State closes, waiting or not, so a Scheduler it runs on isn't idle, and
    /// a program whose top-level code ends goes on, until the program closes the State.
    ///
    /// # Errors
    ///
    /// The Task throws a LuauError of CLOSED at the scheduler's tick after the State closes,
    /// ending every wait.
    ///
    /// # Panics
    ///
    /// When it runs already.
    @PanicsAtCaller
    Public Method Start(): (Task Throws LuauError)
        Return Drove(LuauDriver.OfState(Self))
    End Method

    /// A new script, with globals of its own over its State's, which it freezes, named `name`: the
    /// chunk name its code has when it's given none, which tracebacks show, as "=doors", or
    /// "@mods/doors/main.luau", which `require` goes from.
    ///
    /// # Errors
    ///
    /// A LuauError of MEMORY.
    @PanicsAtCaller
    Public Method NewScript(name: String = "=script"): LuauScript Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        Try Check(fbl_sandbox_environment(Handle, frame))
        Local slots = LuauSlots(Self, frame)
        Return LuauScript(Self, Try slots.RefAt(0), name)
    End Method

    /// Sets `print` to write through `printer`, or std's Print for Null, when it has Luau's print.
    @PanicsAtCaller
    Method Printing(printer: (Func(String))?) Throws LuauError
        If Try? Evaluate<String>("return typeof(print)") != "function" Then Return
        Local write: Func(String) = Function(text: String)
            Print(text)
        End Function
        If printer != Null Then write = printer
        Local out = Try Wrap(write, "print")
        Local made = Try Load("local out, tostring, select = ...\n" +
                              "return function(...)\n" +
                              "    local text = ''\n" +
                              "    for i = 1, select('#', ...) do\n" +
                              "        if i > 1 then text = text .. '\\t' end\n" +
                              "        text = text .. tostring((select(i, ...)))\n" +
                              "    end\n" +
                              "    out(text)\n" +
                              "end", "=print")
        Local tostring = Try Get<LuauFunction>("tostring")
        Local select = Try Get<LuauFunction>("select")
        Try Set("print", Try made.Call<LuauFunction>(out, tostring, select))
    End Method

    /// Gives it `require`, whose modules' files `modules` reads, or none for Null.
    @PanicsAtCaller
    Method Requiring(modules: (Func(String): String? Throws Error)?) Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        If modules == Null
            Try Check(fbl_require_open(Handle, frame, -1))
            Return
        End If
        Local read: Func(String): String? Throws Error = modules
        Local reader = Try NewFunction("modules", Function(slots: LuauSlots): Int32
            Try
                Local path = Try slots.Argument<String>(0, "modules")
                Local text = Try read(path)
                If text == Null Then Return slots.NoResult()
                Return Try slots.Result<String>(text)
            Catch error
                Return slots.Raise(error)
            End Try
        End Function)
        Try LuauFunction.ToLuau(LuauSlots(Self, frame), reader)
        Try Check(fbl_require_open(Handle, frame, 0))
    End Method

    /// How many of its functions it's compiled to native code: 0 where Luau's code generator isn't
    /// supported, or NativeCode is OFF.
    @PanicsAtCaller
    Public Property NativeFunctions: Int64
        Get
            Local count = fbl_state_native_functions(Live())
            If count < 0 Then Panic(LastError())
            Return count
        End Get
    End Property

    /// The bytes its native code takes, of its NativeMemory: 0 when it has none.
    @PanicsAtCaller
    Public Property NativeMemoryUsed: Int64
        Get
            Local used = fbl_state_native_memory(Live())
            If used < 0 Then Panic(LastError())
            Return used
        End Get
    End Property

    /// Its handle, panicking at the caller once it's closed.
    @PanicsAtCaller
    Package Method Live(): UInt64
        If Handle == 0 Then Panic("the Luau State is closed")
        Return Handle
    End Method

    /// A new frame on it, for a call's values, which Closed closes.
    @PanicsAtCaller
    Package Method Opened(): Int32
        Local frame = fbl_frame_open(Live())
        If frame < 0 Then Panic(LastError())
        Return frame
    End Method

    /// Closes the frame Opened gave. Once the program's call that opened the first is done, it lets
    /// go of the functions Luau has collected, and of the errors it raised, and has the scheduler
    /// run each thread that waits on its own.
    Package Method Closed(frame: Int32)
        If Handle == 0 Then Return
        fbl_frame_close(Handle, frame)
        If frame != 0 Then Return
        Raised.Clear()
        RaisedOrder.Clear()
        Report()
        Local taken: Int64[64]
        While True
            Local count: Int32
            Unsafe
                count = fbl_callback_released(Handle, AddressOf(taken[0]), 64)
            End Unsafe
            For index = 0 Until count
                Functions.Remove(taken[index])
            End For
            If count < 64 Then Break
        End While
        While True
            Local count: Int32
            Unsafe
                count = fbl_udata_released(Handle, AddressOf(taken[0]), 64)
            End Unsafe
            For index = 0 Until count
                Local id = taken[index]
                Local number = ObjectTypes.Get(id)
                If number != Null
                    Local release = TypesByNumber.Get(number)
                    If release != Null Then release(id)
                End If
                Objects.Remove(id)
                ObjectTypes.Remove(id)
            End For
            If count < 64 Then Return
        End While
    End Method

    /// A new driver, numbered and kept weakly, for a thread's Start, or the State's for Null.
    Package Method NewDriver(own: LuauThread?): LuauDriver
        nextDriver++
        Local driver = LuauDriver(Self, nextDriver, own)
        Drivers[nextDriver] = driver
        Return driver
    End Method

    /// The driver numbered `number`, while its coroutine has it, or Null.
    Package Method DriverOf(number: Int): LuauDriver?
        If number == 0 Then Return Null
        Local kept = Drivers.Get(number)
        If kept == Null Then Return Null
        Local driver: LuauDriver? = kept
        Return driver
    End Method

    /// Lets go of driver `number`'s place, as it goes.
    Package Method Dropped(number: Int)
        Drivers.Remove(number)
    End Method

    /// Keeps what a thread waits for, for the driver in its turn, or the State's own.
    ///
    /// # Errors
    ///
    /// A LuauError of RUNTIME for a thread that waits already, or past MostWaiting; or of YIELD
    /// when no driver runs the State's waits, as on a thread of the program's other than the main
    /// one, or before `lua.Start()`.
    Package Method Waited(waiting: LuauWaiting) Throws LuauError
        Local id = waiting.Thread.Id
        // A thread that waits itself, while a wait of its own is kept, went around that one, as
        // a script's coroutine.resume does: the old one's dropped.
        Local old = Waits.Get(id)
        If old != Null && old.Within != 0 && waiting.Within != 0 Then Waits.Remove(id)
        Try CanWait(waiting.Thread)
        Local driver = DriverOf(CurrentDriver) ?? DriverOf(StateDriver)
        If driver == Null
            Throw LuauError(LuauErrorKind.YIELD,
                            "attempt to yield where nothing can wait for it: nothing runs this " +
                            "State's waits; lua.Start() runs them, or a thread's Start")
        End If
        waiting.Driver = driver.Number
        // A wait made in the driver's turn counts from its scheduler's time at the turn, and what
        // real time the turn's taken since, so it's never early on the main scheduler, whose time
        // is the real clock's; one made outside it, as in a call of the program's or a thread's
        // first resume, from the driver's next turn, on its own scheduler. Only the driver reads
        // the scheduler's time, as a State on a worker thread can't.
        If driver.InTurn
            waiting.Due = driver.Now + driver.TurnTime() + waiting.Seconds
        Else
            waiting.Due = waiting.Seconds
            waiting.Pending = True
        End If
        Waits[id] = waiting
    End Method

    /// Nothing when `thread` can wait: it doesn't already, and fewer than MostWaiting do.
    ///
    /// # Errors
    ///
    /// A LuauError of RUNTIME for a thread that waits already, or past MostWaiting.
    Package Method CanWait(thread: LuauThread) Throws LuauError
        If Waits.Contains(thread.Id)
            Throw LuauError(LuauErrorKind.RUNTIME,
                            "the thread waits already, for one thing at a time")
        End If
        If Waits.Count >= MostWaiting
            Throw LuauError(LuauErrorKind.RUNTIME, "more than {MostWaiting} threads would wait")
        End If
    End Method

    /// Keeps an error that ended a thread nothing waits for, the most recent 64, for Report.
    Package Method Failed(error: LuauError)
        Failures.Add(error)
        // The most recent 64, and 1 MB of their text, the oldest dropped.
        Local bytes: Int64 = 0
        For kept In Failures
            bytes += (kept.Message.Bytes.Count + kept.Traceback.Bytes.Count) As Int64
        End For
        While Failures.Count > 64 || (bytes > MostErrorBytes && Failures.Count > 1)
            Local oldest = Failures[0]
            bytes -= (oldest.Message.Bytes.Count + oldest.Traceback.Bytes.Count) As Int64
            Failures.RemoveAt(0)
        End While
    End Method

    /// Gives ThreadError the errors kept, once no call runs, nor a driver's turn.
    Package Method Report()
        If Turning || Failures.Count == 0 Then Return
        Local errors = Failures
        Failures = []
        For error In errors
            ThreadError(error)
            If Handle == 0 Then Return
        End For
    End Method

    /// Keeps the program's error raised in Luau by its message, the most recent 64 of them, so one
    /// that comes back out is the LuauError's Cause.
    Package Method Kept(message: String, error: Error)
        If !Raised.Contains(message) Then RaisedOrder.Add(message)
        Raised[message] = error
        // The most recent 64, and 1 MB of their messages, the oldest dropped, which loses only
        // its Cause.
        Local bytes: Int64 = 0
        For kept In RaisedOrder
            bytes += kept.Bytes.Count As Int64
        End For
        While RaisedOrder.Count > 64 || (bytes > MostErrorBytes && RaisedOrder.Count > 1)
            bytes -= RaisedOrder[0].Bytes.Count As Int64
            Raised.Remove(RaisedOrder[0])
            RaisedOrder.RemoveAt(0)
        End While
    End Method

    /// T's registration, if it has one.
    Package Method KeptType<T: LuauObject>(): LuauTypeBuilder<T>?
        Local kept = Types.Get(LuauTypeId<T>.Of())
        If kept == Null Then Return Null
        Return kept As LuauTypeBuilder<T>
    End Method

    /// A new registration of T, which Finished finishes.
    Package Method NewType<T: LuauObject>(): LuauTypeBuilder<T>
        nextType++
        DeclaredTypes[TypeName<T>()] = {}
        Return LuauTypeBuilder<T>(Self, nextType, TypeName<T>())
    End Method

    /// Gives `type`'s objects their metatable, of its __index, __newindex, and __namecall, and its
    /// Methods each a Luau function, and keeps it.
    @PanicsAtCaller
    Package Method Finished<T: LuauObject>(type: LuauTypeBuilder<T>) Throws LuauError
        For entry In type.Methods
            type.Functions[entry.0] = Try NewFunction(entry.0, entry.1)
        End For
        Local name = type.Name
        Local index = Try NewFunction(name + ".__index",
                                      Function(slots: LuauSlots) => type.Indexed(slots))
        Local newIndex = Try NewFunction(name + ".__newindex",
                                         Function(slots: LuauSlots) => type.NewIndexed(slots))
        Local nameCall = Try NewFunction(name + ".__namecall",
                                         Function(slots: LuauSlots) => type.NameCalled(slots), True)
        Local frame = Opened()
        Defer Closed(frame)
        Local slots = LuauSlots(Self, frame)
        Try LuauFunction.ToLuau(slots, index)
        Try LuauFunction.ToLuau(slots, newIndex)
        Try LuauFunction.ToLuau(slots, nameCall)
        Try Check(fbl_udata_type(Handle, frame, type.Number, name, 0, 1, 2))
        Types[LuauTypeId<T>.Of()] = type
        TypesByNumber[type.Number] = Function(id: Int64) => type.Released(id)
        Emptiers.Add(Function() => type.Emptied())
        For entry In type.Pending
            Try type.AddOperator(entry.0, entry.1)
        End For
    End Method

    /// T's registration, panicking at the caller when it has none.
    @PanicsAtCaller
    Package Method TypeOf<T: LuauObject>(): LuauTypeBuilder<T>
        Local kept = Types.Get(LuauTypeId<T>.Of())
        If kept == Null Then Panic("{TypeName<T>()} isn't registered; Register<{TypeName<T>()}>() first")
        Return kept As LuauTypeBuilder<T>
    End Method

    /// Adds `value`'s userdata to the frame: the one Luau has for it, or a new one.
    @PanicsAtCaller
    Package Method PushObject<T: LuauObject>(slots: LuauSlots, value: T) Throws LuauError
        Local type = TypeOf<T>()
        Local id = type.Ids.Get(value)
        If id != Null && fbl_udata_push(Live(), slots.Frame, id) == FBL_OK Then Return
        nextObject++
        Local object = nextObject
        Local status = fbl_udata_new(Live(), slots.Frame, object, type.Number)
        Try Check(status)
        Objects[object] = LuauBox<T>(value)
        ObjectTypes[object] = type.Number
        type.Ids[value] = object
    End Method

    /// The object a userdata slot holds, as a T.
    @PanicsAtCaller
    Package Method ObjectAt<T: LuauObject>(slots: LuauSlots, index: Int32): T Throws LuauError
        Local name = TypeName<T>()
        If slots.TypeAt(index) != FBL_TYPE_USERDATA Then Throw slots.Wrong(name, index)
        Local id: Int64 = 0
        Local number: Int32 = 0
        Local found: Bool
        Unsafe
            found = fbl_udata_object(Live(), slots.Frame, index, AddressOf(id), AddressOf(number))
        End Unsafe
        If !found Then Throw slots.Wrong(name, index)
        Local kept = Objects.Get(id)
        Local box: LuauBox<T>? = Null
        If kept != Null Then box = kept As? LuauBox<T>
        If box == Null
            Throw LuauError(LuauErrorKind.CONVERSION, "expected {name}, got another type's object")
        End If
        Return box.Value
    End Method

    /// Runs the program's function `function` for a call of it from Luau, whose frame is `frame`:
    /// a status, its results or its error left in the frame. FBL_OTHER for one it hasn't.
    Package Method Invoked(frame: Int32, function: Int64): Int32
        Local invoke = Functions.Get(function)
        If invoke == Null Then Return FBL_OTHER
        Return invoke(LuauSlots(Self, frame))
    End Method

    /// A new Luau function, named `name`, that runs `invoke` when Luau calls it; for a type's
    /// __namecall, `named`, with the method's name first in its slots.
    @PanicsAtCaller
    Package Method NewFunction(name: String, invoke: Func(LuauSlots): Int32,
                               named: Bool = False): LuauFunction Throws LuauError
        Local frame = Opened()
        Defer Closed(frame)
        nextFunction++
        Local function = nextFunction
        Functions[function] = invoke
        Local status: Int32
        If named
            status = fbl_callback_namecall(Handle, frame, function, name)
        Else
            status = fbl_callback_function(Handle, frame, function, name)
        End If
        If status != FBL_OK Then Functions.Remove(function)
        Try Check(status)
        Return Try LuauFunction.FromLuau(LuauSlots(Self, frame), 0)
    End Method

    /// Nothing, for FBL_OK; or the State's last error as a LuauError, or a panic, at the caller, for
    /// a call the program shouldn't have made.
    @PanicsAtCaller
    Package Method Check(status: Int32) Throws LuauError
        If status == FBL_OK Then Return
        If status == FBL_MISUSE Then Panic(LastError())
        Local message: String
        Local traceback: String
        Local length: Int64 = 0
        Unsafe
            message = TextAt(fbl_state_error_message(Handle, AddressOf(length)), length)
            traceback = TextAt(fbl_state_error_traceback(Handle, AddressOf(length)), length)
        End Unsafe
        // A LuauError that went through a function of the program's, raised again in the script,
        // keeps its Kind: a nested call's MEMORY or TIMEOUT, or a refused yield's YIELD. The most
        // recent raise with the message is its Cause; a script that changes the message loses it.
        Local cause = Raised.Get(message)
        Local kind = status As LuauErrorKind
        If status == FBL_RUNTIME && cause Is LuauError Then kind = (cause As LuauError).Kind
        Throw LuauError(kind, message, traceback, cause, ErrorValue())
    End Method

    /// The value of the last error a call met, or Null for one that isn't a value of Luau's.
    Package Method ErrorValue(): LuauValue?
        Local frame = fbl_frame_open(Handle)
        If frame < 0 Then Return Null
        Defer fbl_frame_close(Handle, frame)
        If fbl_state_error_value(Handle, frame) != FBL_OK Then Return Null
        Local value = Try? LuauValue.FromLuau(LuauSlots(Self, frame), 0)
        If value == Null || value.IsNil Then Return Null
        Return value
    End Method

    /// Loads `code` into the frame's next slot, as a function, its environment the table in slot
    /// `environment`, or the globals for -1: a status.
    Package Method LoadedCode(frame: Int32, code: LuauBytecode, environment: Int32): Int32
        Local bytes = code.Code
        Unsafe
            Return fbl_bytecode_load(Handle, frame, PointerOf(ByRef bytes), bytes.Count, code.Name,
                                     environment)
        End Unsafe
    End Method

    /// Compiles `source` as `name` into the frame's next slot, as a function: a status.
    Package Method Loaded(frame: Int32, source: UInt8[], name: String): Int32
        Local bytes = source
        Unsafe
            Return fbl_load_source(Handle, frame, PointerOf(ByRef bytes), bytes.Count, name)
        End Unsafe
    End Method
End Class

/// A State made with `options`, as its handle, the library's status, and what it says went wrong;
/// a handle of 0 when it couldn't be made.
Function Made(options: LuauOptions): (UInt64, Int32, String)
    Local given = fbl_state_options_t(memory_limit: options.MemoryLimit,
                                      time_budget: Microseconds(options.TimeBudget),
                                      optimization: options.Compile.Optimization,
                                      debug: options.Compile.Debug,
                                      coverage: options.Compile.Coverage,
                                      libraries: options.Libraries As Int32,
                                      collect_garbage: options.CollectGarbage As Int32,
                                      native_code: options.NativeCode As Int32,
                                      load_string: options.LoadString,
                                      environments: options.Environments, unused: [False, False],
                                      native_memory: options.NativeMemory)
    Local status: Int32 = FBL_OK
    Local handle: UInt64
    Unsafe
        handle = fbl_state_new(AddressOf(given), AddressOf(status))
    End Unsafe
    Return (handle, status, handle == 0 ? LastError() : "")
End Function

/// Writes an error that ended a thread nothing waits for to stderr, its message and traceback.
Function Reported(error: LuauError)
    If error.Traceback == ""
        PrintError(error.Message)
    Else
        PrintError(error.Message + "\n" + error.Traceback)
    End If
End Function

/// A time budget in whole microseconds, rounded up, so one under a microsecond isn't none; below 0
/// stays below 0, which the State refuses.
Function Microseconds(budget: Duration): Int64
    Local nanoseconds = budget.Nanoseconds
    If nanoseconds <= 0 Then Return nanoseconds < 0 ? -1 : 0
    Return nanoseconds / 1000 + (nanoseconds % 1000 > 0 ? 1 : 0)
End Function
