// A toy game with mods, the shape a game's modding takes: the game checks each mod against the
// API it gives mods with Luau's type checker, then runs each in a State of its own, sandboxed by
// LuauOptions.Sandbox(), with a memory limit and a time budget, its waits driven by the game's
// own scheduler, a tick at a time. A State is what keeps one mod from another: its memory, its
// waits, its threads, and its modules are its own. A mod that breaks the rules, as it's checked,
// as it loads, or in a call of the game's, is dropped, its State closed, and the game goes on.

Import std.collections
Import std.core
Import std.text
Import luau

// A door a mod can open, and read the name of.
Class Door Implements LuauObject
    Field name: String
    Field open: Bool = False

    New(name: String)
        Self.name = name
    End New

    @LuauGet Method Name(): String => name
    @LuauGet("Open") Method IsOpen(): Bool => open
    @LuauSet("Open") Method SetOpen(value: Bool)
        open = value
        Print("[game] the {name} door is {open ? "open" : "shut"}")
    End Method
End Class

// The mods, as a game would read them from its mods folder; here they're in the program.
Const Mods = EmbedFolder("mods")

// A mod's file by its path from the mods folder, or Null. fb 1.3.0's EmbedFolder leaves out a
// file whose name starts with ".", so the mods' .luaurc is embedded as luaurc.json
// (fbengine-notes/luau/embed_dotfiles.fb); a game reading its mods folder needs none of this.
Function ModFile(path: String): String?
    Local name = path == ".luaurc" ? "luaurc.json" : path
    Local bytes = Mods.Get(name)
    If bytes == Null Then Return Null
    Return String.FromUtf8(bytes)
End Function

// The handlers a mod's on_tick gave, which the game calls each tick.
Class Ticks
    Field Handlers: LuauFunction[] = []
End Class

// A mod the game runs: its State, its waits' Task, and its tick handlers.
Class Mod
    Field Name: String
    Field Lua: LuauState
    Field Waits: Task Throws LuauError
    Field Ticks: Ticks

    New(name: String, lua: LuauState, waits: Task Throws LuauError)
        Name = name
        Lua = lua
        Waits = waits
        Ticks = Ticks()
    End New
End Class

// A State for `mod`, with the API the game gives mods, frozen, its waits run by `world`.
Function Opened(name: String, front: Door, world: Scheduler): Mod Throws LuauError
    // What mods want, with a smaller memory limit than its 64 MB, as these mods are small.
    Local options = LuauOptions.Sandbox()
    options.MemoryLimit = 16 * 1024 * 1024
    options.Modules = Function(path: String): String? => ModFile(path)
    options.Print = Function(line: String)
        Print("[{name}] {line}")
    End Function
    Local lua = Try LuauState(options)
    // Its waits run from before it loads, as a mod can wait as it loads: a pause of the game's
    // scheduler stops them, and its Tick's time is the mod's time.
    Local mod = Mod(name, lua, lua.Start())
    world.Run(mod.Waits)

    // What a mod reaches: a door, and three functions.
    Try lua.Register<Door>()
    Try lua.Set("front", front)
    Try lua.SetFunction("log", Function(text: String)
        Print("[log] {text}")
    End Function)
    Try lua.SetFunction("spawn_item", Function(kind: String, number: Int)
        Print("[game] {name} spawned {kind} {number}")
    End Function)
    Local ticks = mod.Ticks
    Try lua.SetFunction("on_tick", Function(handler: LuauFunction)
        ticks.Handlers.Add(handler)
    End Function)
    Try lua.Freeze()
    Return mod
End Function

// Checks `mod`, then loads it in a State of its own: the mod, or why it isn't loaded.
Function Loaded(name: String, checker: LuauChecker, front: Door,
                world: Scheduler): (Mod?, String) Throws LuauError
    Local errors = 0
    For found In Try checker.Check(name)
        If found.Severity != LuauSeverity.ERROR Then Continue
        Print("[checker] {found}")
        errors++
    End For
    If errors > 0 Then Return (Null, "{errors} errors")
    Local mod = Try Opened(name, front, world)
    Try
        Local script = Try mod.Lua.NewScript("@{name}/init.luau")
        Try script.Run(ModFile("{name}/init.luau") ?? "", "@{name}/init.luau")
    Catch error As LuauError
        mod.Lua.Close()
        Throw error
    End Try
    Return (mod, "")
End Function

// An error's first line, as a game's log would have it.
Function FirstLine(text: String): String
    Local lines = text.Split("\n")
    Return lines.Count == 0 ? text : lines[0]
End Function

Function Play() Throws LuauError
    Local front = Door("front")
    Local world = Scheduler()

    // Each mod checked against the game's API before it's loaded: the API's definitions, from a
    // State given it, as each mod's is.
    Local api = Try Opened("api", front, world)
    // Strict, whatever a mod's own lines and .luaurc say.
    Local checking = LuauCheckerOptions()
    checking.Mode = LuauCheckMode.STRICT
    checking.Enforced = True
    Local checker = LuauChecker(Function(path: String): String? => ModFile(path), checking)
    Try checker.AddDefinitions(api.Lua.Definitions(), "game")
    api.Lua.Close()

    // Each mod's check and load are its own: one that fails is dropped, and the rest go on.
    Local mods: Mod[] = []
    For name In ["broken", "doors", "greedy", "hoarder", "looping", "spawner", "thrower",
                 "twofold"]
        Local why = ""
        Try
            Local loaded = Try Loaded(name, checker, front, world)
            why = loaded.1
            Local mod = loaded.0
            If mod != Null Then mods.Add(mod)
        Catch error As LuauError
            why = "{error.Kind}, {FirstLine(error.Message)}"
        End Try
        If why == ""
            Print("[game] {name} is loaded")
        Else
            Print("[game] {name} isn't loaded: {why}")
        End If
    End For

    // The game's loop: each tick calls the mods' handlers. A mod whose handler fails is dropped,
    // its State closed, which ends its waits and threads, and the game goes on.
    For tick = 1 To 10
        world.Tick(0.1)
        Local kept: Mod[] = []
        For mod In mods
            Local failed: LuauError? = Null
            For handler In mod.Ticks.Handlers
                Try
                    Try handler.Invoke(tick)
                Catch error As LuauError
                    failed = error
                    Break
                End Try
            End For
            If failed == Null
                kept.Add(mod)
            Else
                Print("[game] {mod.Name} is stopped at tick {tick}: {failed.Kind}")
                mod.Lua.Close()
            End If
        End For
        mods = kept
    End For
    For mod In mods
        mod.Lua.Close()
    End For
    world.Tick(1.0)
    Local ended = True
    For mod In mods
        If !mod.Waits.IsDone() Then ended = False
    End For
    Print("[game] every mod's State closed, their waits ended: {ended}")
End Function

Try
    Try Play()
Catch error
    Print("[game] {error.Message}")
End Try
