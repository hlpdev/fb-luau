// The package's panics, each a mistake a program can make, which fb test can't catch: ctest runs
// this with a case's name and checks it panics with the case's message.

Import std.os
Import std.text
Import std.time
Import luau

Class Door Implements LuauObject
End Class

// Marked Methods of shapes no script can be given, and two of one name.
Class Many Implements LuauObject
    @LuauExpose Method Sum(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int): Int => a
End Class

Class Asking Implements LuauObject
    @LuauGet Method Size(scale: Int): Int => scale
End Class

Class Unset Implements LuauObject
    @LuauSet Method Reset()
    End Method
End Class

Class Twice Implements LuauObject
    @LuauExpose("hurt") Method Damage(amount: Int): Int => amount
    @LuauExpose Method hurt(amount: Int): Int => amount
End Class

Function Run(name: String) Throws LuauError
    Select name
        // A State used once it's closed.
        Case "closed-state"
            Local lua = LuauState()
            lua.Close()
            Try lua.Run("x = 1")
        // A function of a State that's closed.
        Case "closed-function"
            Local lua = LuauState()
            Local function = Try lua.Load("return 1")
            lua.Close()
            Try function.Invoke()
        // A function of a State the program let go of.
        Case "dropped-state"
            Local function = Try Dropped()
            Try function.Invoke()
        // An object of a type the State hasn't registered.
        Case "unregistered"
            Local lua = LuauState()
            Try lua.Set("door", Door())
        // A table, a buffer, and a script used once their State is closed.
        Case "table-after-close"
            Local lua = LuauState()
            Local table = Try lua.NewTable()
            lua.Close()
            Try table.Set("x", 1)
        Case "buffer-after-close"
            Local lua = LuauState()
            Local data = Try lua.NewBuffer(4)
            lua.Close()
            data.ReadUInt8(0)
        Case "script-after-close"
            Local lua = LuauState()
            Local script = Try lua.NewScript()
            lua.Close()
            Try script.Run("x = 1")
        // A handle of another State given to one.
        Case "other-state-handle"
            Local lua = LuauState()
            Local other = LuauState()
            Try lua.Set("t", Try other.NewTable())
        // A write past a buffer's end.
        Case "buffer-write-past-end"
            Local lua = LuauState()
            Local data = Try lua.NewBuffer(4)
            data.Write(2, [1 As UInt8, 2, 3])
        // A read past a buffer's end.
        Case "buffer-bounds"
            Local lua = LuauState()
            Local data = Try lua.NewBuffer(4)
            data.ReadUInt32(1)
        // A read so far past a buffer's end that making room for it first would fail.
        Case "buffer-read-huge"
            Local lua = LuauState()
            Local data = Try lua.NewBuffer(4)
            data.Read(0, 1099511627776)
        // Bytecode signed with a key too short to be a secret.
        Case "short-key"
            Local code = Try LuauBytecode.Compile("return 1")
            Local _saved = code.Save("short".Bytes)
        // A memory limit below 0.
        Case "negative-limit"
            Local options = LuauOptions()
            options.MemoryLimit = -1
            Local _lua = Try LuauState(options)
        // A time budget below 0.
        Case "negative-budget"
            Local options = LuauOptions()
            options.TimeBudget = Duration.FromNanoseconds(-5)
            Local _lua = Try LuauState(options)
        // A compile option out of its range.
        Case "optimization"
            Local options = LuauOptions()
            options.Compile.Optimization = 3
            Local _lua = Try LuauState(options)
        // A thread started while the scheduler runs it already.
        Case "started-twice"
            Local lua = LuauState()
            Local thread = Try lua.Spawn(Try lua.Load("task.wait(1)"))
            Local _first = thread.Start()
            Local _second = thread.Start()
        // A thread the scheduler runs, resumed by hand.
        Case "resumed-by-hand"
            Local lua = LuauState()
            Local thread = Try lua.Spawn(Try lua.Load("task.wait(1)"))
            Local _first = thread.Start()
            Try thread.Resume()
        Case "eight-arguments"
            Try LuauState().Register<Many>()
        Case "get-argument"
            Try LuauState().Register<Asking>()
        Case "set-none"
            Try LuauState().Register<Unset>()
        Case "two-names"
            Try LuauState().Register<Twice>()
        // A registration used once its State is closed.
        Case "closed-builder"
            Local lua = LuauState()
            Local doors = Try lua.Register<Door>()
            Local open = Try lua.Wrap(Function() => 1)
            lua.Close()
            Try doors.AddMethod("Open", open)
        // A function of another State added to a registration.
        Case "builder-other-state"
            Local lua = LuauState()
            Local other = LuauState()
            Try (Try lua.Register<Door>()).AddGetter("open", Try other.Wrap(Function() => 1))
        Default
            Panic("no such case as {name}")
    End Select
End Function

// A function of a State that's gone once this returns.
Function Dropped(): LuauFunction Throws LuauError
    Local lua = LuauState()
    Return Try lua.Load("return 1")
End Function

Local arguments = Process.Arguments()
If arguments.Count != 1 Then Panic("give the case to run")
Try Run(arguments[0])
